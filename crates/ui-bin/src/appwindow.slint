// RouteTool 设置窗口 —— 侧边栏多页面布局（首页 / 配置 / 日志 / 关于）。
//
// 排版原则（整体收紧）：
//   - 窗口 720×520 / 最小 660×460；左侧栏 140；页面 padding 14；card padding 12。
//   - 等宽：配置页 ModeCard 横向 stretch 1:1；首页 StatItem stretch 1:1。
//   - 状态显示组件统一由 main.rs 的轮询定时器刷新；
//     「切换到首页 / 窗口重新可见 / 启用-禁用切换」三个时机会主动触发
//     refresh-adapters 回调，让首页下方网卡信息即时同步。

import { Button, ComboBox, LineEdit, SpinBox, CheckBox, ScrollView } from "std-widgets.slint";

// 全局主题色
export global Theme {
    out property <color> accent-blue: #0078d4;
    out property <color> bg-gray: #f3f3f3;
    out property <color> card-gray: #fafafa;
    out property <color> border-gray: #e5e5e5;
    out property <color> text-primary: #1a1a1a;
    out property <color> text-secondary: #5d5d5d;
    out property <color> text-tertiary: #888888;
    out property <color> success: #0f7b0f;
    out property <color> error: #c42b1c;
    out property <color> warning: #9c5b00;
}

// 日志条目模型
export struct LogEntry {
    time: string,
    level: string,
    message: string,
}

// ------------------------------------------------------------------
// 通用组件
// ------------------------------------------------------------------
component Card {
    Rectangle {
        background: Theme.card-gray;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.border-gray;
        drop-shadow-offset-x: 0;
        drop-shadow-offset-y: 1px;
        drop-shadow-blur: 4px;
        drop-shadow-color: #00000006;
        @children
    }
}

component ToggleSwitch {
    in-out property <bool> checked;
    in property <string> text;
    callback toggled();

    HorizontalLayout {
        spacing: 6px;
        alignment: center;
        Rectangle {
            width: 38px;
            height: 22px;
            border-radius: 11px;
            background: root.checked ? Theme.accent-blue : #c8c8c8;
            Rectangle {
                x: root.checked ? 18px : 2px;
                y: 2px;
                width: 18px;
                height: 18px;
                border-radius: 9px;
                background: #ffffff;
                animate x { duration: 150ms; easing: ease-in-out; }
            }
            TouchArea {
                clicked => {
                    root.checked = !root.checked;
                    root.toggled();
                }
            }
        }
        Text {
            text: root.text;
            font-size: 12px;
            color: Theme.text-primary;
            vertical-alignment: center;
        }
    }
}

component FormRow {
    in property <string> label;

    VerticalLayout {
        spacing: 3px;
        Text {
            text: root.label;
            font-size: 11px;
            color: Theme.text-secondary;
        }
        @children
    }
}

component StatItem {
    in property <string> label;
    in property <string> value;
    in property <string> sub-value;
    in property <color> value-color: Theme.text-primary;

    Rectangle {
        background: #ffffff;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.border-gray;
        VerticalLayout {
            padding-top: 10px;
            padding-bottom: 10px;
            padding-left: 12px;
            padding-right: 12px;
            spacing: 3px;
            Text {
                text: root.label;
                font-size: 11px;
                color: Theme.text-secondary;
            }
            Text {
                text: root.value;
                font-size: 16px;
                font-weight: 600;
                color: root.value-color;
            }
            if root.sub-value != "": Text {
                text: root.sub-value;
                font-size: 10px;
                color: Theme.text-tertiary;
            }
        }
    }
}

component InfoRow {
    in property <string> label;
    in property <string> value;

    VerticalLayout {
        spacing: 2px;
        Text {
            text: root.label;
            font-size: 11px;
            color: Theme.text-secondary;
        }
        Text {
            text: root.value;
            font-size: 13px;
            font-weight: 600;
            color: Theme.text-primary;
        }
    }
}

component ModeCard {
    in property <string> title;
    in property <string> desc;
    in property <string> icon-name;
    in property <bool> selected;
    callback clicked();

    Rectangle {
        background: root.selected ? #e8f4fd : #ffffff;
        border-radius: 10px;
        border-width: root.selected ? 2px : 1px;
        border-color: root.selected ? Theme.accent-blue : Theme.border-gray;
        VerticalLayout {
            padding-top: 10px;
            padding-bottom: 4px;
            padding-left: 12px;
            padding-right: 12px;
            spacing: 4px;
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Rectangle {
                    width: 26px;
                    height: 26px;
                    background: root.selected ? #ffffff : Theme.bg-gray;
                    border-radius: 6px;
                    Path {
                        x: 3px;
                        y: 3px;
                        width: 20px;
                        height: 20px;
                        fill: root.selected ? Theme.accent-blue : Theme.text-secondary;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: root.icon-name == "stack"
                            ? "M12 3 4 8v8l8 4 8-4V8l-8-5zm0 2.5L17 8 12 10.5 7 8l5-2.5zM7 10l4 2v5l-4-2v-5zm10 0v5l-4 2v-5l4-2z"
                            : "M4 6h2v12H4V6zm5-2h2v16H9V4zm5 4h2v12h-2V8zm5 6h2v6h-2v-6z";
                    }
                }
                VerticalLayout {
                    spacing: 2px;
                    alignment: center;
                    Text {
                        text: root.title;
                        font-size: 13px;
                        font-weight: 600;
                        color: Theme.text-primary;
                    }
                    Text {
                        text: root.desc;
                        font-size: 11px;
                        color: Theme.text-secondary;
                        wrap: word-wrap;
                    }
                }
            }
            if root.selected: Text {
                text: "已选择";
                font-size: 10px;
                color: Theme.accent-blue;
                horizontal-alignment: right;
            }
        }
        TouchArea {
            clicked => { root.clicked(); }
        }
    }
}

// 「旁路由 IP」行：第二个 Text 默认 horizontal-stretch=1（Slint 行为），
// 会把 IP 顶到行尾。固定 horizontal-stretch: 0 让 IP 紧跟在「旁路由 IP：」后面。
component KeyValueRow {
    in property <string> key;
    in property <string> value;
    in property <color> value-color: Theme.text-primary;

    HorizontalLayout {
        spacing: 6px;
        Text {
            text: root.key;
            font-size: 12px;
            color: Theme.text-secondary;
        }
        Text {
            text: root.value;
            font-size: 12px;
            font-weight: 600;
            color: root.value-color;
            horizontal-stretch: 0;
        }
    }
}

component RouteOverlayCard {
    in property <string> bypass-ip;
    in property <string> adapter-name;

    Rectangle {
        background: #ffffff;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.border-gray;
        VerticalLayout {
            padding: 12px;
            spacing: 8px;
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Rectangle {
                    width: 32px;
                    height: 32px;
                    background: #e8f4fd;
                    border-radius: 8px;
                    Path {
                        x: 6px;
                        y: 6px;
                        width: 20px;
                        height: 20px;
                        fill: Theme.accent-blue;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: "M12 3 4 8v8l8 4 8-4V8l-8-5zm0 2.5L17 8 12 10.5 7 8l5-2.5zM7 10l4 2v5l-4-2v-5zm10 0v5l-4 2v-5l4-2z";
                    }
                }
                VerticalLayout {
                    spacing: 2px;
                    alignment: center;
                    Text {
                        text: "路由叠加";
                        font-size: 13px;
                        font-weight: 600;
                        color: Theme.text-primary;
                    }
                    Text {
                        text: "通过旁路由 IP 进行流量转发";
                        font-size: 11px;
                        color: Theme.text-secondary;
                    }
                }
            }
            KeyValueRow { key: "网卡"; value: root.adapter-name; }
            KeyValueRow { key: "旁路由 IP"; value: root.bypass-ip; }
        }
    }
}

component AdapterReconfigCard {
    in property <string> ip;
    in property <string> mask;
    in property <string> gateway;
    in property <string> dns;
    in property <string> adapter-name;

    Rectangle {
        background: #ffffff;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.border-gray;
        VerticalLayout {
            padding: 12px;
            spacing: 10px;
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Rectangle {
                    width: 32px;
                    height: 32px;
                    background: #f0f9e8;
                    border-radius: 8px;
                    Path {
                        x: 6px;
                        y: 6px;
                        width: 20px;
                        height: 20px;
                        fill: Theme.success;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: "M4 6h2v12H4V6zm5-2h2v16H9V4zm5 4h2v12h-2V8zm5 6h2v6h-2v-6z";
                    }
                }
                VerticalLayout {
                    spacing: 2px;
                    alignment: center;
                    Text {
                        text: "网卡直改";
                        font-size: 13px;
                        font-weight: 600;
                        color: Theme.text-primary;
                    }
                    Text {
                        text: "修改网卡 IP、网关、DNS 指向旁路由";
                        font-size: 11px;
                        color: Theme.text-secondary;
                    }
                }
            }
            KeyValueRow { key: "网卡"; value: root.adapter-name; }
            GridLayout {
                spacing: 14px;
                InfoRow { label: "网卡 IP"; value: root.ip; col: 0; row: 0; }
                InfoRow { label: "子网掩码"; value: root.mask; col: 1; row: 0; }
                InfoRow { label: "网关"; value: root.gateway; col: 0; row: 1; }
                InfoRow { label: "DNS"; value: root.dns; col: 1; row: 1; }
            }
        }
    }
}

component SidebarItem {
    in property <string> icon-data;
    in property <string> label;
    in property <bool> selected;
    callback clicked();

    Rectangle {
        height: 32px;
        background: root.selected ? #e8f4fd : transparent;
        border-radius: 6px;
        HorizontalLayout {
            padding-top: 6px;
            padding-bottom: 6px;
            padding-left: 10px;
            padding-right: 10px;
            spacing: 8px;
            alignment: start;
            Path {
                width: 16px;
                height: 16px;
                fill: root.selected ? Theme.accent-blue : Theme.text-secondary;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: root.icon-data;
            }
            Text {
                text: root.label;
                font-size: 12px;
                font-weight: root.selected ? 600 : 400;
                color: root.selected ? Theme.accent-blue : Theme.text-secondary;
                vertical-alignment: center;
            }
        }
        TouchArea {
            clicked => { root.clicked(); }
        }
    }
}

// ------------------------------------------------------------------
// Pages
// ------------------------------------------------------------------
component HomePage {
    in property <string> status-text;
    in property <color> status-color;
    in property <bool> is-enabled;
    in property <bool> is-fallback;
    in property <int> latency-ms;
    in property <int> interval-secs;
    in property <int> mode-index;
    in property <string> bypass-ip-text;
    in property <string> adapter-ip;
    in property <string> adapter-mask;
    in property <string> adapter-gateway;
    in property <string> adapter-dns;
    in property <string> adapter-name;
    callback toggle();
    callback switch-mode();

    ScrollView {
        VerticalLayout {
            padding-top: 0px;
            padding-bottom: 0px;
            padding-left: 0px;
            // 为 scrollbar 预留位置（Windows 上原生 scrollbar 几像素宽会与内容重叠）
            padding-right: 12px;
            spacing: 12px;

            Card {
                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        // 状态点上下居中：Slint 1.14 Rectangle 不支持
                        // vertical-alignment，所以用 VerticalLayout 包一层
                        // 让内层 alignment: center 生效。
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 10px;
                                height: 10px;
                                border-radius: 5px;
                                background: root.status-color;
                                drop-shadow-offset-x: 0;
                                drop-shadow-offset-y: 0;
                                drop-shadow-blur: 6px;
                                drop-shadow-color: root.status-color;
                            }
                        }
                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: root.status-text;
                                font-size: 14px;
                                font-weight: 600;
                                color: Theme.text-primary;
                            }
                            Text {
                                text: root.is-enabled ? "当前流量已通过旁路由" : "当前为直连状态";
                                font-size: 11px;
                                color: Theme.text-secondary;
                            }
                        }
                        HorizontalLayout {
                            alignment: end;
                            ToggleSwitch {
                                checked: root.is-enabled;
                                text: "启用旁路由";
                                toggled => { root.toggle(); }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        StatItem {
                            label: "延迟";
                            value: root.latency-ms >= 0 ? root.latency-ms + " ms" : "--";
                            sub-value: root.is-enabled ? "旁路由" : "";
                            horizontal-stretch: 1;
                        }
                        StatItem {
                            label: "连通性";
                            value: root.is-fallback ? "异常" : (root.is-enabled ? "正常" : "--");
                            value-color: root.is-fallback ? Theme.error : (root.is-enabled ? Theme.success : Theme.text-secondary);
                            sub-value: root.is-enabled ? "检测中" : "";
                            horizontal-stretch: 1;
                        }
                        // 「检测间隔」替代原「上次检测」：检测是自动跑的，不需要
                        // 单独显示上一次检测时间；改为展示用户配置的检测周期。
                        StatItem {
                            label: "检测间隔";
                            value: root.interval-secs + " 秒";
                            sub-value: "自动检测";
                            horizontal-stretch: 1;
                        }
                    }
                }
            }

            Card {
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    HorizontalLayout {
                        Text {
                            text: "当前模式";
                            font-size: 13px;
                            font-weight: 600;
                            color: Theme.text-primary;
                        }
                        HorizontalLayout {
                            alignment: end;
                            Text {
                                text: "切换模式";
                                font-size: 11px;
                                color: Theme.accent-blue;
                                TouchArea {
                                    clicked => { root.switch-mode(); }
                                }
                            }
                        }
                    }

                    if root.mode-index == 0: RouteOverlayCard {
                        bypass-ip: root.bypass-ip-text;
                        adapter-name: root.adapter-name;
                    }

                    if root.mode-index == 1: AdapterReconfigCard {
                        ip: root.adapter-ip;
                        mask: root.adapter-mask;
                        gateway: root.adapter-gateway;
                        dns: root.adapter-dns;
                        adapter-name: root.adapter-name;
                    }
                }
            }

            Text {
                text: root.mode-index == 0
                    ? "提示：当前为路由叠加模式，通过添加 0.0.0.0/1 与 128.0.0.0/1 两条路由覆盖默认路由，若需要修改配置请前往配置页面。"
                    : "提示：当前为网卡直改模式，修改网卡 IP、网关、DNS 指向旁路由，配置页面可调整静态 IP 等参数。";
                font-size: 11px;
                color: Theme.text-tertiary;
                wrap: word-wrap;
            }
        }
    }
}

component ConfigPage {
    in-out property <int> mode-index;
    in property <[string]> adapter-names;
    in-out property <int> adapter-index;
    in-out property <string> bypass-ip-text;
    in-out property <string> static-ip-text;
    in-out property <string> mask-text;
    in-out property <string> dns-text;
    in-out property <int> interval-secs;
    in-out property <int> failure-threshold;
    in-out property <bool> auto-reenable;
    in-out property <bool> notifications;
    in property <string> config-error;
    callback adapter-changed(int);
    callback save-config();
    callback restore-default();

    ScrollView {
        VerticalLayout {
            padding-top: 0px;
            padding-bottom: 0px;
            padding-left: 0px;
            padding-right: 12px;
            spacing: 12px;

            Text {
                text: "配置";
                font-size: 16px;
                font-weight: 600;
                color: Theme.text-primary;
            }

            Card {
                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;
                    Text {
                        text: "选择模式";
                        font-size: 13px;
                        font-weight: 600;
                        color: Theme.text-primary;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        ModeCard {
                            title: "路由叠加";
                            desc: "通过旁路由 IP 转发流量";
                            icon-name: "stack";
                            selected: root.mode-index == 0;
                            horizontal-stretch: 1;
                            clicked => { root.mode-index = 0; }
                        }
                        ModeCard {
                            title: "网卡直改";
                            desc: "修改网卡 IP / 网关 / DNS";
                            icon-name: "adapter";
                            selected: root.mode-index == 1;
                            horizontal-stretch: 1;
                            clicked => { root.mode-index = 1; }
                        }
                    }
                }
            }

            Card {
                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;
                    Text {
                        text: root.mode-index == 0 ? "旁路由设置" : "网卡直改设置";
                        font-size: 13px;
                        font-weight: 600;
                        color: Theme.text-primary;
                    }

                    FormRow {
                        label: "网卡";
                        ComboBox {
                            model: root.adapter-names;
                            current-index <=> root.adapter-index;
                            selected => { root.adapter-changed(self.current-index); }
                        }
                    }

                    FormRow {
                        label: "旁路由 IP";
                        LineEdit {
                            text <=> root.bypass-ip-text;
                            placeholder-text: "例如 192.168.123.105";
                        }
                    }

                    if root.mode-index == 1: VerticalLayout {
                        spacing: 8px;
                        FormRow {
                            label: "网卡静态 IP";
                            LineEdit {
                                text <=> root.static-ip-text;
                                placeholder-text: "留空则保留当前 IP";
                            }
                        }
                        FormRow {
                            label: "子网掩码";
                            LineEdit {
                                text <=> root.mask-text;
                                placeholder-text: "255.255.255.0";
                            }
                        }
                        FormRow {
                            label: "DNS";
                            LineEdit {
                                text <=> root.dns-text;
                                placeholder-text: "留空则使用旁路由 IP";
                            }
                        }
                    }
                }
            }

            Card {
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    Text {
                        text: "高级选项";
                        font-size: 13px;
                        font-weight: 600;
                        color: Theme.text-primary;
                    }
                    FormRow {
                        label: "检测间隔（秒）";
                        SpinBox {
                            minimum: 1;
                            maximum: 60;
                            value <=> root.interval-secs;
                        }
                    }
                    FormRow {
                        label: "失败阈值";
                        SpinBox {
                            minimum: 1;
                            maximum: 10;
                            value <=> root.failure-threshold;
                        }
                    }
                    CheckBox {
                        text: "旁路由恢复后自动重新启用";
                        checked <=> root.auto-reenable;
                    }
                    CheckBox {
                        text: "启用系统通知";
                        checked <=> root.notifications;
                    }
                }
            }

            if root.config-error != "": Text {
                text: root.config-error;
                font-size: 11px;
                color: Theme.error;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 10px;
                Button {
                    text: "恢复默认";
                    primary: false;
                    clicked => { root.restore-default(); }
                }
                Button {
                    text: "保存";
                    primary: true;
                    clicked => { root.save-config(); }
                }
            }
        }
    }
}

// LogRow 自适应高度：把单条日志 message 文本换行后整个行条按内容增高，
// 避免原来固定 26px 高度遮住 wrap 文本的问题。
//   - time/level 列用浅灰底突出「列」的概念，便于扫读；
//   - message 用 vertical-alignment: top，多行时贴顶显示（默认 center 会让
//     首行垂直方向居中，看起来不跟 time/level 列对齐）。
component LogRow {
    in property <string> time;
    in property <string> level;
    in property <string> message;
    in property <int> row-index;

    Rectangle {
        background: Math.mod(row-index, 2) == 0 ? #ffffff : #fafafa;
        min-height: 24px;
        HorizontalLayout {
            padding-top: 4px;
            padding-bottom: 4px;
            padding-left: 6px;
            padding-right: 6px;
            spacing: 0px;
            Rectangle {
                width: 64px;
                background: #f3f3f3;
                border-radius: 3px;
                Text {
                    text: root.time;
                    font-size: 11px;
                    color: Theme.text-tertiary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                width: 8px;
            }
            Rectangle {
                width: 48px;
                background: root.level == "ERROR" ? #fde7e3
                    : (root.level == "WARN" ? #fff3d6
                    : (root.level == "INFO" ? #e8f4fd : #f3f3f3));
                border-radius: 3px;
                Text {
                    text: root.level;
                    font-size: 11px;
                    font-weight: 600;
                    color: root.level == "ERROR" ? Theme.error
                        : (root.level == "WARN" ? Theme.warning
                        : (root.level == "INFO" ? Theme.accent-blue : Theme.text-secondary));
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                width: 8px;
            }
            Text {
                text: root.message;
                font-size: 11px;
                color: Theme.text-primary;
                wrap: word-wrap;
                vertical-alignment: top;
                horizontal-stretch: 1;
            }
        }
    }
}

component LogsPage {
    in property <[LogEntry]> log-entries;
    callback open-logs();
    callback refresh();

    VerticalLayout {
        padding: 0px;
        spacing: 12px;

        HorizontalLayout {
            Text {
                text: "日志";
                font-size: 16px;
                font-weight: 600;
                color: Theme.text-primary;
                vertical-alignment: center;
            }
            HorizontalLayout {
                alignment: end;
                spacing: 6px;
                // 紧凑风格按钮：自定义 padding + 字号，比 std Button 更小巧。
                Rectangle {
                    height: 26px;
                    background: Theme.bg-gray;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.border-gray;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: center;
                        Text {
                            text: "刷新";
                            font-size: 11px;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        clicked => { root.refresh(); }
                    }
                }
                Rectangle {
                    height: 26px;
                    background: Theme.bg-gray;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.border-gray;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: center;
                        Text {
                            text: "打开日志目录";
                            font-size: 11px;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        clicked => { root.open-logs(); }
                    }
                }
            }
        }

        Card {
            // 高度按窗口可用空间分配：卡片不留多余 padding，让滚动区占满。
            VerticalLayout {
                padding: 0px;
                spacing: 0px;
                ScrollView {
                    height: 380px;
                    VerticalLayout {
                        padding: 6px;
                        padding-right: 12px;
                        spacing: 0px;
                        for entry[idx] in root.log-entries: LogRow {
                            time: entry.time;
                            level: entry.level;
                            message: entry.message;
                            row-index: idx;
                        }
                    }
                }
            }
        }
    }
}

component AboutPage {
    in property <string> version-text;
    callback check-update();

    // vertical-stretch: 1 让页面填满窗口高度；
    // 顶部一行靠 alignment: end 把「检查更新」推至右侧；
    // 下方垂直居中内容用 alignment: center + horizontal-stretch: 1 撑满宽度。
    VerticalLayout {
        padding: 0px;
        spacing: 16px;
        vertical-stretch: 1;

        HorizontalLayout {
            width: 100%;
            HorizontalLayout {
                horizontal-stretch: 1;
            }
            Rectangle {
                height: 28px;
                width: 110px;
                background: Theme.accent-blue;
                border-radius: 6px;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    alignment: center;
                    Text {
                        text: "检查更新";
                        font-size: 12px;
                        font-weight: 500;
                        color: #ffffff;
                        vertical-alignment: center;
                    }
                }
                TouchArea {
                    clicked => { root.check-update(); }
                }
            }
        }

        VerticalLayout {
            spacing: 12px;
            alignment: center;
            horizontal-stretch: 1;

            // 直接以 256×256 source 缩放到 72×72，画质比 24 viewBox 矢量图更稳。
            Image {
                source: @image-url("../../../assets/app.png");
                width: 72px;
                height: 72px;
                horizontal-alignment: center;
            }
            Text {
                text: "RouteTool";
                font-size: 18px;
                font-weight: 600;
                color: Theme.text-primary;
                horizontal-alignment: center;
            }
            Text {
                text: root.version-text;
                font-size: 12px;
                color: Theme.text-secondary;
                horizontal-alignment: center;
            }
            Text {
                text: "Windows 桌面旁路由一键切换工具。支持路由叠加与网卡直改两种模式，具备旁路由异常自动侦测与回退能力。";
                font-size: 12px;
                color: Theme.text-secondary;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
            Text {
                text: "本项目采用 MIT 许可证开源";
                font-size: 11px;
                color: Theme.text-tertiary;
                horizontal-alignment: center;
            }
            Text {
                text: "github.com/5kywa1ker/route-tool";
                font-size: 11px;
                color: Theme.accent-blue;
                horizontal-alignment: center;
            }
        }
    }
}

// ------------------------------------------------------------------
// 主窗口
// ------------------------------------------------------------------
export component AppWindow inherits Window {
    title: "RouteTool 旁路由切换工具";
    icon: @image-url("../../../assets/app.png");
    preferred-width: 720px;
    preferred-height: 520px;
    min-width: 660px;
    min-height: 460px;

    in property <string> status-text: "未连接到核心服务";
    in property <bool> is-enabled: false;
    in property <bool> is-fallback: false;
    in property <int> latency-ms: -1;
    in property <string> version-text: "v0.0.0";
    in property <string> service-status-text: "服务运行中";

    in property <[string]> adapter-names: [];
    in-out property <int> adapter-index: -1;

    in property <string> selected-adapter-name: "--";
    in property <string> selected-adapter-ip: "--";
    in property <string> selected-adapter-mask: "--";
    in property <string> selected-adapter-gateway: "--";
    in property <string> selected-adapter-dns: "--";

    in-out property <string> bypass-ip-text: "";
    in-out property <int> mode-index: 0;
    in-out property <string> static-ip-text: "";
    in-out property <string> mask-text: "";
    in-out property <string> dns-text: "";
    in-out property <int> interval-secs: 5;
    in-out property <int> failure-threshold: 3;
    in-out property <bool> auto-reenable: false;
    in-out property <bool> notifications: true;
    in property <string> config-error: "";

    in property <[LogEntry]> log-entries: [];
    in-out property <int> current-page: 0;

    callback toggle-bypass();
    callback save-config();
    callback open-logs();
    callback adapter-changed(int);
    callback restore-default();
    callback check-update();
    callback refresh-logs();
    // 主动触发「拉取最新网卡列表 + 刷新首页下方卡片」
    callback refresh-adapters();

    property <color> status-color: root.is-fallback ? Theme.error
        : (root.is-enabled ? Theme.success : Theme.text-secondary);

    HorizontalLayout {
        Rectangle {
            width: 140px;
            background: #ffffff;

            Rectangle {
                x: 139px;
                width: 1px;
                height: 100%;
                background: Theme.border-gray;
            }

            VerticalLayout {
                padding: 12px;
                spacing: 6px;

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    Image {
                        source: @image-url("../../../assets/app.png");
                        width: 26px;
                        height: 26px;
                    }
                    VerticalLayout {
                        spacing: 2px;
                        alignment: center;
                        Text {
                            text: "RouteTool";
                            font-size: 13px;
                            font-weight: 600;
                            color: Theme.text-primary;
                        }
                        Text {
                            text: "旁路由切换";
                            font-size: 10px;
                            color: Theme.text-tertiary;
                        }
                    }
                }

                Rectangle { height: 12px; }

                SidebarItem {
                    icon-data: home-icon();
                    label: "首页";
                    selected: root.current-page == 0;
                    clicked => { root.current-page = 0; root.refresh-adapters(); }
                }
                SidebarItem {
                    icon-data: config-icon();
                    label: "配置";
                    selected: root.current-page == 1;
                    clicked => { root.current-page = 1; }
                }
                SidebarItem {
                    icon-data: logs-icon();
                    label: "日志";
                    selected: root.current-page == 2;
                    clicked => { root.current-page = 2; root.refresh-logs(); }
                }
                SidebarItem {
                    icon-data: about-icon();
                    label: "关于";
                    selected: root.current-page == 3;
                    clicked => { root.current-page = 3; }
                }

                VerticalLayout {
                    alignment: end;
                    spacing: 4px;
                    HorizontalLayout {
                        spacing: 4px;
                        alignment: start;
                        Rectangle {
                            width: 6px;
                            height: 6px;
                            border-radius: 3px;
                            background: root.service-status-text == "服务运行中" ? Theme.success : Theme.error;
                        }
                        Text {
                            text: root.service-status-text;
                            font-size: 10px;
                            color: Theme.text-secondary;
                        }
                    }
                    Text {
                        text: root.version-text;
                        font-size: 10px;
                        color: Theme.text-tertiary;
                    }
                }
            }
        }

        Rectangle {
            background: Theme.bg-gray;
            HorizontalLayout {
                padding: 14px;
                spacing: 0px;

                if root.current-page == 0: HomePage {
                    status-text: root.status-text;
                    status-color: root.status-color;
                    is-enabled: root.is-enabled;
                    is-fallback: root.is-fallback;
                    latency-ms: root.latency-ms;
                    interval-secs: root.interval-secs;
                    mode-index: root.mode-index;
                    bypass-ip-text: root.bypass-ip-text;
                    adapter-ip: root.selected-adapter-ip;
                    adapter-mask: root.selected-adapter-mask;
                    adapter-gateway: root.selected-adapter-gateway;
                    adapter-dns: root.selected-adapter-dns;
                    adapter-name: root.selected-adapter-name;
                    toggle => { root.toggle-bypass(); }
                    switch-mode => { root.current-page = 1; }
                }

                if root.current-page == 1: ConfigPage {
                    mode-index <=> root.mode-index;
                    adapter-names: root.adapter-names;
                    adapter-index <=> root.adapter-index;
                    bypass-ip-text <=> root.bypass-ip-text;
                    static-ip-text <=> root.static-ip-text;
                    mask-text <=> root.mask-text;
                    dns-text <=> root.dns-text;
                    interval-secs <=> root.interval-secs;
                    failure-threshold <=> root.failure-threshold;
                    auto-reenable <=> root.auto-reenable;
                    notifications <=> root.notifications;
                    config-error: root.config-error;
                    adapter-changed(index) => { root.adapter-changed(index); }
                    save-config => { root.save-config(); }
                    restore-default => { root.restore-default(); }
                }

                if root.current-page == 2: LogsPage {
                    log-entries: root.log-entries;
                    open-logs => { root.open-logs(); }
                    refresh => { root.refresh-logs(); }
                }

                if root.current-page == 3: AboutPage {
                    version-text: root.version-text;
                    check-update => { root.check-update(); }
                }
            }
        }
    }

    // 24-grid Fluent 风格 SVG path。矢量在缩放下保持锐利，避免 HiDPI 下模糊。
    pure function home-icon() -> string { return "M12 3l-9 8h2v9h5v-6h4v6h5v-9h2l-9-8z"; }
    pure function config-icon() -> string { return "M19.4 13.5l1.8-1-1.8-3.1-2.1.6a7.4 7.4 0 0 0-1.4-.8l-.4-2.1h-3.6l-.4 2.1a7.4 7.4 0 0 0-1.4.8l-2.1-.6-1.8 3.1 1.8 1a7.6 7.6 0 0 0 0 1.5l-1.8 1 1.8 3.1 2.1-.6a7.4 7.4 0 0 0 1.4.8l.4 2.1h3.6l.4-2.1a7.4 7.4 0 0 0 1.4-.8l2.1.6 1.8-3.1-1.8-1a7.6 7.6 0 0 0 0-1.5zM12 15.5a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7z"; }
    pure function logs-icon() -> string { return "M5 4h14v2H5V4zm0 4h14v2H5V8zm0 4h10v2H5v-2zm0 4h14v2H5v-2z"; }
    pure function about-icon() -> string { return "M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"; }
}
