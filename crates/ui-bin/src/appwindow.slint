// RouteTool 设置窗口 —— 侧边栏多页面布局（首页 / 配置 / 日志 / 关于）。
//
// 排版原则（见 RouteTool_UI_字体排版规范.md）：
//   - 字体：Segoe UI Variable（中文 fallback 微软雅黑 UI），由 Window.default-font-family
//     统一指定，DPI 缩放交给 Slint 逻辑 px，不针对缩放比例单独改字号。
//   - 字号/字重：全部走 Typography Token（12/13/14/16/20px，字重仅 400/600），
//     禁止 10/11px 常规字号与其他字重。
//   - 窗口 720×520 / 最小 660×460；左侧栏 140；页面 padding 14；card padding 12。
//   - 等宽：配置页 ModeCard 横向 stretch 1:1；首页 StatItem stretch 1:1。
//   - 状态显示组件统一由 main.rs 的轮询定时器刷新；
//     「切换到首页 / 窗口重新可见 / 启用-禁用切换」三个时机会主动触发
//     refresh-adapters 回调，让首页下方网卡信息即时同步。
//   - 界面图标：Fluent UI System Icons（MIT License）24px regular 变体，
//     经 Iconify API 获取后以 Path commands 内嵌矢量渲染，任意缩放下保持锐利。

import { Button, ComboBox, LineEdit, SpinBox, CheckBox, ScrollView } from "std-widgets.slint";

// 全局主题色
export global Theme {
    out property <color> accent-blue: #0078d4;
    out property <color> bg-gray: #f3f3f3;
    out property <color> card-gray: #fafafa;
    out property <color> border-gray: #e5e5e5;
    out property <color> text-primary: #1a1a1a;
    out property <color> text-secondary: #5d5d5d;
    out property <color> text-tertiary: #888888;
    out property <color> success: #0f7b0f;
    out property <color> error: #c42b1c;
    out property <color> warning: #9c5b00;
}

// 字体排版 Token（规范文档第 12 节）：所有控件从这里取字号，
// 不要在控件里散落硬编码 px 字号。
export global Typography {
    out property <length> display-size: 24px;  // 大标题（预留）
    out property <length> title-size: 20px;    // 页面标题 / 核心指标 / 状态数值
    out property <length> heading-size: 16px;  // 区域标题 / 卡片标题 / 状态文字
    out property <length> body-size: 14px;     // 正文 / 输入框 / 按钮
    out property <length> label-size: 13px;    // 表单标签 / 字段名 / 日志
    out property <length> caption-size: 12px;  // 辅助说明 / 提示
}

// 界面图标（Fluent UI System Icons, MIT License, via Iconify API）。
