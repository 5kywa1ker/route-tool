    // 空状态（收件盘）
    out property <string> empty: "M6.5 3A3.5 3.5 0 0 0 3.05 5.75l-1.5 4.5A4 4 0 0 0 1.5 11.4V17A4 4 0 0 0 5.5 21h13a4 4 0 0 0 4-4v-5.6q0-.59-.05-1.15l-1.5-4.5A3.5 3.5 0 0 0 17.5 3zM17.5 4.5c.96 0 1.82.61 2.13 1.52l1.35 4.04A4 4 0 0 0 20 10h-2.53a2.75 2.75 0 0 0-2.6 1.87a1.25 1.25 0 0 1-1.18.85h-3.38a1.25 1.25 0 0 1-1.18-.85A2.75 2.75 0 0 0 6.53 10H4a4 4 0 0 0-1 .14l1.36-4.1A2.25 2.25 0 0 1 6.5 4.5zM4 11.5h2.53c.63 0 1.19.4 1.4 1a2.75 2.75 0 0 0 2.58 1.72h3.38a2.75 2.75 0 0 0 2.58-1.72c.21-.6.77-1 1.4-1H20v5.5a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 17z";
}

// 日志条目模型
export struct LogEntry {
    time: string,
    level: string,
    message: string,
}

// ------------------------------------------------------------------
// 通用组件
// ------------------------------------------------------------------

// 面板卡片：白底 + 1px 描边 + 8~12px 圆角（规范第 10 节 / 速查表 Card Radius）。
// 不再用浅灰底（card-gray）——页面底已是 #f3f3f3，卡片再用灰会层级不清；
// 白底 + 细描边才是 Fluent 的卡片语言。
component Card {
    Rectangle {
        background: #ffffff;
        border-radius: Metrics.radius-lg;
        border-width: 1px;
        border-color: Theme.border-gray;
        drop-shadow-offset-x: 0;
        drop-shadow-offset-y: 1px;
        drop-shadow-blur: 4px;
        drop-shadow-color: #00000006;
        @children
    }
}

// 卡片内标准内边距容器（规范第 10 节 Card Padding 16px）。
component CardBody {
    VerticalLayout {
        padding: Metrics.card-padding;
        spacing: Metrics.spacing-md;
        @children
    }
}

// 卡片/区块标题（规范第 3 节 Heading 16px/600）。
component SectionTitle {
    in property <string> text;
    in property <string> hint;
    VerticalLayout {
        spacing: Metrics.spacing-xs;
        Text {
            text: root.text;
            font-size: Typography.heading-size;
            font-weight: 600;
            color: Theme.text-primary;
        }
        if root.hint != "": Text {
            text: root.hint;
            font-size: Typography.caption-size;
            color: Theme.text-tertiary;
            wrap: word-wrap;
        }
    }
}

// 页面标题块（规范第 16 节：20px/600 + 12~13px 副说明）。
component PageHeader {
    in property <string> title;
    in property <string> subtitle;
    VerticalLayout {
        spacing: Metrics.spacing-xs;
        Text {
            text: root.title;
            font-size: Typography.title-size;
            font-weight: 600;
            color: Theme.text-primary;
        }
        if root.subtitle != "": Text {
            text: root.subtitle;
            font-size: Typography.caption-size;
            color: Theme.text-secondary;
            wrap: word-wrap;
        }
    }
}

// 状态指示（规范第 46 节）：图标 + 文案 + 颜色三者共同表达，不单靠颜色。
// kind: 0=正常 1=注意 2=失败 3=未运行
component StatusBadge {
    in property <string> text;
    in property <int> kind: 0;
    in property <bool> compact: false;

    property <string> icon: root.kind == 0 ? Icons.status-ok
        : (root.kind == 1 ? Icons.status-warn
        : (root.kind == 2 ? Icons.status-error : Icons.status-idle));
    property <color> tone: root.kind == 0 ? Theme.success
        : (root.kind == 1 ? Theme.warning
        : (root.kind == 2 ? Theme.error : Theme.text-secondary));

    HorizontalLayout {
        spacing: Metrics.spacing-sm;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Path {
                width: root.compact ? 16px : 18px;
                height: root.compact ? 16px : 18px;
                fill: root.tone;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: root.icon;
            }
        }
        Text {
            text: root.text;
            font-size: root.compact ? Typography.caption-size : Typography.body-size;
            font-weight: 600;
            color: Theme.text-primary;
            vertical-alignment: center;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
    }
}

// 内联提示条（规范第 59/60/61 节）：成功/提示用轻量反馈，不进模态。
// kind: 0=成功 1=注意 2=失败 3=信息
component InlineBanner {
    in property <string> text;
    in property <int> kind: 0;
    in property <bool> show-close: false;
    callback dismissed();

    property <color> tone: root.kind == 0 ? Theme.success
        : (root.kind == 1 ? Theme.warning
        : (root.kind == 2 ? Theme.error : Theme.accent-blue));
    property <color> fill: root.kind == 0 ? Theme.success-bg
        : (root.kind == 1 ? Theme.warning-bg
        : (root.kind == 2 ? Theme.error-bg : Theme.info-bg));
    property <string> icon: root.kind == 0 ? Icons.status-ok
        : (root.kind == 1 ? Icons.status-warn
        : (root.kind == 2 ? Icons.status-error : Icons.about));

    Rectangle {
        background: root.fill;
        border-radius: Metrics.radius-md;
        border-width: 1px;
        border-color: root.tone;
        HorizontalLayout {
            padding: Metrics.spacing-md;
            spacing: Metrics.spacing-sm;
            alignment: start;
            VerticalLayout {
                alignment: center;
                Path {
                    width: 16px;
                    height: 16px;
                    fill: root.tone;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: root.icon;
                }
            }
            Text {
                text: root.text;
                font-size: Typography.label-size;
                color: Theme.text-primary;
                wrap: word-wrap;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if root.show-close: VerticalLayout {
                alignment: center;
                close-ta := TouchArea {
                    width: 16px;
                    height: 16px;
                    clicked => { root.dismissed(); }
                }
                Path {
                    width: 12px;
                    height: 12px;
                    fill: close-ta.has-hover ? Theme.text-primary : Theme.text-tertiary;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: Icons.dismiss;
                }
            }
        }
    }
}

// 空状态（规范第 47/53 节）：不能只留空白容器。
component EmptyState {
    in property <string> title;
    in property <string> hint;

    VerticalLayout {
        spacing: Metrics.spacing-sm;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Path {
                width: 32px;
                height: 32px;
                fill: Theme.text-tertiary;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: Icons.empty;
            }
        }
        Text {
            text: root.title;
            font-size: Typography.body-size;
            font-weight: 600;
            color: Theme.text-secondary;
            horizontal-alignment: center;
        }
        if root.hint != "": Text {
            text: root.hint;
            font-size: Typography.caption-size;
            color: Theme.text-tertiary;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

component ToggleSwitch {
    in-out property <bool> checked;
    in property <string> text;
    callback toggled();

    HorizontalLayout {
        spacing: 6px;
        alignment: center;
        Rectangle {
            width: 38px;
            height: 22px;
            border-radius: 11px;
            background: root.checked ? Theme.accent-blue : #c8c8c8;
            Rectangle {
                x: root.checked ? 18px : 2px;
                y: 2px;
                width: 18px;
                height: 18px;
                border-radius: 9px;
                background: #ffffff;
                animate x { duration: 150ms; easing: ease-in-out; }
            }
            TouchArea {
                clicked => {
                    root.checked = !root.checked;
                    root.toggled();
                }
            }
        }
        Text {
            text: root.text;
            font-size: Typography.body-size;
            color: Theme.text-primary;
            vertical-alignment: center;
        }
    }
}

// 表单字段容器（规范第 18/21/24 节）：
//   Label → Input → Description 三段式；字段间距 16px；
//   Label→Input 6~8px；Input→Description 4~6px。
//   error 非空时：控件描边转错误色，Description 位置改显错误文案，
//   并用图标 + 文案表达错误而不是只靠红色（规范第 23 节）。
//   长 Label 允许自然换行，不撑破布局、不覆盖相邻控件（规范第 24 节）。
component FormRow {
    in property <string> label;
    in property <string> description;
    in property <string> error;
    in property <string> suffix;

    VerticalLayout {
        spacing: Metrics.spacing-md;

        VerticalLayout {
            spacing: 6px;

            // Label 行：字段名 + 可选的短后缀（如「（秒）」单位）。
            HorizontalLayout {
                spacing: Metrics.spacing-xs;
                Text {
                    text: root.label;
                    font-size: Typography.label-size;
                    color: root.error != "" ? Theme.error : Theme.text-secondary;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
                if root.suffix != "": Text {
                    text: root.suffix;
                    font-size: Typography.caption-size;
                    color: Theme.text-tertiary;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
            }

            @children
        }

        // 错误优先于描述显示：同一位置不叠加两行，避免水平布局跳动（规范第 34 节）。
        // 用互斥的两个 if 表达「错误 → 否则描述」（Slint 不支持 else if）。
        if root.error != "": HorizontalLayout {
            spacing: Metrics.spacing-xs;
            alignment: start;
            VerticalLayout {
                alignment: center;
                Path {
                    width: 14px;
                    height: 14px;
                    fill: Theme.error;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: Icons.status-error;
                }
            }
            Text {
                text: root.error;
                font-size: Typography.caption-size;
                color: Theme.error;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }
        if root.error == "" && root.description != "": Text {
            text: root.description;
            font-size: Typography.caption-size;
            color: Theme.text-tertiary;
            wrap: word-wrap;
        }
    }
}

// 文本输入框（包装 std-widgets 的 LineEdit，规范第 22/23/25 节）。
//
// 用 LineEdit 而不是裸 TextInput：LineEdit 自带 placeholder-text / read-only /
// has-focus / 清除按钮 / 水平滚动，这些正是规范第 23/25 节要求的输入状态与
// 长单行值行为（光标可见、文本可水平滚动，不在框内强制换行）。
// 自绘外壳是为了让错误态描边、禁用态、Focus 表现与其他自绘控件统一。
component TextField {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> has-error: false;
    in property <bool> enabled: true;
    callback edited(string);

    horizontal-stretch: 1;

    states [
        disabled when !root.enabled: {
            frame.background: Theme.bg-gray;
            frame.border-color: Theme.border-gray;
        }
        error when root.has-error && root.enabled: {
            frame.background: #ffffff;
            frame.border-color: Theme.error;
        }
        focused when input.has-focus && root.enabled: {
            frame.background: #ffffff;
            frame.border-color: Theme.accent-blue;
        }
        normal when true: {
            frame.background: #ffffff;
            frame.border-color: hover.has-hover ? Theme.border-strong : Theme.border-gray;
        }
    ]

    frame := Rectangle {
        border-radius: Metrics.radius-sm;

        hover := TouchArea { }

        input := LineEdit {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            text <=> root.text;
            placeholder-text: root.placeholder;
            enabled: root.enabled;
            font-size: Typography.body-size;
            min-height: Metrics.control-std;
            edited(text) => { root.edited(text); }
        }
    }
}

// NumberBox 的上/下步进小按钮（三角形图标 + 悬浮/按压反馈）。
component NumberStepButton {
    in property <bool> up;
    callback clicked();

    width: 22px;
    Rectangle {
        ta := TouchArea {
            clicked => { root.clicked(); }
        }
        VerticalLayout {
            alignment: center;
            Path {
                width: 10px;
                height: 10px;
                fill: ta.has-hover ? Theme.accent-blue : Theme.text-secondary;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: root.up ? "M6 15l6-6 6 6z" : "M6 9l6 6 6-6z";
            }
        }
    }
}

// 数字输入框：替代 std-widgets SpinBox。
// std SpinBox 的内部 TouchArea 对滚轮无条件 accept，指针悬浮上去滚一下
// 配置就变了。这里自绘等价控件（外观对齐 LineEdit / SpinBox）：
//   - 仅当文本框获得焦点（编辑状态）时响应滚轮增减；
//   - 未聚焦的滚轮事件 reject，交给外层 ScrollView 正常滚动页面。
component NumberBox {
    in property <int> minimum: 1;
    in property <int> maximum: 100;
    in-out property <int> value;
    out property <bool> has-focus <=> ti.has-focus;

    min-height: 36px;
    horizontal-stretch: 1;

    function apply-new-value(v: int) {
        if root.value == v || (v >= root.minimum && v <= root.maximum) {
            root.value = v;
        }
    }

    // value 被步进/滚轮修改后回写文本框。
    changed value => {
        ti.text = root.value;
    }

    Rectangle {
        border-radius: 4px;
        background: #ffffff;
        border-width: 1px;
        border-color: ti.has-focus ? Theme.accent-blue : Theme.border-gray;

        // 声明在 TextInput 之前（z 序在下）：点击穿透给 TextInput，
        // 滚轮事件在 TextInput 不处理时落到这里，按聚焦状态决定 accept/reject。
        wheel := TouchArea {
            scroll-event(ev) => {
                if !ti.has-focus {
                    return reject;
                }
                if ev.delta-y > 0 {
                    root.apply-new-value(root.value + 1);
                    return accept;
                }
                if ev.delta-y < 0 {
                    root.apply-new-value(root.value - 1);
                    return accept;
                }
                reject
            }
        }

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 4px;
            padding-top: 4px;
            padding-bottom: 4px;
            spacing: 2px;

            Rectangle {
                clip: true;
                horizontal-stretch: 1;
                ti := TextInput {
                    vertical-alignment: center;
                    text: root.value;
                    color: Theme.text-primary;
                    font-size: Typography.body-size;

                    accepted => {
                        if !self.text.is-float() {
                            ti.text = root.value;
                        }
                    }
                    edited => {
                        if self.text.is-float() && self.text.to-float() != root.value {
                            root.apply-new-value(self.text.to-float());
                        } else if !self.text.is-float() && self.text != "" {
                            ti.text = root.value;
                        }
                    }
                }
            }

            NumberStepButton {
                up: true;
                clicked => { root.apply-new-value(root.value + 1); }
            }
            NumberStepButton {
                up: false;
                clicked => { root.apply-new-value(root.value - 1); }
            }
        }
    }
}

// 首页核心指标卡（规范第 17 节二级信息：核心内容 / 关键数据）。
// Label 13px → Value 20px/600 → 辅助说明 12px，三层字号建立明确层级。
component StatItem {
    in property <string> label;
    in property <string> value;
    in property <string> sub-value;
    in property <color> value-color: Theme.text-primary;

    Rectangle {
        background: #ffffff;
        border-radius: Metrics.radius-md;
        border-width: 1px;
        border-color: Theme.border-gray;
        VerticalLayout {
            padding: Metrics.spacing-md;
            spacing: Metrics.spacing-xs;
            Text {
                text: root.label;
                font-size: Typography.label-size;
                color: Theme.text-secondary;
            }
            Text {
                text: root.value;
                font-size: Typography.title-size;
                font-weight: 600;
                color: root.value-color;
                overflow: elide;
            }
            if root.sub-value != "": Text {
                text: root.sub-value;
                font-size: Typography.caption-size;
                color: Theme.text-tertiary;
                overflow: elide;
            }
        }
    }
}

// 首页卡片「key 左 / value 右」行（规范第 43/44 节 Key-Value 展示）。
//   - key 固有宽度靠左；value 区 horizontal-stretch: 1 吃掉剩余宽度并右对齐
//     （HorizontalLayout 里 Text 默认 stretch=1，key 必须显式置 0，
//     否则 key 的框撑满整行把 value 顶到行尾——v0.1.17 二次踩坑）。
//   - 只读数据不用 Input 模拟（规范第 42 节），保持 Label + Value 结构。
//   - value 超宽时省略号截断，鼠标悬浮弹出完整内容浮层 + 提供「复制」，
//     保证「视觉可截断，但信息不可不可访问」（规范第 26/63 节）。
component KeyValueRow {
    in property <string> key;
    in property <string> value;
    in property <color> value-color: Theme.text-primary;
    in property <string> empty-text: "未设置";

    property <string> display-value: root.value == "" ? root.empty-text : root.value;
    property <bool> is-empty: root.value == "";

    HorizontalLayout {
        spacing: Metrics.spacing-sm;

        Text {
            text: root.key;
            font-size: Typography.label-size;
            color: Theme.text-secondary;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }

        Rectangle {
            height: 20px;
            horizontal-stretch: 1;

            hover := TouchArea { }

            Text {
                width: 100%;
                text: root.display-value;
                font-size: Typography.label-size;
                color: root.is-empty ? Theme.text-tertiary : root.value-color;
                overflow: elide;
                horizontal-alignment: right;
                vertical-alignment: center;
            }

            // 悬浮浮层：完整值（可换行）+ 一键复制（规范第 63 节）。
            // 父级 Rectangle 默认不裁剪，浮层可溢出卡片显示。
            if hover.has-hover && !root.is-empty: Rectangle {
                x: parent.width - self.width;
                y: parent.height + 6px;
                width: 300px;
                background: #ffffff;
                border-radius: Metrics.radius-sm;
                border-width: 1px;
                border-color: Theme.border-strong;
                drop-shadow-offset-x: 0;
                drop-shadow-offset-y: 2px;
                drop-shadow-blur: 8px;
                drop-shadow-color: #22000000;
                VerticalLayout {
                    padding: Metrics.spacing-md;
                    spacing: Metrics.spacing-sm;
                    Text {
                        text: root.value;
                        font-size: Typography.caption-size;
                        color: Theme.text-primary;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: Metrics.spacing-xs;
                        alignment: end;
                        // 复制按钮：固定尺寸的点击热区，内部放文字，避免
                        // TouchArea 尺寸绑定到自身子文本造成布局环。
                        Rectangle {
                            width: copy-text.width + Metrics.spacing-md;
                            height: 20px;
                            background: copy-ta.has-hover ? Theme.hover-fill : transparent;
                            border-radius: 3px;

                            copy-ta := TouchArea {
                                clicked => {
                                    copied = true;
                                    copy-timer.start();
                                }
                            }
                            copy-text := Text {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                text: copied ? "已复制" : "复制";
                                font-size: Typography.caption-size;
                                color: copied ? Theme.success : Theme.accent-blue;
                            }
                        }
                    }
                }
            }
        }
    }

    property <bool> copied: false;
    // 复制反馈 1.5s 后复位（Timer 不能声明 id，用实例名引用）。
    copy-timer := Timer {
        interval: 1.5s;
        running: false;
        triggered => { root.copied = false; }
    }
}

// 模式选择卡（规范第 35 节：选项较少时直接显示全部选项）。
// 状态：Normal / Hover / Pressed / Selected。Selected 用品牌色描边 + 轻量底 +
// 右上角对勾图标（图标 + 颜色双重表达，不只靠颜色；规范第 22 节）。
component ModeCard {
    in property <string> title;
    in property <string> desc;
    in property <string> icon-data;
    in property <bool> selected;
    callback clicked();

    Rectangle {
        background: root.selected ? Theme.accent-soft
            : (ta.pressed ? Theme.pressed-fill
            : (ta.has-hover ? Theme.subtle-fill : #ffffff));
        border-radius: Metrics.radius-lg;
        border-width: root.selected ? 2px : 1px;
        border-color: root.selected ? Theme.accent-blue
            : (ta.has-hover ? Theme.border-strong : Theme.border-gray);

        VerticalLayout {
            padding: Metrics.card-padding;
            spacing: Metrics.spacing-sm;

            HorizontalLayout {
                spacing: Metrics.spacing-md;
                alignment: start;

                Rectangle {
                    width: 32px;
                    height: 32px;
                    background: root.selected ? #ffffff : Theme.bg-gray;
                    border-radius: Metrics.radius-md;
                    Path {
                        x: 6px;
                        y: 6px;
                        width: 20px;
                        height: 20px;
                        fill: root.selected ? Theme.accent-blue : Theme.text-secondary;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: root.icon-data;
                    }
                }

                VerticalLayout {
                    spacing: Metrics.spacing-xs;
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: root.title;
                        font-size: Typography.heading-size;
                        font-weight: 600;
                        color: Theme.text-primary;
                    }
                }

                // 选中标记：形状 + 颜色，不只靠颜色区分（可访问性）。
                if root.selected: VerticalLayout {
                    alignment: center;
                    Path {
                        width: 18px;
                        height: 18px;
                        fill: Theme.accent-blue;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: Icons.status-ok;
                    }
                }
            }

            Text {
                text: root.desc;
                font-size: Typography.caption-size;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }
        }

        ta := TouchArea {
            clicked => { root.clicked(); }
        }
    }
}

// 当前模式详情卡（首页）。
// 只读信息用 Label + Value 结构展示，不用 Input 模拟（规范第 42 节）。
component RouteOverlayCard {
    in property <string> bypass-ip;
    in property <string> adapter-name;

    Rectangle {
        background: Theme.subtle-fill;
        border-radius: Metrics.radius-md;
        border-width: 1px;
        border-color: Theme.border-gray;
        VerticalLayout {
            padding: Metrics.spacing-md;
            spacing: Metrics.spacing-md;
            HorizontalLayout {
                spacing: Metrics.spacing-md;
                alignment: start;
                Rectangle {
                    width: 32px;
                    height: 32px;
                    background: Theme.info-bg;
                    border-radius: Metrics.radius-md;
                    Path {
                        x: 6px;
                        y: 6px;
                        width: 20px;
                        height: 20px;
                        fill: Theme.accent-blue;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: Icons.layer;
                    }
                }
                VerticalLayout {
                    spacing: 2px;
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: "路由叠加";
                        font-size: Typography.heading-size;
                        font-weight: 600;
                        color: Theme.text-primary;
                    }
                    Text {
                        text: "通过旁路由 IP 进行流量转发";
                        font-size: Typography.caption-size;
                        color: Theme.text-secondary;
                    }
                }
            }
            KeyValueRow { key: "网卡"; value: root.adapter-name; empty-text: "未选择"; }
            KeyValueRow { key: "旁路由 IP"; value: root.bypass-ip; }
        }
    }
}

component AdapterReconfigCard {
    in property <string> ip;
    in property <string> mask;
    in property <string> gateway;
    in property <string> dns;
    in property <string> adapter-name;

    Rectangle {
        background: Theme.subtle-fill;
        border-radius: Metrics.radius-md;
        border-width: 1px;
        border-color: Theme.border-gray;
        VerticalLayout {
            padding: Metrics.spacing-md;
            spacing: Metrics.spacing-md;
            HorizontalLayout {
                spacing: Metrics.spacing-md;
                alignment: start;
                Rectangle {
                    width: 32px;
                    height: 32px;
                    background: Theme.success-bg;
                    border-radius: Metrics.radius-md;
                    Path {
                        x: 6px;
                        y: 6px;
                        width: 20px;
                        height: 20px;
                        fill: Theme.success;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: Icons.router;
                    }
                }
                VerticalLayout {
                    spacing: 2px;
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: "网卡直改";
                        font-size: Typography.heading-size;
                        font-weight: 600;
                        color: Theme.text-primary;
                    }
                    Text {
                        text: "修改网卡 IP、网关、DNS 指向旁路由";
                        font-size: Typography.caption-size;
                        color: Theme.text-secondary;
                    }
                }
            }
            KeyValueRow { key: "网卡"; value: root.adapter-name; empty-text: "未选择"; }
            KeyValueRow { key: "网卡 IP"; value: root.ip; empty-text: "未获取"; }
            KeyValueRow { key: "子网掩码"; value: root.mask; empty-text: "未获取"; }
            KeyValueRow { key: "网关"; value: root.gateway; empty-text: "未获取"; }
            KeyValueRow { key: "DNS"; value: root.dns; empty-text: "未获取"; }
        }
    }
}

// 侧边栏一级导航项（规范第 13/14 节）。
//   尺寸：40px 高、圆角 8px、左右 padding 12px、图标 18px、图标文字间距 12px。
//   状态：Normal / Hover / Pressed / Selected / Keyboard Focus 全部覆盖。
//   Selected 用「轻量品牌色底 + 左侧 3px 色条 + 品牌色图标 + Semibold 文字」，
//   避免大面积高饱和实心背景（规范第 14 节）。
component SidebarItem {
    in property <string> icon-data;
    in property <string> label;
    in property <bool> selected;
    callback clicked();

    height: Metrics.control-nav;
    // VerticalLayout 里元素默认 vertical-stretch=1，会把 40px 的菜单项
    // 拉伸铺满整栏高度（表现为菜单上下分散）。固定为 0，剩余空间交给
    // 主布局里的弹性填充块，菜单项从上到下紧凑排列。
    vertical-stretch: 0;

    Rectangle {
        background: root.selected ? Theme.accent-soft
            : (ta.pressed ? Theme.pressed-fill
            : (ta.has-hover ? Theme.hover-fill : transparent));
        border-radius: Metrics.radius-md;
        width: 100%;
        height: 100%;

        // 选中态左侧品牌色条：不依赖颜色也能通过位置/形状识别当前页。
        if root.selected: Rectangle {
            x: 0;
            y: (parent.height - self.height) / 2;
            width: 3px;
            height: parent.height - 14px;
            border-radius: 2px;
            background: Theme.accent-blue;
        }

        // 焦点环：键盘 Tab 到达时显示，不能只依赖 Hover（规范第 14 节）。
        if scope.has-focus: Rectangle {
            background: transparent;
            border-radius: Metrics.radius-md;
            border-width: 1px;
            border-color: Theme.focus-ring;
        }

        HorizontalLayout {
            padding-left: Metrics.spacing-md;
            padding-right: Metrics.spacing-md;
            spacing: Metrics.spacing-md;
            alignment: start;
            // 图标上下居中：Rectangle 不支持 vertical-alignment，
            // 用 VerticalLayout 包一层让内层 alignment: center 生效。
            VerticalLayout {
                alignment: center;
                Path {
                    width: 18px;
                    height: 18px;
                    fill: root.selected ? Theme.accent-blue : Theme.text-secondary;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: root.icon-data;
                }
            }
            Text {
                text: root.label;
                font-size: Typography.body-size;
                font-weight: root.selected ? 600 : 400;
                color: root.selected ? Theme.accent-blue : Theme.text-primary;
                vertical-alignment: center;
            }
        }

        // FocusScope 让菜单项参与 Tab 遍历并具备键盘激活能力；
        // Space / Enter 触发与鼠标点击一致的行为。
        scope := FocusScope {
            width: 100%;
            height: 100%;
            key-pressed(event) => {
                if event.text == " " || event.text == "\n" {
                    root.clicked();
                    accept
                } else {
                    reject
                }
            }
            ta := TouchArea {
                clicked => { root.clicked(); }
            }
        }
    }
}

// 紧凑工具按钮（规范第 39 节：紧凑按钮 32px，Standard 36px）。
// 层级：accent=Primary（品牌蓝实底白字）/ 默认=Secondary（浅底细描边）。
// 状态覆盖 Normal / Hover / Pressed / Keyboard Focus / Disabled（规范第 14 节）。
// 文案不做两行换行，宽度由内容决定（规范第 40 节）。
component ToolButton {
    in property <string> text;
    in property <string> icon-data;
    in property <bool> accent;
    in property <bool> standard: false;
    in property <bool> enabled: true;
    callback clicked();

    height: root.standard ? Metrics.control-std : Metrics.control-compact;
    min-width: 72px;

    Rectangle {
        width: 100%;
        height: 100%;
        background: !root.enabled ? Theme.bg-gray
            : (root.accent
                ? (ta.pressed ? Theme.accent-pressed : (ta.has-hover ? Theme.accent-hover : Theme.accent-blue))
                : (ta.pressed ? Theme.pressed-fill : (ta.has-hover ? Theme.hover-fill : Theme.bg-gray)));
        border-radius: Metrics.radius-sm;
        border-width: root.accent ? 0px : 1px;
        border-color: Theme.border-gray;

        // 焦点环：键盘可达性（规范第 14 节）。
        if btn-scope.has-focus && root.enabled: Rectangle {
            background: transparent;
            border-radius: Metrics.radius-sm;
            border-width: 1px;
            border-color: root.accent ? #ffffff : Theme.focus-ring;
        }

        HorizontalLayout {
            padding-left: Metrics.spacing-md;
            padding-right: Metrics.spacing-md;
            spacing: 6px;
            alignment: center;
            // 图标上下居中：Rectangle/Path 不支持 vertical-alignment，
            // 用 VerticalLayout 包一层让内层 alignment: center 生效，
            // 否则 16px 图标在 32px 按钮里贴顶，与文字错位。
            if root.icon-data != "": VerticalLayout {
                alignment: center;
                Path {
                    width: 16px;
                    height: 16px;
                    fill: !root.enabled ? Theme.text-disabled
                        : (root.accent ? #ffffff : Theme.text-primary);
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: root.icon-data;
                }
            }
            Text {
                text: root.text;
                font-size: Typography.body-size;
                font-weight: 600;
                color: !root.enabled ? Theme.text-disabled
                    : (root.accent ? #ffffff : Theme.text-primary);
                vertical-alignment: center;
            }
        }

        // FocusScope 让按钮参与 Tab 遍历；Space / Enter 触发与点击一致。
        btn-scope := FocusScope {
            width: 100%;
            height: 100%;
            enabled: root.enabled;
            key-pressed(event) => {
                if event.text == " " || event.text == "\n" {
                    root.clicked();
                    accept
                } else {
                    reject
                }
            }
            ta := TouchArea {
                enabled: root.enabled;
                clicked => { root.clicked(); }
            }
        }
    }
}

// ------------------------------------------------------------------
// Pages
// ------------------------------------------------------------------
component HomePage {
    in property <string> status-text;
    in property <int> status-kind: 3;
    in property <bool> is-enabled;
    in property <bool> is-fallback;
    in property <int> latency-ms;
    in property <int> interval-secs;
    in property <int> mode-index;
    in property <string> bypass-ip-text;
    in property <string> adapter-ip;
    in property <string> adapter-mask;
    in property <string> adapter-gateway;
    in property <string> adapter-dns;
    in property <string> adapter-name;
    in property <bool> service-lost: false;
    callback toggle();
    callback switch-mode();

    ScrollView {
        VerticalLayout {
            padding-top: 0px;
            padding-bottom: 0px;
            padding-left: 0px;
            // 为 scrollbar 预留位置（Windows 上原生 scrollbar 几像素宽会与内容重叠）
            padding-right: 12px;
            spacing: Metrics.spacing-lg;

            PageHeader {
                title: "首页";
                subtitle: "查看当前旁路由状态与生效模式，可在此快速启用或停用。";
            }

            // 核心服务断开时给出明确告警（规范第 49 节：发生了什么 + 下一步）。
            if root.service-lost: InlineBanner {
                kind: 2;
                text: "未连接到核心服务。当前页面显示的数据可能不是最新状态，请确认 RouteToolCore 服务是否正在运行，稍后会自动重连。";
            }

            Card {
                CardBody {
                    // 状态行：图标 + 文案 + 颜色共同表达（规范第 46 节）。
                    HorizontalLayout {
                        spacing: Metrics.spacing-md;
                        alignment: start;

                        StatusBadge {
                            text: root.status-text;
                            kind: root.status-kind;
                            horizontal-stretch: 1;
                        }

                        HorizontalLayout {
                            alignment: end;
                            ToggleSwitch {
                                checked: root.is-enabled;
                                text: root.is-enabled ? "已启用" : "已停用";
                                toggled => { root.toggle(); }
                            }
                        }
                    }

                    Text {
                        text: root.is-enabled ? "当前流量已通过旁路由转发" : "当前为直连状态，流量不经旁路由";
                        font-size: Typography.caption-size;
                        color: Theme.text-secondary;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: Metrics.spacing-md;
                        StatItem {
                            label: "延迟";
                            value: root.latency-ms >= 0 ? root.latency-ms + " ms" : "未检测";
                            sub-value: root.latency-ms >= 0 ? "到旁路由" : "启用后开始探测";
                            horizontal-stretch: 1;
                        }
                        StatItem {
                            label: "连通性";
                            value: root.is-fallback ? "异常" : (root.is-enabled ? "正常" : "未检测");
                            value-color: root.is-fallback ? Theme.error : (root.is-enabled ? Theme.success : Theme.text-secondary);
                            sub-value: root.is-fallback ? "已自动回退" : (root.is-enabled ? "自动探测中" : "--");
                            horizontal-stretch: 1;
                        }
                        // 「检测间隔」替代原「上次检测」：检测是自动跑的，不需要
                        // 单独显示上一次检测时间；改为展示用户配置的检测周期。
                        StatItem {
                            label: "检测间隔";
                            value: root.interval-secs + " 秒";
                            sub-value: "自动检测";
                            horizontal-stretch: 1;
                        }
                    }
                }
            }

            Card {
                CardBody {
                    HorizontalLayout {
                        SectionTitle {
                            text: "当前模式";
                            horizontal-stretch: 1;
                        }
                        HorizontalLayout {
                            alignment: end;
                            Text {
                                text: "前往配置";
                                font-size: Typography.caption-size;
                                color: Theme.accent-blue;
                                vertical-alignment: center;
                                TouchArea {
                                    clicked => { root.switch-mode(); }
                                }
                            }
                        }
                    }

                    if root.mode-index == 0: RouteOverlayCard {
                        bypass-ip: root.bypass-ip-text;
                        adapter-name: root.adapter-name;
                    }

                    if root.mode-index == 1: AdapterReconfigCard {
                        ip: root.adapter-ip;
                        mask: root.adapter-mask;
                        gateway: root.adapter-gateway;
                        dns: root.adapter-dns;
                        adapter-name: root.adapter-name;
                    }
                }
            }

            Text {
                text: root.mode-index == 0
                    ? "提示：当前为路由叠加模式，通过添加 0.0.0.0/1 与 128.0.0.0/1 两条路由覆盖默认路由，若需要修改配置请前往配置页面。"
                    : "提示：当前为网卡直改模式，修改网卡 IP、网关、DNS 指向旁路由，配置页面可调整静态 IP 等参数。";
                font-size: Typography.caption-size;
                color: Theme.text-tertiary;
                wrap: word-wrap;
            }
        }
    }
}

component ConfigPage {
    in-out property <int> mode-index;
    in property <[string]> adapter-names;
    in-out property <int> adapter-index;
    in-out property <string> bypass-ip-text;
    in-out property <string> static-ip-text;
    in-out property <string> mask-text;
    in-out property <string> dns-text;
    in-out property <int> interval-secs;
    in-out property <int> failure-threshold;
    in-out property <bool> auto-reenable;
    in-out property <bool> notifications;
    in-out property <bool> launch-at-startup;
    in property <string> config-error;
    in property <int> config-error-kind: 2;
    in property <string> save-state;
    in property <string> err-bypass-ip;
    in property <string> err-static-ip;
    in property <string> err-mask;
    in property <string> err-dns;
    callback adapter-changed(int);
    callback save-config();
    callback restore-default();
    callback launch-at-startup-changed(bool);
    callback dismiss-config-error();

    ScrollView {
        VerticalLayout {
            padding-top: 0px;
            padding-bottom: 0px;
            padding-left: 0px;
            padding-right: 12px;
            // 分组之间 20~24px（规范第 21 节）。
            spacing: Metrics.spacing-xl;

            PageHeader {
                title: "配置";
                subtitle: "选择旁路由生效模式，设置旁路由地址与检测策略。修改后点击「保存」生效。";
            }

            // ---- 分组一：模式选择（按语义分组，不按控件类型分组；规范第 19 节）----
            Card {
                CardBody {
                    SectionTitle {
                        text: "生效模式";
                        hint: "两种模式互斥，同一时间只能使用一种。";
                    }
                    HorizontalLayout {
                        spacing: Metrics.spacing-md;
                        ModeCard {
                            title: "路由叠加";
                            desc: "不改动网卡设置，通过添加 0.0.0.0/1 与 128.0.0.0/1 两条路由把流量导向旁路由。切换快、可随时撤销。";
                            icon-data: Icons.layer;
                            selected: root.mode-index == 0;
                            horizontal-stretch: 1;
                            clicked => { root.mode-index = 0; }
                        }
                        ModeCard {
                            title: "网卡直改";
                            desc: "直接把网卡 IP、网关、DNS 指向旁路由。兼容性更好，但会改动系统网络设置。";
                            icon-data: Icons.router;
                            selected: root.mode-index == 1;
                            horizontal-stretch: 1;
                            clicked => { root.mode-index = 1; }
                        }
                    }
                }
            }

            // ---- 分组二：连接设置（Label → Input → Description；规范第 18 节）----
            Card {
                CardBody {
                    SectionTitle {
                        text: root.mode-index == 0 ? "旁路由设置" : "网卡直改设置";
                        hint: root.mode-index == 0
                            ? "指定旁路由 IP，流量将通过该地址转发。"
                            : "指定旁路由 IP，并可直接改写网卡地址与 DNS。";
                    }

                    FormRow {
                        label: "网卡";
                        description: root.adapter-index < 0 ? "暂未读取到网卡列表，请确认核心服务正在运行。" : "流量从这里选择的网卡发出；标注「未连接」的网卡当前未插网线或未关联。";
                        ComboBox {
                            model: root.adapter-names;
                            current-index <=> root.adapter-index;
                            min-height: Metrics.control-std;
                            enabled: root.adapter-names.length > 0;
                            selected => { root.adapter-changed(self.current-index); }
                        }
                    }

                    FormRow {
                        label: "旁路由 IP";
                        description: "填写旁路由的局域网地址，例如 192.168.123.105。";
                        error: root.err-bypass-ip;
                        TextField {
                            text <=> root.bypass-ip-text;
                            placeholder: "例如 192.168.123.105";
                            has-error: root.err-bypass-ip != "";
                        }
                    }

                    if root.mode-index == 1: VerticalLayout {
                        spacing: Metrics.spacing-lg;
                        FormRow {
                            label: "网卡静态 IP";
                            description: "留空则保留网卡当前 IP 不变。";
                            error: root.err-static-ip;
                            TextField {
                                text <=> root.static-ip-text;
                                placeholder: "例如 192.168.2.100";
                                has-error: root.err-static-ip != "";
                            }
                        }
                        FormRow {
                            label: "子网掩码";
                            description: "留空则使用默认值 255.255.255.0。";
                            error: root.err-mask;
                            TextField {
                                text <=> root.mask-text;
                                placeholder: "255.255.255.0";
                                has-error: root.err-mask != "";
                            }
                        }
                        FormRow {
                            label: "DNS";
                            description: "多个地址用逗号分隔；留空则使用旁路由 IP 作为 DNS。";
                            error: root.err-dns;
                            TextField {
                                text <=> root.dns-text;
                                placeholder: "例如 192.168.123.105, 223.5.5.5";
                                has-error: root.err-dns != "";
                            }
                        }
                    }
                }
            }

            // ---- 分组三：检测与恢复（高级选项按需展示；规范第 6 节渐进披露）----
            Card {
                CardBody {
                    SectionTitle {
                        text: "检测与恢复";
                        hint: "核心服务会按检测间隔探测旁路由，连续失败达到阈值后自动回退到直连，避免断网。";
                    }

                    HorizontalLayout {
                        spacing: Metrics.spacing-lg;
                        FormRow {
                            label: "检测间隔";
                            suffix: "秒";
                            description: "范围 1 ~ 60 秒。";
                            horizontal-stretch: 1;
                            NumberBox {
                                minimum: 1;
                                maximum: 60;
                                value <=> root.interval-secs;
                            }
                        }
                        FormRow {
                            label: "失败阈值";
                            suffix: "次";
                            description: "范围 1 ~ 10 次。";
                            horizontal-stretch: 1;
                            NumberBox {
                                minimum: 1;
                                maximum: 10;
                                value <=> root.failure-threshold;
                            }
                        }
                    }

                    Rectangle { height: 1px; background: Theme.border-gray; }

                    CheckBox {
                        text: "旁路由恢复后自动重新启用";
                        checked <=> root.auto-reenable;
                    }
                    CheckBox {
                        text: "启用系统通知";
                        checked <=> root.notifications;
                    }
                }
            }

            // 开机自启是 UI 层设置（写 HKCU Run 键，注册表值带 --tray 参数），
            // 不走核心服务配置。
            Card {
                CardBody {
                    SectionTitle {
                        text: "启动设置";
                        hint: "控制 Windows 登录后 RouteTool 的启动方式。";
                    }
                    CheckBox {
                        text: "开机自动启动（仅启动托盘图标，不打开窗口）";
                        checked <=> root.launch-at-startup;
                        toggled => { root.launch-at-startup-changed(self.checked); }
                    }
                    Text {
                        text: "开机后 RouteTool 仅在系统托盘运行，双击托盘图标可打开设置窗口；核心服务会自动核实并恢复旁路由状态。";
                        font-size: Typography.caption-size;
                        color: Theme.text-tertiary;
                        wrap: word-wrap;
                    }
                }
            }

            // ---- 保存结果提示（可关闭，避免长期占用视觉焦点；规范第 61 节）----
            if root.config-error != "": InlineBanner {
                text: root.config-error;
                kind: root.config-error-kind;
                show-close: true;
                dismissed => { root.dismiss-config-error(); }
            }

            // ---- 操作区（同一区域只保留一个 Primary；规范第 39/41 节）----
            HorizontalLayout {
                spacing: Metrics.spacing-md;
                alignment: end;

                Text {
                    text: root.save-state == "saved" ? "已保存" : "";
                    font-size: Typography.caption-size;
                    color: Theme.success;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                ToolButton {
                    text: "恢复默认";
                    enabled: root.save-state != "saving";
                    clicked => { root.restore-default(); }
                }
                ToolButton {
                    text: root.save-state == "saving" ? "保存中…" : "保存并应用";
                    icon-data: root.save-state == "saving" ? Icons.spinner : Icons.save;
                    accent: true;
                    // 保存进行中禁止重复触发（规范第 72 节）。
                    enabled: root.save-state != "saving";
                    clicked => { root.save-config(); }
                }
            }
        }
    }
}

// LogRow 自适应高度：把单条日志 message 文本换行后整个行条按内容增高，
// 避免固定行高遮住 wrap 文本。
//   - 三列固定宽：时间 / 等级徽标 / 内容（13px 日志字号，规范「日志文字」）；
//   - message 用 vertical-alignment: top，多行时贴顶显示（默认 center 会让
//     首行垂直方向居中，看起来不跟 time/level 列对齐）。
// LogRow 自适应高度：把单条日志 message 文本换行后整个行条按内容增高，
// 避免固定行高遮住 wrap 文本。
//   - 三列：时间（固定窄列）/ 等级徽标（固定宽）/ 内容（弹性列，可换行）；
//     列宽按内容类型设计，描述类占据剩余宽度（规范第 55 节）。
//   - 等级用「浅底徽标 + 语义色文字」，同时保留文字标签，不只靠颜色（规范第 46 节）。
//   - message 用 vertical-alignment: top，多行时贴顶显示（默认 center 会让
//     首行垂直方向居中，看起来不跟 time/level 列对齐）。
component LogRow {
    in property <string> time;
    in property <string> level;
    in property <string> message;
    in property <int> row-index;

    Rectangle {
        background: Math.mod(row-index, 2) == 0 ? #ffffff : Theme.card-gray;
        min-height: 28px;
        HorizontalLayout {
            padding-top: Metrics.spacing-xs;
            padding-bottom: Metrics.spacing-xs;
            padding-left: Metrics.spacing-xs;
            padding-right: Metrics.spacing-xs;
            spacing: Metrics.spacing-sm;

            // 时间列：固定窄宽度（时间类列固定宽度，规范第 55 节）。
            Rectangle {
                width: 68px;
                background: Theme.bg-gray;
                border-radius: 3px;
                Text {
                    text: root.time;
                    font-size: Typography.label-size;
                    color: Theme.text-secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // 等级徽标：固定宽度 + 浅底语义色，配文字标签。
            Rectangle {
                width: 52px;
                background: root.level == "ERROR" ? Theme.error-bg
                    : (root.level == "WARN" ? Theme.warning-bg
                    : (root.level == "INFO" ? Theme.info-bg : Theme.bg-gray));
                border-radius: 3px;
                Text {
                    text: root.level == "" ? "LOG" : root.level;
                    font-size: Typography.caption-size;
                    font-weight: 600;
                    color: root.level == "ERROR" ? Theme.error
                        : (root.level == "WARN" ? Theme.warning
                        : (root.level == "INFO" ? Theme.accent-blue : Theme.text-secondary));
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Text {
                text: root.message;
                font-size: Typography.label-size;
                color: Theme.text-primary;
                wrap: word-wrap;
                vertical-alignment: top;
                horizontal-stretch: 1;
            }
        }
    }
}

component LogsPage {
    in property <[LogEntry]> log-entries;
    in property <bool> logs-loading: false;
    callback open-logs();
    callback refresh();

    VerticalLayout {
        padding: 0px;
        spacing: Metrics.spacing-lg;

        HorizontalLayout {
            spacing: Metrics.spacing-md;
            PageHeader {
                title: "日志";
                subtitle: "最近的界面与核心服务运行记录，按时间倒序，最多显示 200 条。";
                horizontal-stretch: 1;
            }
            HorizontalLayout {
                alignment: end;
                spacing: Metrics.spacing-sm;
                ToolButton {
                    text: "刷新";
                    icon-data: Icons.refresh;
                    clicked => { root.refresh(); }
                }
                ToolButton {
                    text: "打开日志目录";
                    icon-data: Icons.folder-open;
                    clicked => { root.open-logs(); }
                }
            }
        }

        Card {
            // 高度吃满窗口剩余空间，日志列表随窗口伸缩。
            vertical-stretch: 1;
            VerticalLayout {
                padding: 0px;
                spacing: 0px;

                // 空状态 / 加载状态：不留白屏（规范第 47/48 节）。
                // Slint 不支持 else if，用互斥条件表达三选一。
                if root.logs-loading: VerticalLayout {
                    alignment: center;
                    vertical-stretch: 1;
                    EmptyState {
                        title: "正在读取日志…";
                        hint: "正在从日志目录加载最近的记录。";
                    }
                }
                if !root.logs-loading && root.log-entries.length == 0: VerticalLayout {
                    alignment: center;
                    vertical-stretch: 1;
                    EmptyState {
                        title: "暂无日志记录";
                        hint: "这里还没有可显示的日志。点击「刷新」重新读取，或确认核心服务正在运行。";
                    }
                }
                if !root.logs-loading && root.log-entries.length > 0: ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: Metrics.spacing-sm;
                        padding-right: Metrics.spacing-md;
                        spacing: 0px;
                        for entry[idx] in root.log-entries: LogRow {
                            time: entry.time;
                            level: entry.level;
                            message: entry.message;
                            row-index: idx;
                        }
                    }
                }
            }
        }
    }
}

component AboutPage {
    in property <string> version-text;
    callback check-update();

    // 页面实例处设置 horizontal-stretch: 1，让本页铺满右侧内容区宽度；
    // 顶部行把「检查更新」推至右侧，下方内容块 vertical-stretch: 1 + alignment: center
    // 在剩余空间里垂直居中。
    VerticalLayout {
        padding: 0px;
        spacing: Metrics.spacing-lg;
        vertical-stretch: 1;

        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: Metrics.spacing-md;
            PageHeader {
                title: "关于";
                subtitle: "版本信息与项目说明。";
                horizontal-stretch: 1;
            }
            HorizontalLayout {
                alignment: end;
                ToolButton {
                    text: "检查更新";
                    icon-data: Icons.refresh;
                    accent: true;
                    clicked => { root.check-update(); }
                }
            }
        }

        VerticalLayout {
            spacing: Metrics.spacing-lg;
            alignment: center;
            horizontal-stretch: 1;
            vertical-stretch: 1;

            // 直接以高分辨率 source 缩放到 72×72，画质比 24 viewBox 矢量图更稳。
            HorizontalLayout {
                alignment: center;
                Image {
                    source: @image-url("../../../assets/app.png");
                    width: 72px;
                    height: 72px;
                }
            }
            Text {
                text: "RouteTool";
                font-size: Typography.title-size;
                font-weight: 600;
                color: Theme.text-primary;
                horizontal-alignment: center;
            }
            Text {
                text: root.version-text;
                font-size: Typography.caption-size;
                color: Theme.text-secondary;
                horizontal-alignment: center;
            }
            HorizontalLayout {
                alignment: center;
                Text {
                    text: "Windows 桌面旁路由一键切换工具。支持路由叠加与网卡直改两种模式，具备旁路由异常自动侦测与回退能力。";
                    font-size: Typography.caption-size;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    max-width: 460px;
                }
            }
            Text {
                text: "本项目采用 MIT 许可证开源";
                font-size: Typography.caption-size;
                color: Theme.text-tertiary;
                horizontal-alignment: center;
            }
            Text {
                text: "github.com/5kywa1ker/route-tool";
                font-size: Typography.caption-size;
                color: Theme.accent-blue;
                horizontal-alignment: center;
            }
        }
    }
}

// ------------------------------------------------------------------
// 主窗口
// ------------------------------------------------------------------
export component AppWindow inherits Window {
    title: "RouteTool 旁路由切换工具";
    icon: @image-url("../../../assets/app.png");
    // 规范：英文/数字 Segoe UI Variable，中文经系统 fallback 到 Microsoft YaHei UI；
    // std-widgets 的默认字号统一 14px（正文）。
    default-font-family: "Segoe UI Variable";
    default-font-size: Typography.body-size;
    // 窗口尺寸：侧栏按规范加宽到 200px 后，同步放宽默认宽度，
    // 保证右侧表单（Label→Input→Description）仍有舒适阅读宽度（规范第 10/11 节）。
    preferred-width: 880px;
    preferred-height: 600px;
    min-width: 720px;
    min-height: 520px;

    in property <string> status-text: "未连接到核心服务";
    in property <bool> is-enabled: false;
    in property <bool> is-fallback: false;
    in property <int> latency-ms: -1;
    in property <string> version-text: "v0.0.0";
    in property <string> service-status-text: "服务运行中";

    in property <[string]> adapter-names: [];
    in-out property <int> adapter-index: -1;

    in property <string> selected-adapter-name: "--";
    in property <string> selected-adapter-ip: "--";
    in property <string> selected-adapter-mask: "--";
    in property <string> selected-adapter-gateway: "--";
    in property <string> selected-adapter-dns: "--";

    in-out property <string> bypass-ip-text: "";
    in-out property <int> mode-index: 0;
    in-out property <string> static-ip-text: "";
    in-out property <string> mask-text: "";
    in-out property <string> dns-text: "";
    in-out property <int> interval-secs: 5;
    in-out property <int> failure-threshold: 3;
    in-out property <bool> auto-reenable: false;
    in-out property <bool> notifications: true;
    in-out property <bool> launch-at-startup: false;

    // 页面级汇总提示（可关闭的内联提示条，规范第 59/60 节）。
    in property <string> config-error: "";
    // kind: 0=成功 1=注意 2=失败 3=信息
    in property <int> config-error-kind: 2;
    // 保存流程状态："" 空闲 / "saving" 保存中 / "saved" 已保存（规范第 72/73 节）
    in property <string> save-state: "";

    // 字段级错误（规范第 23/34 节）：空字符串表示该字段无错误。
    // 出错的输入框描边转错误色并在字段下方给出具体原因，
    // 而不是把所有校验失败汇总成页面底部一行红字。
    in property <string> err-bypass-ip: "";
    in property <string> err-static-ip: "";
    in property <string> err-mask: "";
    in property <string> err-dns: "";

    // 服务连接告警：核心服务不可用时明确告知，而不是只靠侧栏一个小圆点。
    in property <bool> service-lost: false;

    in property <[LogEntry]> log-entries: [];
    // 日志读取状态（规范第 47/48 节）：空状态 / 加载中要有明确表述。
    in property <bool> logs-loading: false;
    in-out property <int> current-page: 0;

    callback toggle-bypass();
    callback save-config();
    callback open-logs();
    callback adapter-changed(int);
    callback restore-default();
    callback check-update();
    callback refresh-logs();
    callback launch-at-startup-changed(bool);
    callback dismiss-config-error();
    // 主动触发「拉取最新网卡列表 + 刷新首页下方卡片」
    callback refresh-adapters();

    property <color> status-color: root.is-fallback ? Theme.error
        : (root.is-enabled ? Theme.success : Theme.text-secondary);

    // 状态语义：交给 StatusBadge 统一表达（图标 + 文案 + 颜色）。
    property <int> status-kind: root.is-fallback ? 2
        : (root.is-enabled ? 0 : 3);

    HorizontalLayout {
        Rectangle {
            // 侧栏宽度 200px（规范第 13 节 200~220px）。
            width: 200px;
            background: #ffffff;

            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                height: 100%;
                background: Theme.border-gray;
            }

            VerticalLayout {
                padding: Metrics.spacing-md;
                // 菜单项之间 2~4px（规范第 13 节）。
                spacing: Metrics.spacing-xs;

                HorizontalLayout {
                    spacing: Metrics.spacing-sm;
                    alignment: start;
                    Image {
                        source: @image-url("../../../assets/app.png");
                        width: 32px;
                        height: 32px;
                    }
                    VerticalLayout {
                        spacing: 2px;
                        alignment: center;
                        Text {
                            text: "RouteTool";
                            font-size: Typography.body-size;
                            font-weight: 600;
                            color: Theme.text-primary;
                        }
                        Text {
                            text: "旁路由切换";
                            font-size: Typography.caption-size;
                            color: Theme.text-tertiary;
                        }
                    }
                }

                Rectangle { height: Metrics.spacing-md; }

                SidebarItem {
                    icon-data: Icons.home;
                    label: "首页";
                    selected: root.current-page == 0;
                    clicked => { root.current-page = 0; root.refresh-adapters(); }
                }
                SidebarItem {
                    icon-data: Icons.settings;
                    label: "配置";
                    selected: root.current-page == 1;
                    clicked => { root.current-page = 1; }
                }
                SidebarItem {
                    icon-data: Icons.logs;
                    label: "日志";
                    selected: root.current-page == 2;
                    clicked => { root.current-page = 2; root.refresh-logs(); }
                }
                SidebarItem {
                    icon-data: Icons.about;
                    label: "关于";
                    selected: root.current-page == 3;
                    clicked => { root.current-page = 3; }
                }

                // 弹性填充：吸收剩余高度，让菜单项贴顶、底部状态块贴底。
                Rectangle {
                    vertical-stretch: 1;
                    min-height: 0;
                }

                VerticalLayout {
                    alignment: end;
                    spacing: Metrics.spacing-xs;
                    vertical-stretch: 0;

                    // 连接状态：图标 + 文案共同表达，不只是一个小圆点（规范第 46 节）。
                    StatusBadge {
                        compact: true;
                        text: root.service-status-text;
                        kind: root.service-status-text == "服务运行中" ? 0 : 2;
                    }

                    Text {
                        text: root.version-text;
                        font-size: Typography.caption-size;
                        color: Theme.text-tertiary;
                    }
                }
            }
        }

        Rectangle {
            background: Theme.bg-gray;
            HorizontalLayout {
                // 内容区 padding（规范第 10 节）。
                padding: Metrics.content-padding;
                spacing: 0px;

                if root.current-page == 0: HomePage {
                    status-text: root.status-text;
                    status-kind: root.status-kind;
                    is-enabled: root.is-enabled;
                    is-fallback: root.is-fallback;
                    latency-ms: root.latency-ms;
                    interval-secs: root.interval-secs;
                    mode-index: root.mode-index;
                    bypass-ip-text: root.bypass-ip-text;
                    adapter-ip: root.selected-adapter-ip;
                    adapter-mask: root.selected-adapter-mask;
                    adapter-gateway: root.selected-adapter-gateway;
                    adapter-dns: root.selected-adapter-dns;
                    adapter-name: root.selected-adapter-name;
                    service-lost: root.service-lost;
                    toggle => { root.toggle-bypass(); }
                    switch-mode => { root.current-page = 1; }
                }

                if root.current-page == 1: ConfigPage {
                    mode-index <=> root.mode-index;
                    adapter-names: root.adapter-names;
                    adapter-index <=> root.adapter-index;
                    bypass-ip-text <=> root.bypass-ip-text;
                    static-ip-text <=> root.static-ip-text;
                    mask-text <=> root.mask-text;
                    dns-text <=> root.dns-text;
                    interval-secs <=> root.interval-secs;
                    failure-threshold <=> root.failure-threshold;
                    auto-reenable <=> root.auto-reenable;
                    notifications <=> root.notifications;
                    launch-at-startup <=> root.launch-at-startup;
                    config-error: root.config-error;
                    config-error-kind: root.config-error-kind;
                    save-state: root.save-state;
                    err-bypass-ip: root.err-bypass-ip;
                    err-static-ip: root.err-static-ip;
                    err-mask: root.err-mask;
                    err-dns: root.err-dns;
                    adapter-changed(index) => { root.adapter-changed(index); }
                    save-config => { root.save-config(); }
                    restore-default => { root.restore-default(); }
                    launch-at-startup-changed(enabled) => { root.launch-at-startup-changed(enabled); }
                    dismiss-config-error => { root.dismiss-config-error(); }
                }

                if root.current-page == 2: LogsPage {
                    log-entries: root.log-entries;
                    logs-loading: root.logs-loading;
                    open-logs => { root.open-logs(); }
                    refresh => { root.refresh-logs(); }
                }

                // horizontal-stretch: 1 让关于页铺满右侧内容区（ScrollView 页天然铺满，
                // AboutPage 根是 VerticalLayout，需要显式拉伸）。
                if root.current-page == 3: AboutPage {
                    version-text: root.version-text;
                    check-update => { root.check-update(); }
                    horizontal-stretch: 1;
                }
            }
        }
    }
}
