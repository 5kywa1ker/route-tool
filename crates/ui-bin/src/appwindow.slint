// RouteTool 设置窗口 —— Windows 11 Fluent 风格布局。

import { Button, ComboBox, LineEdit, SpinBox, CheckBox, GridBox, ScrollView } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "RouteTool";
    icon: @image-url("../../../assets/app.png");
    preferred-width: 480px;
    preferred-height: 600px;
    min-width: 440px;
    min-height: 500px;

    // 用户可编辑的控件属性一律用 in-out + 双向绑定（<=>）：
    // 单向绑定会让 Rust 侧属性与控件实际状态失同步。
    in property <string> status-text: "未连接到核心服务";
    in property <bool> is-enabled: false;
    in property <bool> is-fallback: false;
    in property <[string]> adapter-names: [];
    in-out property <int> adapter-index: -1;
    in-out property <string> bypass-ip-text: "";
    in-out property <int> mode-index: 0;         // 0=路由叠加 1=网卡直改
    in-out property <string> dns-text: "";
    in-out property <string> mask-text: "";
    in-out property <int> interval-secs: 5;
    in-out property <int> failure-threshold: 3;
    in-out property <bool> auto-reenable: false;
    in-out property <bool> notifications: true;
    in property <string> test-result: "";
    in property <string> config-error: "";

    callback toggle-bypass();
    callback test-connectivity();
    callback save-config();
    callback open-logs();
    callback adapter-changed(int);

    // 状态语义色：绿=旁路由生效，红=异常回退，灰=直连/未连接。
    property <color> status-color: root.is-fallback ? #c42b1c
        : (root.is-enabled ? #0f7b0f : #5d5d5d);

    ScrollView {
        VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // ---- 标题区 ----
        HorizontalLayout {
            spacing: 10px;
            alignment: center;
            Text {
                text: "RouteTool";
                font-size: 22px;
                font-weight: 600;
                color: #1a1a1a;
            }
            Text {
                text: "旁路由切换";
                font-size: 12px;
                color: #888888;
                vertical-alignment: center;
            }
        }

        // ---- 状态卡片 ----
        Rectangle {
            border-radius: 8px;
            background: #f5f5f5;
            border-width: 1px;
            border-color: #e6e6e6;
            VerticalLayout {
                padding: 14px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    Rectangle {
                        width: 10px;
                        height: 10px;
                        border-radius: 5px;
                        background: root.status-color;
                    }
                    Text {
                        text: root.status-text;
                        font-size: 14px;
                        font-weight: 600;
                        color: #1a1a1a;
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Button {
                        text: root.is-enabled ? "禁用旁路由" : "启用旁路由";
                        primary: true;
                        clicked => { root.toggle-bypass(); }
                    }
                    Button {
                        text: "测试连通性";
                        clicked => { root.test-connectivity(); }
                    }
                }
                if root.test-result != "": Text {
                    text: root.test-result;
                    font-size: 11px;
                    color: #666666;
                }
            }
        }

        // ---- 配置卡片 ----
        Rectangle {
            border-radius: 8px;
            background: #f5f5f5;
            border-width: 1px;
            border-color: #e6e6e6;
            VerticalLayout {
                padding: 14px;
                spacing: 10px;
                Text {
                    text: "配置";
                    font-size: 15px;
                    font-weight: 600;
                    color: #1a1a1a;
                }

                // 网卡
                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: "网卡";
                        font-size: 12px;
                        color: #5d5d5d;
                    }
                    ComboBox {
                        model: root.adapter-names;
                        current-index <=> root.adapter-index;
                        selected => { root.adapter-changed(self.current-index); }
                    }
                }

                // 旁路由 IP
                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: "旁路由 IP";
                        font-size: 12px;
                        color: #5d5d5d;
                    }
                    LineEdit {
                        text <=> root.bypass-ip-text;
                        placeholder-text: "例如 192.168.2.1";
                    }
                }

                // 切换模式
                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: "切换模式";
                        font-size: 12px;
                        color: #5d5d5d;
                    }
                    ComboBox {
                        model: ["路由叠加（推荐）", "网卡直改"];
                        current-index <=> root.mode-index;
                    }
                }

                // 网卡直改模式独有配置
                if root.mode-index == 1: VerticalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: "子网掩码";
                            font-size: 12px;
                            color: #5d5d5d;
                        }
                        LineEdit {
                            text <=> root.mask-text;
                            placeholder-text: "255.255.255.0";
                        }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: "DNS";
                            font-size: 12px;
                            color: #5d5d5d;
                        }
                        LineEdit {
                            text <=> root.dns-text;
                            placeholder-text: "留空则使用旁路由 IP";
                        }
                    }
                }

                // 健康检测参数（两列）
                GridBox {
                    spacing: 10px;
                    Row {
                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "检测间隔（秒）";
                                font-size: 12px;
                                color: #5d5d5d;
                            }
                            SpinBox {
                                minimum: 1;
                                maximum: 60;
                                value <=> root.interval-secs;
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "失败阈值";
                                font-size: 12px;
                                color: #5d5d5d;
                            }
                            SpinBox {
                                minimum: 1;
                                maximum: 10;
                                value <=> root.failure-threshold;
                            }
                        }
                    }
                }

                // 开关项
                VerticalLayout {
                    spacing: 8px;
                    CheckBox {
                        text: "旁路由恢复后自动重新启用";
                        checked <=> root.auto-reenable;
                    }
                    CheckBox {
                        text: "启用系统通知";
                        checked <=> root.notifications;
                    }
                }
            }
        }

        // 错误提示
        if root.config-error != "": Text {
            text: root.config-error;
            font-size: 11px;
            color: #c42b1c;
        }

        // 底部操作
        HorizontalLayout {
            spacing: 10px;
            Button {
                text: "保存配置";
                clicked => { root.save-config(); }
            }
            Button {
                text: "打开日志目录";
                clicked => { root.open-logs(); }
            }
        }

        // 说明文字
        Text {
            text: "路由叠加：添加 0.0.0.0/1 + 128.0.0.0/1 两条路由覆盖默认路由，不动网卡配置。\n网卡直改：直接修改网卡的网关 / DNS / 子网掩码，需备份恢复，风险略高。";
            font-size: 10px;
            color: #888888;
            wrap: word-wrap;
        }
        }
    }
}
