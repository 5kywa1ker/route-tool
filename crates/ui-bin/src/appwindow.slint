// 日志条目模型
export struct LogEntry {
    time: string,
    level: string,
    message: string,
}

// ------------------------------------------------------------------
// 通用组件
// ------------------------------------------------------------------
component Card {
    Rectangle {
        background: Theme.card-gray;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.border-gray;
        drop-shadow-offset-x: 0;
        drop-shadow-offset-y: 1px;
        drop-shadow-blur: 4px;
        drop-shadow-color: #00000006;
        @children
    }
}

component ToggleSwitch {
    in-out property <bool> checked;
    in property <string> text;
    callback toggled();

    HorizontalLayout {
        spacing: 6px;
        alignment: center;
        Rectangle {
            width: 38px;
            height: 22px;
            border-radius: 11px;
            background: root.checked ? Theme.accent-blue : #c8c8c8;
            Rectangle {
                x: root.checked ? 18px : 2px;
                y: 2px;
                width: 18px;
                height: 18px;
                border-radius: 9px;
                background: #ffffff;
                animate x { duration: 150ms; easing: ease-in-out; }
            }
            TouchArea {
                clicked => {
                    root.checked = !root.checked;
                    root.toggled();
                }
            }
        }
        Text {
            text: root.text;
            font-size: Typography.body-size;
            color: Theme.text-primary;
            vertical-alignment: center;
        }
    }
}

component FormRow {
    in property <string> label;

    VerticalLayout {
        spacing: 4px;
        Text {
            text: root.label;
            font-size: Typography.label-size;
            color: Theme.text-secondary;
        }
        @children
    }
}

component StatItem {
    in property <string> label;
    in property <string> value;
    in property <string> sub-value;
    in property <color> value-color: Theme.text-primary;

    Rectangle {
        background: #ffffff;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.border-gray;
        VerticalLayout {
            padding-top: 12px;
            padding-bottom: 12px;
            padding-left: 14px;
            padding-right: 14px;
            spacing: 4px;
            Text {
                text: root.label;
                font-size: Typography.label-size;
                color: Theme.text-secondary;
            }
            Text {
                text: root.value;
                font-size: Typography.title-size;
                font-weight: 600;
                color: root.value-color;
            }
            if root.sub-value != "": Text {
                text: root.sub-value;
                font-size: Typography.caption-size;
                color: Theme.text-tertiary;
            }
        }
    }
}

component InfoRow {
    in property <string> label;
    in property <string> value;

    VerticalLayout {
        spacing: 3px;
        Text {
            text: root.label;
            font-size: Typography.label-size;
            color: Theme.text-secondary;
        }
        Text {
            text: root.value;
            font-size: Typography.body-size;
            color: Theme.text-primary;
        }
    }
}

component ModeCard {
    in property <string> title;
    in property <string> desc;
    in property <string> icon-data;
    in property <bool> selected;
    callback clicked();

    Rectangle {
        background: root.selected ? #e8f4fd : #ffffff;
        border-radius: 10px;
        border-width: root.selected ? 2px : 1px;
        border-color: root.selected ? Theme.accent-blue : Theme.border-gray;
        VerticalLayout {
            padding-top: 12px;
            padding-bottom: 6px;
            padding-left: 14px;
            padding-right: 14px;
            spacing: 6px;
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Rectangle {
                    width: 32px;
                    height: 32px;
                    background: root.selected ? #ffffff : Theme.bg-gray;
                    border-radius: 8px;
                    Path {
                        x: 6px;
                        y: 6px;
                        width: 20px;
                        height: 20px;
                        fill: root.selected ? Theme.accent-blue : Theme.text-secondary;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: root.icon-data;
                    }
                }
                VerticalLayout {
                    spacing: 3px;
                    alignment: center;
                    Text {
                        text: root.title;
                        font-size: Typography.heading-size;
                        font-weight: 600;
                        color: Theme.text-primary;
                    }
                    Text {
                        text: root.desc;
                        font-size: Typography.caption-size;
                        color: Theme.text-secondary;
                        wrap: word-wrap;
                    }
                }
            }
            if root.selected: Text {
                text: "已选择";
                font-size: Typography.caption-size;
                color: Theme.accent-blue;
                horizontal-alignment: right;
            }
        }
        TouchArea {
            clicked => { root.clicked(); }
        }
    }
}

// 「旁路由 IP」等 key-value 行。
// Slint 的 HorizontalLayout 里 Text 默认 horizontal-stretch=1：若只固定 value 的
// stretch，key 的框会被撑满整行，把 value 顶到行尾。key/value 都设
// horizontal-stretch: 0，两个 Text 都保持固有宽度并紧贴行首排列。
component KeyValueRow {
    in property <string> key;
    in property <string> value;
    in property <color> value-color: Theme.text-primary;

    HorizontalLayout {
        spacing: 6px;
        Text {
            text: root.key;
            font-size: Typography.label-size;
            color: Theme.text-secondary;
            horizontal-stretch: 0;
        }
        Text {
            text: root.value;
            font-size: Typography.label-size;
            color: root.value-color;
            horizontal-stretch: 0;
        }
    }
}

component RouteOverlayCard {
    in property <string> bypass-ip;
    in property <string> adapter-name;

    Rectangle {
        background: #ffffff;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.border-gray;
        VerticalLayout {
            padding: 14px;
            spacing: 10px;
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Rectangle {
                    width: 32px;
                    height: 32px;
                    background: #e8f4fd;
                    border-radius: 8px;
                    Path {
                        x: 6px;
                        y: 6px;
                        width: 20px;
                        height: 20px;
                        fill: Theme.accent-blue;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: Icons.layer;
                    }
                }
                VerticalLayout {
                    spacing: 2px;
                    alignment: center;
                    Text {
                        text: "路由叠加";
                        font-size: Typography.heading-size;
                        font-weight: 600;
                        color: Theme.text-primary;
                    }
                    Text {
                        text: "通过旁路由 IP 进行流量转发";
                        font-size: Typography.caption-size;
                        color: Theme.text-secondary;
                    }
                }
            }
            KeyValueRow { key: "网卡"; value: root.adapter-name; }
            KeyValueRow { key: "旁路由 IP"; value: root.bypass-ip; }
        }
    }
}

component AdapterReconfigCard {
    in property <string> ip;
    in property <string> mask;
    in property <string> gateway;
    in property <string> dns;
    in property <string> adapter-name;

    Rectangle {
        background: #ffffff;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.border-gray;
        VerticalLayout {
            padding: 14px;
            spacing: 10px;
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Rectangle {
                    width: 32px;
                    height: 32px;
                    background: #f0f9e8;
                    border-radius: 8px;
                    Path {
                        x: 6px;
                        y: 6px;
                        width: 20px;
                        height: 20px;
                        fill: Theme.success;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: Icons.router;
                    }
                }
                VerticalLayout {
                    spacing: 2px;
                    alignment: center;
                    Text {
                        text: "网卡直改";
                        font-size: Typography.heading-size;
                        font-weight: 600;
                        color: Theme.text-primary;
                    }
                    Text {
                        text: "修改网卡 IP、网关、DNS 指向旁路由";
                        font-size: Typography.caption-size;
                        color: Theme.text-secondary;
                    }
                }
            }
            KeyValueRow { key: "网卡"; value: root.adapter-name; }
            GridLayout {
                spacing: 14px;
                InfoRow { label: "网卡 IP"; value: root.ip; col: 0; row: 0; }
                InfoRow { label: "子网掩码"; value: root.mask; col: 1; row: 0; }
                InfoRow { label: "网关"; value: root.gateway; col: 0; row: 1; }
                InfoRow { label: "DNS"; value: root.dns; col: 1; row: 1; }
            }
        }
    }
}

component SidebarItem {
    in property <string> icon-data;
    in property <string> label;
    in property <bool> selected;
    callback clicked();

    Rectangle {
        height: 34px;
        background: root.selected ? #e8f4fd : transparent;
        border-radius: 6px;
        HorizontalLayout {
            padding-top: 6px;
            padding-bottom: 6px;
            padding-left: 10px;
            padding-right: 10px;
            spacing: 10px;
            alignment: start;
            // 图标上下居中：Rectangle 不支持 vertical-alignment，
            // 用 VerticalLayout 包一层让内层 alignment: center 生效。
            VerticalLayout {
                alignment: center;
                Path {
                    width: 16px;
                    height: 16px;
                    fill: root.selected ? Theme.accent-blue : Theme.text-secondary;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: root.icon-data;
                }
            }
            Text {
                text: root.label;
                font-size: Typography.body-size;
                font-weight: root.selected ? 600 : 400;
                color: root.selected ? Theme.accent-blue : Theme.text-primary;
                vertical-alignment: center;
            }
        }
        TouchArea {
            clicked => { root.clicked(); }
        }
    }
}

// 紧凑工具按钮（规范「紧凑按钮 32px」）：文字 14px/600，可带 16px SVG 前置图标，
// accent 形态为蓝色实底白字（如「检查更新」）。
component ToolButton {
    in property <string> text;
    in property <string> icon-data;
    in property <bool> accent;
    callback clicked();

    Rectangle {
        height: 32px;
        background: root.accent ? Theme.accent-blue : Theme.bg-gray;
        border-radius: 6px;
        border-width: root.accent ? 0px : 1px;
        border-color: Theme.border-gray;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 6px;
            alignment: center;
            if root.icon-data != "": Path {
                width: 16px;
                height: 16px;
                fill: root.accent ? #ffffff : Theme.text-primary;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: root.icon-data;
            }
            Text {
                text: root.text;
                font-size: Typography.body-size;
                font-weight: 600;
                color: root.accent ? #ffffff : Theme.text-primary;
                vertical-alignment: center;
            }
        }
        TouchArea {
            clicked => { root.clicked(); }
        }
    }
}

// ------------------------------------------------------------------
// Pages
// ------------------------------------------------------------------
component HomePage {
    in property <string> status-text;
    in property <color> status-color;
    in property <bool> is-enabled;
    in property <bool> is-fallback;
    in property <int> latency-ms;
    in property <int> interval-secs;
    in property <int> mode-index;
    in property <string> bypass-ip-text;
    in property <string> adapter-ip;
    in property <string> adapter-mask;
    in property <string> adapter-gateway;
    in property <string> adapter-dns;
    in property <string> adapter-name;
    callback toggle();
    callback switch-mode();

    ScrollView {
        VerticalLayout {
            padding-top: 0px;
            padding-bottom: 0px;
            padding-left: 0px;
            // 为 scrollbar 预留位置（Windows 上原生 scrollbar 几像素宽会与内容重叠）
            padding-right: 12px;
            spacing: 12px;

            Card {
                VerticalLayout {
                    padding: 14px;
                    spacing: 12px;
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 10px;
                                height: 10px;
                                border-radius: 5px;
                                background: root.status-color;
                                drop-shadow-offset-x: 0;
                                drop-shadow-offset-y: 0;
                                drop-shadow-blur: 6px;
                                drop-shadow-color: root.status-color;
                            }
                        }
                        VerticalLayout {
                            spacing: 3px;
                            Text {
                                text: root.status-text;
                                font-size: Typography.heading-size;
                                font-weight: 600;
                                color: Theme.text-primary;
                            }
                            Text {
                                text: root.is-enabled ? "当前流量已通过旁路由" : "当前为直连状态";
                                font-size: Typography.caption-size;
                                color: Theme.text-secondary;
                            }
                        }
                        HorizontalLayout {
                            alignment: end;
                            ToggleSwitch {
                                checked: root.is-enabled;
                                text: "启用旁路由";
                                toggled => { root.toggle(); }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        StatItem {
                            label: "延迟";
                            value: root.latency-ms >= 0 ? root.latency-ms + " ms" : "--";
                            sub-value: root.is-enabled ? "旁路由" : "";
                            horizontal-stretch: 1;
                        }
                        StatItem {
                            label: "连通性";
                            value: root.is-fallback ? "异常" : (root.is-enabled ? "正常" : "--");
                            value-color: root.is-fallback ? Theme.error : (root.is-enabled ? Theme.success : Theme.text-secondary);
                            sub-value: root.is-enabled ? "检测中" : "";
                            horizontal-stretch: 1;
                        }
                        // 「检测间隔」替代原「上次检测」：检测是自动跑的，不需要
                        // 单独显示上一次检测时间；改为展示用户配置的检测周期。
                        StatItem {
                            label: "检测间隔";
                            value: root.interval-secs + " 秒";
                            sub-value: "自动检测";
                            horizontal-stretch: 1;
                        }
                    }
                }
            }

            Card {
                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;
                    HorizontalLayout {
                        Text {
                            text: "当前模式";
                            font-size: Typography.heading-size;
                            font-weight: 600;
                            color: Theme.text-primary;
                        }
                        HorizontalLayout {
                            alignment: end;
                            Text {
                                text: "切换模式";
                                font-size: Typography.caption-size;
                                color: Theme.accent-blue;
                                TouchArea {
                                    clicked => { root.switch-mode(); }
                                }
                            }
                        }
                    }

                    if root.mode-index == 0: RouteOverlayCard {
                        bypass-ip: root.bypass-ip-text;
                        adapter-name: root.adapter-name;
                    }

                    if root.mode-index == 1: AdapterReconfigCard {
                        ip: root.adapter-ip;
                        mask: root.adapter-mask;
                        gateway: root.adapter-gateway;
                        dns: root.adapter-dns;
                        adapter-name: root.adapter-name;
                    }
                }
            }

            Text {
                text: root.mode-index == 0
                    ? "提示：当前为路由叠加模式，通过添加 0.0.0.0/1 与 128.0.0.0/1 两条路由覆盖默认路由，若需要修改配置请前往配置页面。"
                    : "提示：当前为网卡直改模式，修改网卡 IP、网关、DNS 指向旁路由，配置页面可调整静态 IP 等参数。";
                font-size: Typography.caption-size;
                color: Theme.text-tertiary;
                wrap: word-wrap;
            }
        }
    }
}

component ConfigPage {
    in-out property <int> mode-index;
    in property <[string]> adapter-names;
    in-out property <int> adapter-index;
    in-out property <string> bypass-ip-text;
    in-out property <string> static-ip-text;
    in-out property <string> mask-text;
    in-out property <string> dns-text;
    in-out property <int> interval-secs;
    in-out property <int> failure-threshold;
    in-out property <bool> auto-reenable;
    in-out property <bool> notifications;
    in property <string> config-error;
    callback adapter-changed(int);
    callback save-config();
    callback restore-default();

    ScrollView {
        VerticalLayout {
            padding-top: 0px;
            padding-bottom: 0px;
            padding-left: 0px;
            padding-right: 12px;
            spacing: 12px;

            Text {
                text: "配置";
                font-size: Typography.title-size;
                font-weight: 600;
                color: Theme.text-primary;
            }

            Card {
                VerticalLayout {
                    padding: 14px;
                    spacing: 12px;
                    Text {
                        text: "选择模式";
                        font-size: Typography.heading-size;
                        font-weight: 600;
                        color: Theme.text-primary;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        ModeCard {
                            title: "路由叠加";
                            desc: "通过旁路由 IP 转发流量";
                            icon-data: Icons.layer;
                            selected: root.mode-index == 0;
                            horizontal-stretch: 1;
                            clicked => { root.mode-index = 0; }
                        }
                        ModeCard {
                            title: "网卡直改";
                            desc: "修改网卡 IP / 网关 / DNS";
                            icon-data: Icons.router;
                            selected: root.mode-index == 1;
                            horizontal-stretch: 1;
                            clicked => { root.mode-index = 1; }
                        }
                    }
                }
            }

            Card {
                VerticalLayout {
                    padding: 14px;
                    spacing: 12px;
                    Text {
                        text: root.mode-index == 0 ? "旁路由设置" : "网卡直改设置";
                        font-size: Typography.heading-size;
                        font-weight: 600;
                        color: Theme.text-primary;
                    }

                    FormRow {
                        label: "网卡";
                        ComboBox {
                            model: root.adapter-names;
                            current-index <=> root.adapter-index;
                            min-height: 36px;
                            selected => { root.adapter-changed(self.current-index); }
                        }
                    }

                    FormRow {
                        label: "旁路由 IP";
                        LineEdit {
                            text <=> root.bypass-ip-text;
                            min-height: 36px;
                            placeholder-text: "例如 192.168.123.105";
                        }
                    }

                    if root.mode-index == 1: VerticalLayout {
                        spacing: 10px;
                        FormRow {
                            label: "网卡静态 IP";
                            LineEdit {
                                text <=> root.static-ip-text;
                                min-height: 36px;
                                placeholder-text: "留空则保留当前 IP";
                            }
                        }
                        FormRow {
                            label: "子网掩码";
                            LineEdit {
                                text <=> root.mask-text;
                                min-height: 36px;
                                placeholder-text: "255.255.255.0";
                            }
                        }
                        FormRow {
                            label: "DNS";
                            LineEdit {
                                text <=> root.dns-text;
                                min-height: 36px;
                                placeholder-text: "留空则使用旁路由 IP";
                            }
                        }
                    }
                }
            }

            Card {
                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;
                    Text {
                        text: "高级选项";
                        font-size: Typography.heading-size;
                        font-weight: 600;
                        color: Theme.text-primary;
                    }
                    FormRow {
                        label: "检测间隔（秒）";
                        SpinBox {
                            minimum: 1;
                            maximum: 60;
                            min-height: 36px;
                            value <=> root.interval-secs;
                        }
                    }
                    FormRow {
                        label: "失败阈值";
                        SpinBox {
                            minimum: 1;
                            maximum: 10;
                            min-height: 36px;
                            value <=> root.failure-threshold;
                        }
                    }
                    CheckBox {
                        text: "旁路由恢复后自动重新启用";
                        checked <=> root.auto-reenable;
                    }
                    CheckBox {
                        text: "启用系统通知";
                        checked <=> root.notifications;
                    }
                }
            }

            if root.config-error != "": Text {
                text: root.config-error;
                font-size: Typography.caption-size;
                color: Theme.error;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 10px;
                Button {
                    text: "恢复默认";
                    primary: false;
                    clicked => { root.restore-default(); }
                }
                Button {
                    text: "保存";
                    primary: true;
                    clicked => { root.save-config(); }
                }
            }
        }
    }
}

// LogRow 自适应高度：把单条日志 message 文本换行后整个行条按内容增高，
// 避免固定行高遮住 wrap 文本。
//   - 三列固定宽：时间 / 等级徽标 / 内容（13px 日志字号，规范「日志文字」）；
//   - message 用 vertical-alignment: top，多行时贴顶显示（默认 center 会让
//     首行垂直方向居中，看起来不跟 time/level 列对齐）。
component LogRow {
    in property <string> time;
    in property <string> level;
    in property <string> message;
    in property <int> row-index;

    Rectangle {
        background: Math.mod(row-index, 2) == 0 ? #ffffff : #fafafa;
        min-height: 26px;
        HorizontalLayout {
            padding-top: 4px;
            padding-bottom: 4px;
            padding-left: 6px;
            padding-right: 6px;
            spacing: 0px;
            Rectangle {
                width: 76px;
                background: #f3f3f3;
                border-radius: 3px;
                Text {
                    text: root.time;
                    font-size: Typography.label-size;
                    color: Theme.text-tertiary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                width: 8px;
            }
            Rectangle {
                width: 56px;
                background: root.level == "ERROR" ? #fde7e3
                    : (root.level == "WARN" ? #fff3d6
                    : (root.level == "INFO" ? #e8f4fd : #f3f3f3));
                border-radius: 3px;
                Text {
                    text: root.level;
                    font-size: Typography.label-size;
                    font-weight: 600;
                    color: root.level == "ERROR" ? Theme.error
                        : (root.level == "WARN" ? Theme.warning
                        : (root.level == "INFO" ? Theme.accent-blue : Theme.text-secondary));
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                width: 8px;
            }
            Text {
                text: root.message;
                font-size: Typography.label-size;
                color: Theme.text-primary;
                wrap: word-wrap;
                vertical-alignment: top;
                horizontal-stretch: 1;
            }
        }
    }
}

component LogsPage {
    in property <[LogEntry]> log-entries;
    callback open-logs();
    callback refresh();

    VerticalLayout {
        padding: 0px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "日志";
                font-size: Typography.title-size;
                font-weight: 600;
                color: Theme.text-primary;
                vertical-alignment: center;
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                ToolButton {
                    text: "刷新";
                    icon-data: Icons.refresh;
                    width: 84px;
                    clicked => { root.refresh(); }
                }
                ToolButton {
                    text: "打开日志目录";
                    icon-data: Icons.folder-open;
                    width: 140px;
                    clicked => { root.open-logs(); }
                }
            }
        }

        Card {
            // 高度吃满窗口剩余空间，日志列表随窗口伸缩。
            vertical-stretch: 1;
            VerticalLayout {
                padding: 0px;
                spacing: 0px;
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 6px;
                        padding-right: 12px;
                        spacing: 0px;
                        for entry[idx] in root.log-entries: LogRow {
                            time: entry.time;
                            level: entry.level;
                            message: entry.message;
                            row-index: idx;
                        }
                    }
                }
            }
        }
    }
}

component AboutPage {
    in property <string> version-text;
    callback check-update();

    // 页面实例处设置 horizontal-stretch: 1，让本页铺满右侧内容区宽度；
    // 顶部行把「检查更新」推至右侧，下方内容块 vertical-stretch: 1 + alignment: center
    // 在剩余空间里垂直居中。
    VerticalLayout {
        padding: 0px;
        spacing: 16px;
        vertical-stretch: 1;

        HorizontalLayout {
            horizontal-stretch: 1;
            alignment: end;
            ToolButton {
                text: "检查更新";
                accent: true;
                width: 96px;
                clicked => { root.check-update(); }
            }
        }

        VerticalLayout {
            spacing: 14px;
            alignment: center;
            horizontal-stretch: 1;
            vertical-stretch: 1;

            // 直接以高分辨率 source 缩放到 72×72，画质比 24 viewBox 矢量图更稳。
            HorizontalLayout {
                alignment: center;
                Image {
                    source: @image-url("../../../assets/app.png");
                    width: 72px;
                    height: 72px;
                }
            }
            Text {
                text: "RouteTool";
                font-size: Typography.title-size;
                font-weight: 600;
                color: Theme.text-primary;
                horizontal-alignment: center;
            }
            Text {
                text: root.version-text;
                font-size: Typography.caption-size;
                color: Theme.text-secondary;
                horizontal-alignment: center;
            }
            HorizontalLayout {
                alignment: center;
                Text {
                    text: "Windows 桌面旁路由一键切换工具。支持路由叠加与网卡直改两种模式，具备旁路由异常自动侦测与回退能力。";
                    font-size: Typography.caption-size;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    max-width: 460px;
                }
            }
            Text {
                text: "本项目采用 MIT 许可证开源";
                font-size: Typography.caption-size;
                color: Theme.text-tertiary;
                horizontal-alignment: center;
            }
            Text {
                text: "github.com/5kywa1ker/route-tool";
                font-size: Typography.caption-size;
                color: Theme.accent-blue;
                horizontal-alignment: center;
            }
        }
    }
}

// ------------------------------------------------------------------
// 主窗口
// ------------------------------------------------------------------
export component AppWindow inherits Window {
    title: "RouteTool 旁路由切换工具";
    icon: @image-url("../../../assets/app.png");
    // 规范：英文/数字 Segoe UI Variable，中文经系统 fallback 到 Microsoft YaHei UI；
    // std-widgets 的默认字号统一 14px（正文）。
    default-font-family: "Segoe UI Variable";
    default-font-size: Typography.body-size;
    preferred-width: 720px;
    preferred-height: 520px;
    min-width: 660px;
    min-height: 460px;

    in property <string> status-text: "未连接到核心服务";
    in property <bool> is-enabled: false;
    in property <bool> is-fallback: false;
    in property <int> latency-ms: -1;
    in property <string> version-text: "v0.0.0";
    in property <string> service-status-text: "服务运行中";

    in property <[string]> adapter-names: [];
    in-out property <int> adapter-index: -1;

    in property <string> selected-adapter-name: "--";
    in property <string> selected-adapter-ip: "--";
    in property <string> selected-adapter-mask: "--";
    in property <string> selected-adapter-gateway: "--";
    in property <string> selected-adapter-dns: "--";

    in-out property <string> bypass-ip-text: "";
    in-out property <int> mode-index: 0;
    in-out property <string> static-ip-text: "";
    in-out property <string> mask-text: "";
    in-out property <string> dns-text: "";
    in-out property <int> interval-secs: 5;
    in-out property <int> failure-threshold: 3;
    in-out property <bool> auto-reenable: false;
    in-out property <bool> notifications: true;
    in property <string> config-error: "";

    in property <[LogEntry]> log-entries: [];
    in-out property <int> current-page: 0;

    callback toggle-bypass();
    callback save-config();
    callback open-logs();
    callback adapter-changed(int);
    callback restore-default();
    callback check-update();
    callback refresh-logs();
    // 主动触发「拉取最新网卡列表 + 刷新首页下方卡片」
    callback refresh-adapters();

    property <color> status-color: root.is-fallback ? Theme.error
        : (root.is-enabled ? Theme.success : Theme.text-secondary);

    HorizontalLayout {
        Rectangle {
            width: 140px;
            background: #ffffff;

            Rectangle {
                x: 139px;
                width: 1px;
                height: 100%;
                background: Theme.border-gray;
            }

            VerticalLayout {
                padding: 14px;
                spacing: 6px;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Image {
                        source: @image-url("../../../assets/app.png");
                        width: 28px;
                        height: 28px;
                    }
                    VerticalLayout {
                        spacing: 2px;
                        alignment: center;
                        Text {
                            text: "RouteTool";
                            font-size: Typography.label-size;
                            font-weight: 600;
                            color: Theme.text-primary;
                        }
                        Text {
                            text: "旁路由切换";
                            font-size: Typography.caption-size;
                            color: Theme.text-tertiary;
                        }
                    }
                }

                Rectangle { height: 12px; }

                SidebarItem {
                    icon-data: Icons.home;
                    label: "首页";
                    selected: root.current-page == 0;
                    clicked => { root.current-page = 0; root.refresh-adapters(); }
                }
                SidebarItem {
                    icon-data: Icons.settings;
                    label: "配置";
                    selected: root.current-page == 1;
                    clicked => { root.current-page = 1; }
                }
                SidebarItem {
                    icon-data: Icons.logs;
                    label: "日志";
                    selected: root.current-page == 2;
                    clicked => { root.current-page = 2; root.refresh-logs(); }
                }
                SidebarItem {
                    icon-data: Icons.about;
                    label: "关于";
                    selected: root.current-page == 3;
                    clicked => { root.current-page = 3; }
                }

                VerticalLayout {
                    alignment: end;
                    spacing: 4px;
                    HorizontalLayout {
                        spacing: 4px;
                        alignment: start;
                        Rectangle {
                            width: 6px;
                            height: 6px;
                            border-radius: 3px;
                            background: root.service-status-text == "服务运行中" ? Theme.success : Theme.error;
                        }
                        Text {
                            text: root.service-status-text;
                            font-size: Typography.caption-size;
                            color: Theme.text-secondary;
                        }
                    }
                    Text {
                        text: root.version-text;
                        font-size: Typography.caption-size;
                        color: Theme.text-tertiary;
                    }
                }
            }
        }

        Rectangle {
            background: Theme.bg-gray;
            HorizontalLayout {
                padding: 14px;
                spacing: 0px;

                if root.current-page == 0: HomePage {
                    status-text: root.status-text;
                    status-color: root.status-color;
                    is-enabled: root.is-enabled;
                    is-fallback: root.is-fallback;
                    latency-ms: root.latency-ms;
                    interval-secs: root.interval-secs;
                    mode-index: root.mode-index;
                    bypass-ip-text: root.bypass-ip-text;
                    adapter-ip: root.selected-adapter-ip;
                    adapter-mask: root.selected-adapter-mask;
                    adapter-gateway: root.selected-adapter-gateway;
                    adapter-dns: root.selected-adapter-dns;
                    adapter-name: root.selected-adapter-name;
                    toggle => { root.toggle-bypass(); }
                    switch-mode => { root.current-page = 1; }
                }

                if root.current-page == 1: ConfigPage {
                    mode-index <=> root.mode-index;
                    adapter-names: root.adapter-names;
                    adapter-index <=> root.adapter-index;
                    bypass-ip-text <=> root.bypass-ip-text;
                    static-ip-text <=> root.static-ip-text;
                    mask-text <=> root.mask-text;
                    dns-text <=> root.dns-text;
                    interval-secs <=> root.interval-secs;
                    failure-threshold <=> root.failure-threshold;
                    auto-reenable <=> root.auto-reenable;
                    notifications <=> root.notifications;
                    config-error: root.config-error;
                    adapter-changed(index) => { root.adapter-changed(index); }
                    save-config => { root.save-config(); }
                    restore-default => { root.restore-default(); }
                }

                if root.current-page == 2: LogsPage {
                    log-entries: root.log-entries;
                    open-logs => { root.open-logs(); }
                    refresh => { root.refresh-logs(); }
                }

                // horizontal-stretch: 1 让关于页铺满右侧内容区（ScrollView 页天然铺满，
                // AboutPage 根是 VerticalLayout，需要显式拉伸）。
                if root.current-page == 3: AboutPage {
                    version-text: root.version-text;
                    check-update => { root.check-update(); }
                    horizontal-stretch: 1;
                }
            }
        }
    }
}
