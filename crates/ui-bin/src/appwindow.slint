// RouteTool 设置窗口 —— 侧边栏多页面布局（首页 / 配置 / 日志 / 关于）。
//
// 设计依据：《Windows11_桌面应用_UI通用设计规范.md》
//   - 字体：Segoe UI Variable（中文 fallback 微软雅黑 UI），由 Window.default-font-family
//     统一指定；DPI 缩放交给 Slint 逻辑 px，不针对缩放比例单独改字号（规范第 6 节）。
//   - 字号/字重：全部走 Typography Token（12/13/14/16/20px，字重仅 400/600），
//     禁止 10/11px 常规字号与其他字重（规范第 3/4 节）。
//   - 尺寸/间距/圆角全部走 Metrics Token，避免散落魔法数字（规范第 22 章）。
//   - 窗口 860×580 / 最小 720×520；左侧栏 200；页面 padding 20；卡片 padding 16
//     （规范第 10 节：侧栏 200~220、内容 padding 24、卡片 padding 16）。
//   - 导航项 40px 高、圆角 8px，具备 Normal/Hover/Pressed/Selected/Focus 五态
//     （规范第 13/14 节）；Selected = 轻量品牌色底 + 左侧色条 + 品牌色图标 + Semibold。
//   - 表单遵循 Label → Input → Description 结构，字段间距 16 / 组间距 20~24
//     （规范第 18/21 节）；字段级错误由 error 属性驱动（规范第 23/34 节）。
//   - 状态一律「图标 + 文案 + 颜色」共同表达，不单靠颜色（规范第 46 节）。
//   - 状态显示组件统一由 main.rs 的轮询定时器刷新；
//     「切换到首页 / 窗口重新可见 / 启用-禁用切换」三个时机会主动触发
//     refresh-adapters 回调，让首页下方网卡信息即时同步。
//   - 界面图标：Fluent UI System Icons（MIT License）24px regular 变体，
//     经 Iconify API 获取后以 Path commands 内嵌矢量渲染，任意缩放下保持锐利。

import { Button, ComboBox, LineEdit, CheckBox, ScrollView } from "std-widgets.slint";

// 全局主题色
//
// 色值体系（规范第 22 章 Design Token / 第 23 节不依赖颜色表达语义）：
//   - 品牌色 accent-blue + accent-hover/accent-pressed 三级交互色；
//   - 中性面 bg-gray（页面底）/ card-gray（卡片底）/ border-gray（描边）；
//   - 交互态 hover / pressed / subtle 供菜单项与列表行复用，
//     避免每个组件各自硬编码 rgba 造成深浅不一致；
//   - 语义色 success / error / warning 各自带 -bg 浅底，
//     用于状态徽标与内联提示卡片（图标 + 文案 + 颜色共同表达，不单靠颜色）。
export global Theme {
    out property <color> accent-blue: #0078d4;
    out property <color> accent-hover: #0067b8;
    out property <color> accent-pressed: #005a9e;
    out property <color> accent-soft: #e8f4fd;   // 品牌色浅底（选中态背景）

    out property <color> bg-gray: #f3f3f3;
    out property <color> card-gray: #fafafa;
    out property <color> border-gray: #e5e5e5;
    out property <color> border-strong: #d0d0d0;

    // 交互态填充（统一定义，保证菜单/列表/按钮悬浮深浅一致）
    out property <color> hover-fill: #ececec;
    out property <color> pressed-fill: #e0e0e0;
    out property <color> subtle-fill: #f7f7f7;

    out property <color> text-primary: #1a1a1a;
    out property <color> text-secondary: #5d5d5d;
    out property <color> text-tertiary: #888888;
    // 禁用态文字（规范第 23 节 Disabled）：与三级文字区分，更浅且不可交互
    out property <color> text-disabled: #a8a8a8;

    out property <color> success: #0f7b0f;
    out property <color> success-bg: #f0f9e8;
    out property <color> error: #c42b1c;
    out property <color> error-bg: #fde7e3;
    out property <color> warning: #9c5b00;
    out property <color> warning-bg: #fff3d6;
    out property <color> info-bg: #e8f4fd;

    // 焦点环（规范第 14 节 Keyboard Focus：不能只依赖 Hover）
    out property <color> focus-ring: #0078d4;
}

// 字体排版 Token（规范第 3 节字号层级）：所有控件从这里取字号，
// 不要在控件里散落硬编码 px 字号。
//   行高按规范第 5 节配套：12→18 / 13→20 / 14→20 / 16→24 / 20→28 / 24→32。
export global Typography {
    out property <length> display-size: 24px;  // 大标题（预留）
    out property <length> title-size: 20px;    // 页面标题 / 核心指标 / 状态数值
    out property <length> heading-size: 16px;  // 区域标题 / 卡片标题 / 状态文字
    out property <length> body-size: 14px;     // 正文 / 输入框 / 按钮
    out property <length> label-size: 13px;    // 表单标签 / 字段名 / 日志
    out property <length> caption-size: 12px;  // 辅助说明 / 提示

    out property <length> display-line: 32px;
    out property <length> title-line: 28px;
    out property <length> heading-line: 24px;
    out property <length> body-line: 20px;
    out property <length> label-line: 20px;
    out property <length> caption-line: 18px;

    // 纯数值单位（用于 computed 值参与算术，如 "N 秒" 这类需要按 N 调整的尺寸）
    out property <float> title-num: 20;
    out property <float> heading-num: 16;
    out property <float> body-num: 14;
    out property <float> caption-num: 12;
}

// 间距 / 尺寸 / 圆角 Token（规范第 78~81 节）。
// 组件只从这里取，避免散落魔法数字导致间距不一致。
export global Metrics {
    out property <length> spacing-xs: 4px;
    out property <length> spacing-sm: 8px;
    out property <length> spacing-md: 12px;
    out property <length> spacing-lg: 16px;
    out property <length> spacing-xl: 20px;
    out property <length> spacing-2xl: 24px;

    out property <length> radius-sm: 6px;
    out property <length> radius-md: 8px;
    out property <length> radius-lg: 12px;

    // 控件高度（规范第 80 节 Control）
    out property <length> control-compact: 32px;
    out property <length> control-std: 36px;
    out property <length> control-nav: 40px;

    // 内容区 padding（规范第 10 节：24px）与卡片 padding（16px）
    out property <length> content-padding: 20px;
    out property <length> card-padding: 16px;
}

