    out property <string> spinner: "M12 2.75a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0v-3.5a.75.75 0 0 1 .75-.75m0 14.5a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0V18a.75.75 0 0 1 .75-.75m8.5-5.25a.75.75 0 0 1-.75.75h-3.5a.75.75 0 0 1 0-1.5h3.5a.75.75 0 0 1 .75.75M6.25 12a.75.75 0 0 1-.75.75H2a.75.75 0 0 1 0-1.5h3.5a.75.75 0 0 1 .75.75m12.03-6.28a.75.75 0 0 1 0 1.06l-2.47 2.47a.75.75 0 0 1-1.06-1.06l2.47-2.47a.75.75 0 0 1 1.06 0M9.25 12.28a.75.75 0 0 1 0 1.06l-2.47 2.47a.75.75 0 0 1-1.06-1.06l2.47-2.47a.75.75 0 0 1 1.06 0m9.03 5.94a.75.75 0 0 1-1.06 1.06l-2.47-2.47a.75.75 0 1 1 1.06-1.06zM7.22 9.25a.75.75 0 0 1-1.06 1.06L3.69 7.84a.75.75 0 0 1 1.06-1.06z";
    // 空状态（收件盘）
    out property <string> empty: "M6.5 3A3.5 3.5 0 0 0 3.05 5.75l-1.5 4.5A4 4 0 0 0 1.5 11.4V17A4 4 0 0 0 5.5 21h13a4 4 0 0 0 4-4v-5.6q0-.59-.05-1.15l-1.5-4.5A3.5 3.5 0 0 0 17.5 3zM17.5 4.5c.96 0 1.82.61 2.13 1.52l1.35 4.04A4 4 0 0 0 20 10h-2.53a2.75 2.75 0 0 0-2.6 1.87a1.25 1.25 0 0 1-1.18.85h-3.38a1.25 1.25 0 0 1-1.18-.85A2.75 2.75 0 0 0 6.53 10H4a4 4 0 0 0-1 .14l1.36-4.1A2.25 2.25 0 0 1 6.5 4.5zM4 11.5h2.53c.63 0 1.19.4 1.4 1a2.75 2.75 0 0 0 2.58 1.72h3.38a2.75 2.75 0 0 0 2.58-1.72c.21-.6.77-1 1.4-1H20v5.5a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 17z";
}

// 日志条目模型
export struct LogEntry {
    time: string,
    level: string,
    message: string,
}

// ------------------------------------------------------------------
// 通用组件
// ------------------------------------------------------------------

// 面板卡片：白底 + 1px 描边 + 8~12px 圆角（规范第 10 节 / 速查表 Card Radius）。
// 不再用浅灰底（card-gray）——页面底已是 #f3f3f3，卡片再用灰会层级不清；
// 白底 + 细描边才是 Fluent 的卡片语言。
component Card {
    Rectangle {
        background: #ffffff;
        border-radius: Metrics.radius-lg;
        border-width: 1px;
        border-color: Theme.border-gray;
        drop-shadow-offset-x: 0;
        drop-shadow-offset-y: 1px;
        drop-shadow-blur: 4px;
        drop-shadow-color: #00000006;
        // 卡片必须横向铺满所在页面；否则宽度只按内容固有宽度算，
        // 页面变宽时卡片不会跟着变宽，内容还会被裁切。
        //
        // 这里显式给出 width: 100%，让 @children（CardBody 等）拿到确定的可用宽度：
        // 若宽度不确定，内部同时含水平布局与折行文本的卡片会出现
        // 「高度算得对但文字完全不绘制」的现象（SectionTitle 空白）。
        width: 100%;
        horizontal-stretch: 1;
        @children
    }
}

// 卡片内标准内边距容器（规范第 10 节 Card Padding 16px）。
//
// 同样必须是 Rectangle 根：裸 VerticalLayout 作根会引入
// layoutinfo <-> 分配宽高 的循环依赖（见 SectionTitle 注释）。
component CardBody {
    width: 100%;
    horizontal-stretch: 1;
    Rectangle {
        VerticalLayout {
            padding: Metrics.card-padding;
            spacing: Metrics.spacing-md;
            // 必须横向铺满 Card；否则内部 FormRow / 输入框只按固有宽度摆放，
            // 表现为输入框"消失"或内容被裁切。
            horizontal-stretch: 1;
            @children
        }
    }
}

// 卡片/区块标题（规范第 3 节 Heading 16px/600）。
//
// 根元素必须是 Rectangle（而不是裸 VerticalLayout）：
// 以布局元素为根的组件，其 preferred-width/height 由自身 layoutinfo 推出，
// 而 layoutinfo 又依赖被分配的宽高，形成
//   text -> layoutinfo-h -> preferred-width -> width -> layoutinfo-h
// 的循环依赖。宽度无法求解时 Slint 退化处理，结果是「高度按预期预留、
// 文字却完全不绘制」——表现为区块标题位置一片空白。
// 换成 Rectangle 根后宽度自上而下确定，循环被打断。
//
// 宽度用 min-width: 0 + horizontal-stretch: 1（而不是 width: 100%）：
// 这样既能在 VerticalLayout 里铺满，又能在 HorizontalLayout 里与
// 右侧操作链接共存，不会把对方顶出可视区。
component SectionTitle {
    in property <string> text;
    in property <string> hint;
    min-width: 0px;
    horizontal-stretch: 1;
    Rectangle {
        VerticalLayout {
            spacing: Metrics.spacing-xs;
            horizontal-stretch: 1;
            Text {
                text: root.text;
                font-size: Typography.heading-size;
                font-weight: 600;
                color: Theme.text-primary;
            }
            if root.hint != "": Text {
                text: root.hint;
                font-size: Typography.caption-size;
                color: Theme.text-tertiary;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }
    }
}

// 页面标题块（规范第 16 节：20px/600 + 12~13px 副说明）。
component PageHeader {
    in property <string> title;
    in property <string> subtitle;
    VerticalLayout {
        spacing: Metrics.spacing-xs;
        // 页头铺满内容区宽度：副标题是 word-wrap，需要已知的可用宽度才能正确折行；
        // 不拉伸会按整句固有宽度参与布局，把内容区顶宽并导致右侧裁切。
        horizontal-stretch: 1;
        Text {
            text: root.title;
            font-size: Typography.title-size;
            font-weight: 600;
            color: Theme.text-primary;
        }
        if root.subtitle != "": Text {
            text: root.subtitle;
            font-size: Typography.caption-size;
            color: Theme.text-secondary;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
    }
}

// 状态指示（规范第 46 节）：图标 + 文案 + 颜色三者共同表达，不单靠颜色。
// kind: 0=正常 1=注意 2=失败 3=未运行
component StatusBadge {
    in property <string> text;
    in property <int> kind: 0;
    in property <bool> compact: false;

    property <string> icon: root.kind == 0 ? Icons.status-ok
        : (root.kind == 1 ? Icons.status-warn
        : (root.kind == 2 ? Icons.status-error : Icons.status-idle));
    property <color> tone: root.kind == 0 ? Theme.success
        : (root.kind == 1 ? Theme.warning
        : (root.kind == 2 ? Theme.error : Theme.text-secondary));

    HorizontalLayout {
        spacing: Metrics.spacing-sm;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Path {
                width: root.compact ? 16px : 18px;
                height: root.compact ? 16px : 18px;
                fill: root.tone;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: root.icon;
            }
        }
        Text {
            text: root.text;
            font-size: root.compact ? Typography.caption-size : Typography.body-size;
            font-weight: 600;
            color: Theme.text-primary;
            vertical-alignment: center;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
    }
}

// 内联提示条（规范第 59/60/61 节）：成功/提示用轻量反馈，不进模态。
// kind: 0=成功 1=注意 2=失败 3=信息
component InlineBanner {
    in property <string> text;
    in property <int> kind: 0;
    in property <bool> show-close: false;
    callback dismissed();

    property <color> tone: root.kind == 0 ? Theme.success
        : (root.kind == 1 ? Theme.warning
        : (root.kind == 2 ? Theme.error : Theme.accent-blue));
    property <color> fill: root.kind == 0 ? Theme.success-bg
        : (root.kind == 1 ? Theme.warning-bg
        : (root.kind == 2 ? Theme.error-bg : Theme.info-bg));
    property <string> icon: root.kind == 0 ? Icons.status-ok
        : (root.kind == 1 ? Icons.status-warn
        : (root.kind == 2 ? Icons.status-error : Icons.about));

    Rectangle {
        background: root.fill;
        border-radius: Metrics.radius-md;
        border-width: 1px;
        border-color: root.tone;
        horizontal-stretch: 1;
        HorizontalLayout {
            padding: Metrics.spacing-md;
            spacing: Metrics.spacing-sm;
            alignment: start;
            horizontal-stretch: 1;
            VerticalLayout {
                alignment: center;
                Path {
                    width: 16px;
                    height: 16px;
                    fill: root.tone;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: root.icon;
                }
            }
            Text {
                text: root.text;
                font-size: Typography.label-size;
                color: Theme.text-primary;
                wrap: word-wrap;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if root.show-close: VerticalLayout {
                alignment: center;
                close-ta := TouchArea {
                    width: 16px;
                    height: 16px;
                    clicked => { root.dismissed(); }
                }
                Path {
                    width: 12px;
                    height: 12px;
                    fill: close-ta.has-hover ? Theme.text-primary : Theme.text-tertiary;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: Icons.dismiss;
                }
            }
        }
    }
}

// 空状态（规范第 47/53 节）：不能只留空白容器。
component EmptyState {
    in property <string> title;
    in property <string> hint;

    VerticalLayout {
        spacing: Metrics.spacing-sm;
        alignment: center;
        horizontal-stretch: 1;
        VerticalLayout {
            alignment: center;
            Path {
                width: 32px;
                height: 32px;
                fill: Theme.text-tertiary;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: Icons.empty;
            }
        }
        Text {
            text: root.title;
            font-size: Typography.body-size;
            font-weight: 600;
            color: Theme.text-secondary;
            horizontal-alignment: center;
        }
        if root.hint != "": Text {
            text: root.hint;
            font-size: Typography.caption-size;
            color: Theme.text-tertiary;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

component ToggleSwitch {
    in-out property <bool> checked;
    in property <string> text;
    callback toggled();

    HorizontalLayout {
        spacing: 6px;
        alignment: center;
        Rectangle {
            width: 38px;
            height: 22px;
            border-radius: 11px;
            background: root.checked ? Theme.accent-blue : #c8c8c8;
            Rectangle {
                x: root.checked ? 18px : 2px;
                y: 2px;
                width: 18px;
                height: 18px;
                border-radius: 9px;
                background: #ffffff;
                animate x { duration: 150ms; easing: ease-in-out; }
            }
            TouchArea {
                clicked => {
                    root.checked = !root.checked;
                    root.toggled();
                }
            }
        }
        Text {
            text: root.text;
            font-size: Typography.body-size;
            color: Theme.text-primary;
            vertical-alignment: center;
        }
    }
}

// 表单字段容器（规范第 18/21/24 节）：
//   Label → Input → Description 三段式；字段间距 16px；
//   Label→Input 6~8px；Input→Description 4~6px。
//   error 非空时：控件描边转错误色，Description 位置改显错误文案，
//   并用图标 + 文案表达错误而不是只靠红色（规范第 23 节）。
//   长 Label 允许自然换行，不撑破布局、不覆盖相邻控件（规范第 24 节）。
component FormRow {
    in property <string> label;
    in property <string> description;
    in property <string> error;
    in property <string> suffix;

    // Rectangle 根（原因见 SectionTitle 注释）。
    // 宽度用 min-width: 0 + horizontal-stretch: 1，而不是 width: 100%：
    // 后者在 HorizontalLayout 里会强占整行宽度，把同排的兄弟元素挤出可视区
    // （如「检测间隔 / 失败阈值」两列、标题行右侧的操作链接）。
    min-width: 0px;
    horizontal-stretch: 1;
    Rectangle {
        min-width: 0px;
        VerticalLayout {
            spacing: Metrics.spacing-md;
            // 表单行铺满卡片宽度：不拉伸会按 Label/Input 的固有宽度参与布局，
            // 输入框不会随窗口变宽，长描述也无法按可用宽度折行。
            horizontal-stretch: 1;

            VerticalLayout {
                spacing: 6px;
                horizontal-stretch: 1;

            // Label 行：字段名 + 可选的短后缀（如「（秒）」单位）。
            //
            // 关键：Label 的 Text 不要用 wrap / overflow: elide。
            // 这两种模式都需要先知道可用宽度才能算高度，而它处在一个
            // 「由父级自上而下决定宽度」的拉伸布局里，高度计算阶段宽度尚未确定，
            // 结果 Text 上报 0 高，整个 label 行被压扁（表现为只露出字形顶部一两个像素）。
            // 字段名是短文本，按自然宽度单行显示即可。
            HorizontalLayout {
                spacing: Metrics.spacing-xs;
                // 左对齐：让单位后缀紧跟字段名，不被 HorizontalLayout
                // 默认的 stretch 分布顶到整行最右侧。
                alignment: start;
                horizontal-stretch: 1;
                Text {
                    text: root.label;
                    font-size: Typography.label-size;
                    color: root.error != "" ? Theme.error : Theme.text-secondary;
                }
                if root.suffix != "": Text {
                    text: root.suffix;
                    font-size: Typography.caption-size;
                    color: Theme.text-tertiary;
                    vertical-alignment: center;
                }
            }

            @children
        }

        // 错误优先于描述显示：同一位置不叠加两行，避免水平布局跳动（规范第 34 节）。
        // 用互斥的两个 if 表达「错误 → 否则描述」（Slint 不支持 else if）。
        if root.error != "": HorizontalLayout {
            spacing: Metrics.spacing-xs;
            alignment: start;
            horizontal-stretch: 1;
            VerticalLayout {
                alignment: center;
                Path {
                    width: 14px;
                    height: 14px;
                    fill: Theme.error;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: Icons.status-error;
                }
            }
            Text {
                text: root.error;
                font-size: Typography.caption-size;
                color: Theme.error;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }
        if root.error == "" && root.description != "": HorizontalLayout {
            horizontal-stretch: 1;
            // 折行文本外包一层 HorizontalLayout：
            // 直接作为 VerticalLayout 子项的 wrap: word-wrap Text 会形成
            // 「高度 ← 宽度 ← 布局宽度 ← 高度」的循环依赖，Slint 取不到稳定高度，
            // 会把本行压扁并与相邻行重叠。放进 HorizontalLayout 后，宽度先被
            // 自上而下确定，再算高度，结果稳定。
            Text {
                text: root.description;
                font-size: Typography.caption-size;
                color: Theme.text-tertiary;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }
        }
    }
}

// 文本输入框（包装 std-widgets 的 LineEdit，规范第 22/23/25 节）。
//
// 用 LineEdit 而不是裸 TextInput：LineEdit 自带 placeholder-text / read-only /
// has-focus / 清除按钮 / 水平滚动，这些正是规范第 23/25 节要求的输入状态与
// 长单行值行为（光标可见、文本可水平滚动，不在框内强制换行）。
// 自绘外壳是为了让错误态描边、禁用态、Focus 表现与其他自绘控件统一。
component TextField {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> has-error: false;
    in property <bool> enabled: true;
    callback edited(string);

    // 组件根就是外壳矩形。高度由 Metrics.control-std 唯一决定，
    // 不依赖内部 input（避免相互依赖导致高度不稳定）。
    height: Metrics.control-std;
    horizontal-stretch: 1;

    states [
        disabled when !root.enabled: {
            frame.background: Theme.bg-gray;
            frame.border-color: Theme.border-gray;
        }
        error when root.has-error && root.enabled: {
            frame.background: #ffffff;
            frame.border-color: Theme.error;
        }
        focused when input.has-focus && root.enabled: {
            frame.background: #ffffff;
            frame.border-color: Theme.accent-blue;
        }
        normal when true: {
            frame.background: #ffffff;
            frame.border-color: hover.has-hover ? Theme.border-strong : Theme.border-gray;
        }
    ]

    frame := Rectangle {
        border-radius: Metrics.radius-sm;

        hover := TouchArea { }

        // 用内嵌布局承载 LineEdit，而不是绝对定位：
        // 绝对定位（x/y/width/height: 100%）的元素不参与父级尺寸推导，
        // 会让外壳的高度来源变得隐晦。放在布局里由布局统一决定内边距与撑满。
        HorizontalLayout {
            padding-left: 1px;
            padding-right: 1px;
            input := LineEdit {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                text <=> root.text;
                placeholder-text: root.placeholder;
                enabled: root.enabled;
                font-size: Typography.body-size;
                edited(text) => { root.edited(text); }
            }
        }
    }
}

// NumberBox 的上/下步进小按钮（三角形图标 + 悬浮/按压反馈）。
component NumberStepButton {
    in property <bool> up;
    callback clicked();

    width: 22px;
    Rectangle {
        ta := TouchArea {
            clicked => { root.clicked(); }
        }
        VerticalLayout {
            alignment: center;
            // 三角形在 24 视窗里尽量占满（18×11），14px 渲染下可见箭头约
            // 10.5×6.4px；旧版 12×6 三角形在 10px 渲染下只有约 5×2.5px，
            // 小到难以辨认和点击。
            Path {
                width: 14px;
                height: 14px;
                fill: ta.has-hover ? Theme.accent-blue : Theme.text-secondary;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: root.up ? "M12 5 L21 16 L3 16 Z" : "M12 19 L3 8 L21 8 Z";
            }
        }
    }
}

// 数字输入框：替代 std-widgets SpinBox。
// std SpinBox 的内部 TouchArea 对滚轮无条件 accept，指针悬浮上去滚一下
// 配置就变了。这里自绘等价控件（外观对齐 LineEdit / SpinBox）：
//   - 仅当文本框获得焦点（编辑状态）时响应滚轮增减；
//   - 未聚焦的滚轮事件 reject，交给外层 ScrollView 正常滚动页面。
component NumberBox {
    in property <int> minimum: 1;
    in property <int> maximum: 100;
    in-out property <int> value;
    out property <bool> has-focus <=> ti.has-focus;

    // 固定宽度：够放 3 位数字 + 两个步进按钮（规范第 71 节：数值类控件按
    // 最大合理长度定宽）。以前是 horizontal-stretch: 1，在双列表单里会被
    // 拉到半屏宽，与「3 位数字」的语义完全不匹配。
    //
    // 宽度必须 ≥ 子元素最小宽度之和，否则布局被过度约束：数字区已经压到
    // min-width 不能再缩，多出来的部分只能向右溢出，而 Slint 默认不裁剪，
    // 表现就是两个步进三角画到输入框边框右侧之外（旧版写死 96px，
    // 而子项最小宽度之和是 112px，于是箭头跑出框外）。
    // 这里用表达式而非写死数字，改内边距 / 按钮宽度时不会再失配。
    // 组成：10(左内边距) + (3 字符 × 14px + 10 光标余量) + 2(间距)
    //       + 22 + 22(两个步进按钮) + 4(右内边距) = 112px
    width: 10px + (3 * Typography.body-num * 1px + 10px) + 2px + 22px + 22px + 4px;
    min-height: 36px;

    function apply-new-value(v: int) {
        if root.value == v || (v >= root.minimum && v <= root.maximum) {
            root.value = v;
        }
    }

    // value 被步进/滚轮修改后回写文本框。
    changed value => {
        ti.text = root.value;
    }

    Rectangle {
        border-radius: 4px;
        background: #ffffff;
        border-width: 1px;
        border-color: ti.has-focus ? Theme.accent-blue : Theme.border-gray;

        // 声明在 TextInput 之前（z 序在下）：点击穿透给 TextInput，
        // 滚轮事件在 TextInput 不处理时落到这里，按聚焦状态决定 accept/reject。
        wheel := TouchArea {
            scroll-event(ev) => {
                if !ti.has-focus {
                    return reject;
                }
                if ev.delta-y > 0 {
                    root.apply-new-value(root.value + 1);
                    return accept;
                }
                if ev.delta-y < 0 {
                    root.apply-new-value(root.value - 1);
                    return accept;
                }
                reject
            }
        }

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 4px;
            padding-top: 4px;
            padding-bottom: 4px;
            spacing: 2px;

            Rectangle {
                clip: true;
                min-width: 3 * Typography.body-num * 1px + 10px;
                horizontal-stretch: 1;
                ti := TextInput {
                    vertical-alignment: center;
                    text: root.value;
                    color: Theme.text-primary;
                    font-size: Typography.body-size;

                    accepted => {
                        if !self.text.is-float() {
                            ti.text = root.value;
                        }
                    }
                    edited => {
                        if self.text.is-float() && self.text.to-float() != root.value {
                            root.apply-new-value(self.text.to-float());
                        } else if !self.text.is-float() && self.text != "" {
                            ti.text = root.value;
                        }
                    }
                }
            }

            NumberStepButton {
                up: true;
                clicked => { root.apply-new-value(root.value + 1); }
            }
            NumberStepButton {
                up: false;
                clicked => { root.apply-new-value(root.value - 1); }
            }
        }
    }
}

// 首页核心指标卡（规范第 17 节二级信息：核心内容 / 关键数据）。
// Label 13px → Value 20px/600 → 辅助说明 12px，三层字号建立明确层级。
component StatItem {
    in property <string> label;
    in property <string> value;
    in property <string> sub-value;
    in property <color> value-color: Theme.text-primary;

    Rectangle {
        background: #ffffff;
        border-radius: Metrics.radius-md;
        border-width: 1px;
        border-color: Theme.border-gray;
        horizontal-stretch: 1;
        VerticalLayout {
            padding: Metrics.spacing-md;
            spacing: Metrics.spacing-xs;
            horizontal-stretch: 1;
            Text {
                text: root.label;
                font-size: Typography.label-size;
                color: Theme.text-secondary;
            }
            Text {
                text: root.value;
                font-size: Typography.title-size;
                font-weight: 600;
                color: root.value-color;
                overflow: elide;
            }
            if root.sub-value != "": Text {
                text: root.sub-value;
                font-size: Typography.caption-size;
                color: Theme.text-tertiary;
                overflow: elide;
            }
        }
    }
}

// 跟随鼠标的内联浮层（黑底白字 + 小箭头 + 复制操作）。
//
// 用于 KeyValueRow 的「完整值查看」：Element UI message-tooltip 风格。
// 由单例浮层（AppWindow 内容区末尾）实例化，位置由 TooltipState 驱动。
//
//   - 根尺寸必须由内容显式推导（width/height 写在根上）：
//     绝不能让内部元素反向绑定 parent 尺寸——根没有尺寸 + 内部依赖 parent
//     会形成循环，Slint 求解失败时把根塌缩成极小尺寸。实测症状是
//     「一条小黑条 + 白字溢出浮层外落在白底上不可见，只剩灰色『复制』」。
//   - 换行文本的宽度上限用 max-width 表达（规范第 60 节）。
component InlineTooltip {
    in property <string> text;
    // 箭头在浮层内的水平位置（由实例处按光标位置换算并夹取）。
    in property <length> arrow-x: 12px;

    // 箭头（指向光标的小三角）。
    Path {
        x: clamp(root.arrow-x, 2px,
                 max(2px, parent.width - TooltipStyle.arrow-size * 2 - 2px));
        y: 0px;
        width: TooltipStyle.arrow-size * 2;
        height: TooltipStyle.arrow-size;
        fill: TooltipStyle.background;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M12 0 L24 24 L0 24 Z";
    }

    // 内容盒：从箭头下方开始。
    box := Rectangle {
        y: TooltipStyle.arrow-size;
        width: parent.width;
        height: parent.height - TooltipStyle.arrow-size;
        background: TooltipStyle.background;
        border-radius: TooltipStyle.radius;
        drop-shadow-offset-x: 0;
        drop-shadow-offset-y: 2px;
        drop-shadow-blur: 6px;
        drop-shadow-color: #33000000;

        content := VerticalLayout {
            width: parent.width;
            height: parent.height;
            padding: Metrics.spacing-sm;
            text-el := Text {
                text: root.text;
                font-size: Typography.caption-size;
                color: TooltipStyle.text-color;
                wrap: word-wrap;
            }
        }
    }

    // 尺寸推导（放在子元素声明之后，仅引用其 preferred 值，无环：
    //   根 width ← 文本固有宽度；根 height ← content.preferred-height（给定宽度）。
    //   宽度全部自上而下确定，换行高度不参与宽度计算）。
    width: min(TooltipStyle.max-width + 2 * Metrics.spacing-sm,
               text-el.preferred-width + 2 * Metrics.spacing-sm);
    height: TooltipStyle.arrow-size + content.preferred-height;
}

// 首页卡片「key 左 / value 右」行（规范第 43/44 节 Key-Value 展示）。
//   - key 固有宽度靠左；value 区 horizontal-stretch: 1 吃掉剩余宽度并右对齐
//     （HorizontalLayout 里 Text 默认 stretch=1，key 必须显式置 0，
//     否则 key 的框撑满整行把 value 顶到行尾——v0.1.17 二次踩坑）。
//   - 只读数据不用 Input 模拟（规范第 42 节），保持 Label + Value 结构。
//   - value 超宽时省略号截断，鼠标悬浮弹出完整内容浮层（Element UI 风格
//     黑底白字、跟随鼠标），点击行复制完整值，保证「视觉可截断，
//     但信息不可访问」（规范第 26/63 节）。
//
// 浮层形态：全局单例（TooltipState + 内容区末尾的 InlineTooltip 实例）。
//   - 单例声明在所有页面内容之后 → 绘制顺序最高，不会被下一行白底盖住；
//   - 每行只负责把悬浮状态与鼠标窗口坐标写入 TooltipState；
//   - 位置换算/边界夹取集中在浮层实例处做一次。
component KeyValueRow {
    in property <string> key;
    in property <string> value;
    in property <color> value-color: Theme.text-primary;
    in property <string> empty-text: "未设置";

    property <string> display-value: root.value == "" ? root.empty-text : root.value;
    property <bool> is-empty: root.value == "";

    HorizontalLayout {
        spacing: Metrics.spacing-sm;
        horizontal-stretch: 1;

        Text {
            text: root.key;
            font-size: Typography.label-size;
            color: Theme.text-secondary;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }

        Rectangle {
            height: 20px;
            horizontal-stretch: 1;

            // 悬浮 → 显示全局单例浮层（内容区末尾统一渲染，见 TooltipState）；
            // 点击 → 复制完整值（反馈：值文本短暂变为「已复制」）。
            // changed/moved 里把鼠标窗口坐标写入 TooltipState：
            //   TouchArea 的 mouse-x/y 是相对自身的偏移，必须加上
            //   absolute-position 才是窗口坐标（Slint 官方 listview 同款换算）。
            hover := TouchArea {
                changed has-hover => {
                    TooltipState.text = root.value;
                    TooltipState.visible = self.has-hover && !root.is-empty;
                    TooltipState.mouse-wx = self.absolute-position.x + self.mouse-x;
                    TooltipState.mouse-wy = self.absolute-position.y + self.mouse-y;
                }
                moved => {
                    TooltipState.mouse-wx = self.absolute-position.x + self.mouse-x;
                    TooltipState.mouse-wy = self.absolute-position.y + self.mouse-y;
                }
                clicked => {
                    root.copy-requested();
                    root.copied = true;
                    copy-timer.start();
                }
            }

            Text {
                width: 100%;
                text: root.copied ? "已复制" : root.display-value;
                font-size: Typography.label-size;
                color: root.copied ? Theme.success
                    : (root.is-empty ? Theme.text-tertiary : root.value-color);
                overflow: elide;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
    }

    // 实际复制由页面侧（Rust）完成：UI 层拿到待复制文本后写系统剪贴板，
    // 避免在 .slint 里依赖平台剪贴板 API。沿用既有 set_clipboard 回调。
    callback copy-requested();

    property <bool> copied: false;
    // 复制反馈 1.5s 后复位（Timer 不能声明 id，用实例名引用）。
    copy-timer := Timer {
        interval: 1.5s;
        running: false;
        triggered => { root.copied = false; }
    }
}

// 模式选择卡（规范第 35 节：选项较少时直接显示全部选项）。
// 状态：Normal / Hover / Pressed / Selected。Selected 用品牌色描边 + 轻量底 +
// 右上角对勾图标（图标 + 颜色双重表达，不只靠颜色；规范第 22 节）。
component ModeCard {
    in property <string> title;
    in property <string> desc;
    in property <string> icon-data;
    in property <bool> selected;
    callback clicked();

    // 两张模式卡必须等宽，靠「三项布局参数完全一致」保证（只设其中一项都不行）：
    //   1) min-width: 0 —— 去掉内容固有最小宽度这块地板（标题单行 + 图标 +
    //      内边距会给出一个下限），否则两卡下限不同；
    //   2) preferred-width —— 关键项。HorizontalLayout 在空间不足时按
    //      「preferred - min」的比例收缩子项：说明文字越长 preferred 越大，
    //      收缩后反而越宽。旧版只设了 min-width: 0，实测两卡就是不等宽的；
    //      统一成固定值后两卡 min/preferred/stretch 完全相同，
    //      容器变宽变窄都逐像素等宽；
    //   3) horizontal-stretch: 1 —— 空间富余时平分多出来的宽度。
    min-width: 0px;
    preferred-width: 320px;
    horizontal-stretch: 1;

    Rectangle {
        background: root.selected ? Theme.accent-soft
            : (ta.pressed ? Theme.pressed-fill
            : (ta.has-hover ? Theme.subtle-fill : #ffffff));
        border-radius: Metrics.radius-lg;
        border-width: root.selected ? 2px : 1px;
        border-color: root.selected ? Theme.accent-blue
            : (ta.has-hover ? Theme.border-strong : Theme.border-gray);
        min-width: 0px;

        VerticalLayout {
            padding: Metrics.card-padding;
            spacing: Metrics.spacing-sm;
            horizontal-stretch: 1;

            // 标题行（图标 + 标题 + 选中标记）贴顶，说明文字紧随其后；
            // 剩余高度由下方说明区吸收，保证两张卡视觉等高。
            HorizontalLayout {
                spacing: Metrics.spacing-md;
                alignment: start;
                horizontal-stretch: 1;

                Rectangle {
                    width: 32px;
                    height: 32px;
                    background: root.selected ? #ffffff : Theme.bg-gray;
                    border-radius: Metrics.radius-md;
                    Path {
                        x: 6px;
                        y: 6px;
                        width: 20px;
                        height: 20px;
                        fill: root.selected ? Theme.accent-blue : Theme.text-secondary;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: root.icon-data;
                    }
                }

                VerticalLayout {
                    spacing: Metrics.spacing-xs;
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: root.title;
                        font-size: Typography.heading-size;
                        font-weight: 600;
                        color: Theme.text-primary;
                    }
                }

                // 选中标记：形状 + 颜色，不只靠颜色区分（可访问性）。
                if root.selected: VerticalLayout {
                    alignment: center;
                    Path {
                        width: 18px;
                        height: 18px;
                        fill: Theme.accent-blue;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: Icons.status-ok;
                    }
                }
            }

            Text {
                text: root.desc;
                font-size: Typography.caption-size;
                color: Theme.text-secondary;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }

        ta := TouchArea {
            clicked => { root.clicked(); }
        }
    }
}

// 当前模式详情卡（首页）。
// 只读信息用 Label + Value 结构展示，不用 Input 模拟（规范第 42 节）。
component RouteOverlayCard {
    in property <string> bypass-ip;
    in property <string> adapter-name;
    callback copy-value(string);

    Rectangle {
        background: Theme.subtle-fill;
        border-radius: Metrics.radius-md;
        border-width: 1px;
        border-color: Theme.border-gray;
        horizontal-stretch: 1;
        VerticalLayout {
            padding: Metrics.spacing-md;
            spacing: Metrics.spacing-md;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: Metrics.spacing-md;
                alignment: start;
                horizontal-stretch: 1;
                Rectangle {
                    width: 32px;
                    height: 32px;
                    background: Theme.info-bg;
                    border-radius: Metrics.radius-md;
                    Path {
                        x: 6px;
                        y: 6px;
                        width: 20px;
                        height: 20px;
                        fill: Theme.accent-blue;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: Icons.layer;
                    }
                }
                VerticalLayout {
                    spacing: 2px;
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: "路由叠加";
                        font-size: Typography.heading-size;
                        font-weight: 600;
                        color: Theme.text-primary;
                    }
                    Text {
                        text: "通过旁路由 IP 进行流量转发";
                        font-size: Typography.caption-size;
                        color: Theme.text-secondary;
                    }
                }
            }
            KeyValueRow { key: "网卡"; value: root.adapter-name; empty-text: "未选择"; copy-requested => { root.copy-value(root.adapter-name); } }
            KeyValueRow { key: "旁路由 IP"; value: root.bypass-ip; copy-requested => { root.copy-value(root.bypass-ip); } }
        }
    }
}

component AdapterReconfigCard {
    in property <string> ip;
    in property <string> mask;
    in property <string> gateway;
    in property <string> dns;
    in property <string> adapter-name;
    callback copy-value(string);

    Rectangle {
        background: Theme.subtle-fill;
        border-radius: Metrics.radius-md;
        border-width: 1px;
        border-color: Theme.border-gray;
        horizontal-stretch: 1;
        VerticalLayout {
            padding: Metrics.spacing-md;
            spacing: Metrics.spacing-md;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: Metrics.spacing-md;
                alignment: start;
                horizontal-stretch: 1;
                Rectangle {
                    width: 32px;
                    height: 32px;
                    background: Theme.success-bg;
                    border-radius: Metrics.radius-md;
                    Path {
                        x: 6px;
                        y: 6px;
                        width: 20px;
                        height: 20px;
                        fill: Theme.success;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: 24;
                        viewbox-height: 24;
                        commands: Icons.router;
                    }
                }
                VerticalLayout {
                    spacing: 2px;
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: "网卡直改";
                        font-size: Typography.heading-size;
                        font-weight: 600;
                        color: Theme.text-primary;
                    }
                    Text {
                        text: "修改网卡 IP、网关、DNS 指向旁路由";
                        font-size: Typography.caption-size;
                        color: Theme.text-secondary;
                    }
                }
            }
            KeyValueRow { key: "网卡"; value: root.adapter-name; empty-text: "未选择"; copy-requested => { root.copy-value(root.adapter-name); } }
            KeyValueRow { key: "网卡 IP"; value: root.ip; empty-text: "未获取"; copy-requested => { root.copy-value(root.ip); } }
            KeyValueRow { key: "子网掩码"; value: root.mask; empty-text: "未获取"; copy-requested => { root.copy-value(root.mask); } }
            KeyValueRow { key: "网关"; value: root.gateway; empty-text: "未获取"; copy-requested => { root.copy-value(root.gateway); } }
            KeyValueRow { key: "DNS"; value: root.dns; empty-text: "未获取"; copy-requested => { root.copy-value(root.dns); } }
        }
    }
}

// 侧边栏一级导航项（规范第 13/14 节）。
//   尺寸：40px 高、圆角 8px、左右 padding 12px、图标 18px、图标文字间距 12px。
//   状态：Normal / Hover / Pressed / Selected / Keyboard Focus 全部覆盖。
//   Selected 用「轻量品牌色底 + 左侧 3px 色条 + 品牌色图标 + Semibold 文字」，
//   避免大面积高饱和实心背景（规范第 14 节）。
component SidebarItem {
    in property <string> icon-data;
    in property <string> label;
    in property <bool> selected;
    callback clicked();

    height: Metrics.control-nav;
    // VerticalLayout 里元素默认 vertical-stretch=1，会把 40px 的菜单项
    // 拉伸铺满整栏高度（表现为菜单上下分散）。固定为 0，剩余空间交给
    // 主布局里的弹性填充块，菜单项从上到下紧凑排列。
    vertical-stretch: 0;

    Rectangle {
        background: root.selected ? Theme.accent-soft
            : (ta.pressed ? Theme.pressed-fill
            : (ta.has-hover ? Theme.hover-fill : transparent));
        border-radius: Metrics.radius-md;
        width: 100%;
        height: 100%;

        // 选中态左侧品牌色条：不依赖颜色也能通过位置/形状识别当前页。
        if root.selected: Rectangle {
            x: 0;
            y: (parent.height - self.height) / 2;
            width: 3px;
            height: parent.height - 14px;
            border-radius: 2px;
            background: Theme.accent-blue;
        }

        // 焦点环：键盘 Tab 到达时显示，不能只依赖 Hover（规范第 14 节）。
        if scope.has-focus: Rectangle {
            background: transparent;
            border-radius: Metrics.radius-md;
            border-width: 1px;
            border-color: Theme.focus-ring;
        }

        HorizontalLayout {
            padding-left: Metrics.spacing-md;
            padding-right: Metrics.spacing-md;
            spacing: Metrics.spacing-md;
            alignment: start;
            // 图标上下居中：Rectangle 不支持 vertical-alignment，
            // 用 VerticalLayout 包一层让内层 alignment: center 生效。
            VerticalLayout {
                alignment: center;
                Path {
                    width: 18px;
                    height: 18px;
                    fill: root.selected ? Theme.accent-blue : Theme.text-secondary;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: root.icon-data;
                }
            }
            Text {
                text: root.label;
                font-size: Typography.body-size;
                font-weight: root.selected ? 600 : 400;
                color: root.selected ? Theme.accent-blue : Theme.text-primary;
                vertical-alignment: center;
            }
        }

        // FocusScope 让菜单项参与 Tab 遍历并具备键盘激活能力；
        // Space / Enter 触发与鼠标点击一致的行为。
        scope := FocusScope {
            width: 100%;
            height: 100%;
            key-pressed(event) => {
                if event.text == " " || event.text == "\n" {
                    root.clicked();
                    accept
                } else {
                    reject
                }
            }
            ta := TouchArea {
                clicked => { root.clicked(); }
            }
        }
    }
}

// 紧凑工具按钮（规范第 39 节：紧凑按钮 32px，Standard 36px）。
// 层级：accent=Primary（品牌蓝实底白字）/ 默认=Secondary（浅底细描边）。
// 状态覆盖 Normal / Hover / Pressed / Keyboard Focus / Disabled（规范第 14 节）。
// 文案不做两行换行，宽度由内容决定（规范第 40 节）。
component ToolButton {
    in property <string> text;
    in property <string> icon-data;
    in property <bool> accent;
    in property <bool> standard: false;
    in property <bool> enabled: true;
    callback clicked();

    height: root.standard ? Metrics.control-std : Metrics.control-compact;
    min-width: 72px;

    Rectangle {
        width: 100%;
        height: 100%;
        background: !root.enabled ? Theme.bg-gray
            : (root.accent
                ? (ta.pressed ? Theme.accent-pressed : (ta.has-hover ? Theme.accent-hover : Theme.accent-blue))
                : (ta.pressed ? Theme.pressed-fill : (ta.has-hover ? Theme.hover-fill : Theme.bg-gray)));
        border-radius: Metrics.radius-sm;
        border-width: root.accent ? 0px : 1px;
        border-color: Theme.border-gray;

        // 焦点环：键盘可达性（规范第 14 节）。
        if btn-scope.has-focus && root.enabled: Rectangle {
            background: transparent;
            border-radius: Metrics.radius-sm;
            border-width: 1px;
            border-color: root.accent ? #ffffff : Theme.focus-ring;
        }

        HorizontalLayout {
            padding-left: Metrics.spacing-md;
            padding-right: Metrics.spacing-md;
            spacing: 6px;
            alignment: center;
            // 图标上下居中：Rectangle/Path 不支持 vertical-alignment，
            // 用 VerticalLayout 包一层让内层 alignment: center 生效，
            // 否则 16px 图标在 32px 按钮里贴顶，与文字错位。
            if root.icon-data != "": VerticalLayout {
                alignment: center;
                Path {
                    width: 16px;
                    height: 16px;
                    fill: !root.enabled ? Theme.text-disabled
                        : (root.accent ? #ffffff : Theme.text-primary);
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: root.icon-data;
                }
            }
            Text {
                text: root.text;
                font-size: Typography.body-size;
                font-weight: 600;
                color: !root.enabled ? Theme.text-disabled
                    : (root.accent ? #ffffff : Theme.text-primary);
                vertical-alignment: center;
            }
        }

        // FocusScope 让按钮参与 Tab 遍历；Space / Enter 触发与点击一致。
        btn-scope := FocusScope {
            width: 100%;
            height: 100%;
            enabled: root.enabled;
            key-pressed(event) => {
                if event.text == " " || event.text == "\n" {
                    root.clicked();
                    accept
                } else {
                    reject
                }
            }
            ta := TouchArea {
                enabled: root.enabled;
                clicked => { root.clicked(); }
            }
        }
    }
}

// ------------------------------------------------------------------
// Pages
// ------------------------------------------------------------------
component HomePage {
    in property <string> status-text;
    in property <int> status-kind: 3;
    in property <bool> is-enabled;
    in property <bool> is-fallback;
    in property <int> latency-ms;
    in property <int> interval-secs;
    in property <int> mode-index;
    in property <string> bypass-ip-text;
    in property <string> adapter-ip;
    in property <string> adapter-mask;
    in property <string> adapter-gateway;
    in property <string> adapter-dns;
    in property <string> adapter-name;
    in property <bool> service-lost: false;
    callback toggle();
    callback switch-mode();
    callback copy-value(string);

    ScrollView {
        horizontal-stretch: 1;
        vertical-stretch: 1;
        VerticalLayout {
            padding-top: 0px;
            padding-bottom: 0px;
            padding-left: 0px;
            // 为 scrollbar 预留位置（Windows 上原生 scrollbar 几像素宽会与内容重叠）
            padding-right: 12px;
            spacing: Metrics.spacing-lg;
            horizontal-stretch: 1;

            PageHeader {
                title: "首页";
                subtitle: "查看当前旁路由状态与生效模式，可在此快速启用或停用。";
            }

            // 核心服务断开时给出明确告警（规范第 49 节：发生了什么 + 下一步）。
            if root.service-lost: InlineBanner {
                kind: 2;
                text: "未连接到核心服务。当前页面显示的数据可能不是最新状态，请确认 RouteToolCore 服务是否正在运行，稍后会自动重连。";
            }

            Card {
                CardBody {
                    // 状态行：图标 + 文案 + 颜色共同表达（规范第 46 节）。
                    HorizontalLayout {
                        spacing: Metrics.spacing-md;
                        alignment: start;

                        StatusBadge {
                            text: root.status-text;
                            kind: root.status-kind;
                            horizontal-stretch: 1;
                        }

                        HorizontalLayout {
                            alignment: end;
                            ToggleSwitch {
                                checked: root.is-enabled;
                                text: root.is-enabled ? "已启用" : "已停用";
                                toggled => { root.toggle(); }
                            }
                        }
                    }

                    Text {
                        text: root.is-enabled ? "当前流量已通过旁路由转发" : "当前为直连状态，流量不经旁路由";
                        font-size: Typography.caption-size;
                        color: Theme.text-secondary;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: Metrics.spacing-md;
                        StatItem {
                            label: "延迟";
                            value: root.latency-ms >= 0 ? root.latency-ms + " ms" : "未检测";
                            sub-value: root.latency-ms >= 0 ? "到旁路由" : "启用后开始探测";
                            horizontal-stretch: 1;
                        }
                        StatItem {
                            label: "连通性";
                            value: root.is-fallback ? "异常" : (root.is-enabled ? "正常" : "未检测");
                            value-color: root.is-fallback ? Theme.error : (root.is-enabled ? Theme.success : Theme.text-secondary);
                            sub-value: root.is-fallback ? "已自动回退" : (root.is-enabled ? "自动探测中" : "--");
                            horizontal-stretch: 1;
                        }
                        // 「检测间隔」替代原「上次检测」：检测是自动跑的，不需要
                        // 单独显示上一次检测时间；改为展示用户配置的检测周期。
                        StatItem {
                            label: "检测间隔";
                            value: root.interval-secs + " 秒";
                            sub-value: "自动检测";
                            horizontal-stretch: 1;
                        }
                    }
                }
            }

            Card {
                CardBody {
                    HorizontalLayout {
                        horizontal-stretch: 1;
                        SectionTitle {
                            text: "当前模式";
                            horizontal-stretch: 1;
                        }
                        HorizontalLayout {
                            alignment: end;
                            horizontal-stretch: 0;
                            Text {
                                text: "前往配置";
                                font-size: Typography.caption-size;
                                color: Theme.accent-blue;
                                vertical-alignment: center;
                                TouchArea {
                                    clicked => { root.switch-mode(); }
                                }
                            }
                        }
                    }

                    if root.mode-index == 0: RouteOverlayCard {
                        bypass-ip: root.bypass-ip-text;
                        adapter-name: root.adapter-name;
                        copy-value(text) => { root.copy-value(text); }
                    }

                    if root.mode-index == 1: AdapterReconfigCard {
                        ip: root.adapter-ip;
                        mask: root.adapter-mask;
                        gateway: root.adapter-gateway;
                        dns: root.adapter-dns;
                        adapter-name: root.adapter-name;
                        copy-value(text) => { root.copy-value(text); }
                    }
                }
            }

            Text {
                text: root.mode-index == 0
                    ? "提示：当前为路由叠加模式，通过添加 0.0.0.0/1 与 128.0.0.0/1 两条路由覆盖默认路由，若需要修改配置请前往配置页面。"
                    : "提示：当前为网卡直改模式，修改网卡 IP、网关、DNS 指向旁路由，配置页面可调整静态 IP 等参数。";
                font-size: Typography.caption-size;
                color: Theme.text-tertiary;
                wrap: word-wrap;
            }
        }
    }
}

component ConfigPage {
    in-out property <int> mode-index;
    in property <[string]> adapter-names;
    in-out property <int> adapter-index;
    in-out property <string> bypass-ip-text;
    in-out property <string> static-ip-text;
    in-out property <string> mask-text;
    in-out property <string> dns-text;
    in-out property <int> interval-secs;
    in-out property <int> failure-threshold;
    in-out property <bool> auto-reenable;
    in-out property <bool> notifications;
    in-out property <bool> launch-at-startup;
    in property <string> config-error;
    in property <int> config-error-kind: 2;
    in property <string> save-state;
    in property <string> err-bypass-ip;
    in property <string> err-static-ip;
    in property <string> err-mask;
    in property <string> err-dns;
    callback adapter-changed(int);
    callback save-config();
    callback restore-default();
    callback launch-at-startup-changed(bool);
    callback dismiss-config-error();

    // 根是绝对定位容器（Rectangle）：ScrollView 铺满整页高度，底部操作栏
    // 绝对定位悬浮在最上层（声明在 ScrollView 之后 → 绘制层级更高），
    // 卡片滚动时从栏的下方穿过、被栏遮挡（sticky overlay，而非兄弟拼接）。
    // 注意：本组件作为页面在 AppWindow 里实例化时需要显式
    // horizontal-stretch / vertical-stretch: 1 才铺满。
    Rectangle {
        horizontal-stretch: 1;
        vertical-stretch: 1;

        // 提示条留在内容流里滚动：它是「操作结果反馈」，不是常驻操作，
        // 固定在底栏反而会让底栏高度随有无提示跳动。
        ScrollView {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            VerticalLayout {
                padding-top: 0px;
                padding-bottom: 0px;
                padding-left: 0px;
                padding-right: 12px;
                // 分组之间 20~24px（规范第 21 节）。
                spacing: Metrics.spacing-xl;
                horizontal-stretch: 1;

                PageHeader {
                    title: "配置";
                    subtitle: "选择旁路由生效模式，设置旁路由地址与检测策略。修改后点击「保存」生效。";
                }

            // ---- 分组一：模式选择（按语义分组，不按控件类型分组；规范第 19 节）----
            Card {
                CardBody {
                    SectionTitle {
                        text: "生效模式";
                        hint: "两种模式互斥，同一时间只能使用一种。";
                    }
                    HorizontalLayout {
                        spacing: Metrics.spacing-md;
                        horizontal-stretch: 1;
                        // 两张模式卡等宽平分：都设 horizontal-stretch: 1。
                        ModeCard {
                            title: "路由叠加";
                            desc: "不改动网卡设置，通过添加 0.0.0.0/1 与 128.0.0.0/1 两条路由把流量导向旁路由。切换快、可随时撤销。";
                            icon-data: Icons.layer;
                            selected: root.mode-index == 0;
                            horizontal-stretch: 1;
                            clicked => { root.mode-index = 0; }
                        }
                        ModeCard {
                            title: "网卡直改";
                            desc: "直接把网卡 IP、网关、DNS 指向旁路由。兼容性更好，但会改动系统网络设置。";
                            icon-data: Icons.router;
                            selected: root.mode-index == 1;
                            horizontal-stretch: 1;
                            clicked => { root.mode-index = 1; }
                        }
                    }
                }
            }

            // ---- 分组二：连接设置（Label → Input → Description；规范第 18 节）----
            Card {
                CardBody {
                    SectionTitle {
                        text: root.mode-index == 0 ? "旁路由设置" : "网卡直改设置";
                        hint: root.mode-index == 0
                            ? "指定旁路由 IP，流量将通过该地址转发。"
                            : "指定旁路由 IP，并可直接改写网卡地址与 DNS。";
                    }

                    FormRow {
                        label: "网卡";
                        description: root.adapter-index < 0 ? "暂未读取到网卡列表，请确认核心服务正在运行。" : "流量从这里选择的网卡发出；标注「未连接」的网卡当前未插网线或未关联。";
                        ComboBox {
                            model: root.adapter-names;
                            current-index <=> root.adapter-index;
                            min-height: Metrics.control-std;
                            enabled: root.adapter-names.length > 0;
                            selected => { root.adapter-changed(self.current-index); }
                        }
                    }

                    FormRow {
                        label: "旁路由 IP";
                        description: "填写旁路由的局域网地址，例如 192.168.123.105。";
                        error: root.err-bypass-ip;
                        TextField {
                            text <=> root.bypass-ip-text;
                            placeholder: "例如 192.168.123.105";
                            has-error: root.err-bypass-ip != "";
                        }
                    }

                    if root.mode-index == 1: VerticalLayout {
                        spacing: Metrics.spacing-lg;
                        FormRow {
                            label: "网卡静态 IP";
                            description: "留空则保留网卡当前 IP 不变。";
                            error: root.err-static-ip;
                            TextField {
                                text <=> root.static-ip-text;
                                placeholder: "例如 192.168.2.100";
                                has-error: root.err-static-ip != "";
                            }
                        }
                        FormRow {
                            label: "子网掩码";
                            description: "留空则使用默认值 255.255.255.0。";
                            error: root.err-mask;
                            TextField {
                                text <=> root.mask-text;
                                placeholder: "255.255.255.0";
                                has-error: root.err-mask != "";
                            }
                        }
                        FormRow {
                            label: "DNS";
                            description: "多个地址用逗号分隔；留空则使用旁路由 IP 作为 DNS。";
                            error: root.err-dns;
                            TextField {
                                text <=> root.dns-text;
                                placeholder: "例如 192.168.123.105, 223.5.5.5";
                                has-error: root.err-dns != "";
                            }
                        }
                    }
                }
            }

            // ---- 分组三：检测与恢复（高级选项按需展示；规范第 6 节渐进披露）----
            Card {
                CardBody {
                    SectionTitle {
                        text: "检测与恢复";
                        hint: "核心服务会按检测间隔探测旁路由，连续失败达到阈值后自动回退到直连，避免断网。";
                    }

                    HorizontalLayout {
                        spacing: Metrics.spacing-lg;
                        // 容器必须横向铺满，两个 FormRow 才能各占一半宽度；
                        // 缺这行会让容器塌缩成内容固有宽度，右侧字段被挤出可视区。
                        horizontal-stretch: 1;
                        FormRow {
                            label: "检测间隔";
                            description: "允许范围 1 ~ 60 秒。";
                            horizontal-stretch: 1;
                            // 数值框固定为「3 位数字 + 步进按钮」的宽度，
                            // 单位以独立 Label 的形式紧跟在框后面（规范第 71 节：
                            // 数值类控件按最大合理长度定宽，不随容器无限拉伸）。
                            HorizontalLayout {
                                spacing: Metrics.spacing-sm;
                                alignment: start;
                                NumberBox {
                                    minimum: 1;
                                    maximum: 60;
                                    value <=> root.interval-secs;
                                }
                                Text {
                                    text: "秒";
                                    font-size: Typography.body-size;
                                    color: Theme.text-secondary;
                                    vertical-alignment: center;
                                    horizontal-stretch: 0;
                                }
                            }
                        }
                        FormRow {
                            label: "失败阈值";
                            description: "允许范围 1 ~ 10 次。";
                            horizontal-stretch: 1;
                            HorizontalLayout {
                                spacing: Metrics.spacing-sm;
                                alignment: start;
                                NumberBox {
                                    minimum: 1;
                                    maximum: 10;
                                    value <=> root.failure-threshold;
                                }
                                Text {
                                    text: "次";
                                    font-size: Typography.body-size;
                                    color: Theme.text-secondary;
                                    vertical-alignment: center;
                                    horizontal-stretch: 0;
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: Theme.border-gray; }

                    CheckBox {
                        text: "旁路由恢复后自动重新启用";
                        checked <=> root.auto-reenable;
                    }
                    CheckBox {
                        text: "启用系统通知";
                        checked <=> root.notifications;
                    }
                }
            }

            // 开机自启是 UI 层设置（写 HKCU Run 键，注册表值带 --tray 参数），
            // 不走核心服务配置。
            Card {
                CardBody {
                    SectionTitle {
                        text: "启动设置";
                        hint: "控制 Windows 登录后 RouteTool 的启动方式。";
                    }
                    CheckBox {
                        text: "开机自动启动（仅启动托盘图标，不打开窗口）";
                        checked <=> root.launch-at-startup;
                        toggled => { root.launch-at-startup-changed(self.checked); }
                    }
                    Text {
                        text: "开机后 RouteTool 仅在系统托盘运行，双击托盘图标可打开设置窗口；核心服务会自动核实并恢复旁路由状态。";
                        font-size: Typography.caption-size;
                        color: Theme.text-tertiary;
                        wrap: word-wrap;
                    }
                }
            }

            // ---- 保存结果提示（可关闭，避免长期占用视觉焦点；规范第 61 节）----
            if root.config-error != "": InlineBanner {
                text: root.config-error;
                kind: root.config-error-kind;
                show-close: true;
                dismissed => { root.dismiss-config-error(); }
            }

            // 内容区底部留白 = 底栏高度 + 间距：滚动到底时最后一张卡片
            // 能完整滚到悬浮操作栏上方，不会被遮挡。
            Rectangle { height: 60px + Metrics.spacing-xl; }
            }
        }

        // ---- 操作区（悬浮吸附在内容区底部，不随页面滚动）----
        //
        // 规范第 64 节：页面标题和关键操作可按需要固定。
        // 声明在 ScrollView 之后 → 绘制在最上层，卡片从其下方穿过被遮挡；
        // 背景取页面中性色（与内容区同色，不设分隔线），按钮在栏内垂直居中。
        Rectangle {
            width: 100%;
            height: 60px;
            y: parent.height - self.height;
            background: Theme.bg-gray;

            VerticalLayout {
                height: 100%;
                alignment: center;

                // 提示条不再固定：它属于「内容流」，留在 ScrollView 内滚动；
                // 固定栏只放真正需要常驻的操作（保存 / 恢复默认）与保存结果。
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 32px;
                    spacing: Metrics.spacing-md;
                    alignment: end;

                    Text {
                        text: root.save-state == "saved" ? "已保存" : "";
                        font-size: Typography.caption-size;
                        color: Theme.success;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    ToolButton {
                        text: "恢复默认";
                        enabled: root.save-state != "saving";
                        clicked => { root.restore-default(); }
                    }
                    ToolButton {
                        text: root.save-state == "saving" ? "保存中…" : "保存并应用";
                        icon-data: root.save-state == "saving" ? Icons.spinner : Icons.save;
                        accent: true;
                        // 保存进行中禁止重复触发（规范第 72 节）。
                        enabled: root.save-state != "saving";
                        clicked => { root.save-config(); }
                    }
                }
            }
        }
    }
}

// LogRow 自适应高度：把单条日志 message 文本换行后整个行条按内容增高，
// 避免固定行高遮住 wrap 文本。
//   - 三列固定宽：时间 / 等级徽标 / 内容（13px 日志字号，规范「日志文字」）；
//   - message 用 vertical-alignment: top，多行时贴顶显示（默认 center 会让
//     首行垂直方向居中，看起来不跟 time/level 列对齐）。
// LogRow 自适应高度：把单条日志 message 文本换行后整个行条按内容增高，
// 避免固定行高遮住 wrap 文本。
//   - 三列：时间（固定窄列）/ 等级徽标（固定宽）/ 内容（弹性列，可换行）；
//     列宽按内容类型设计，描述类占据剩余宽度（规范第 55 节）。
//   - 等级用「浅底徽标 + 语义色文字」，同时保留文字标签，不只靠颜色（规范第 46 节）。
//   - message 用 vertical-alignment: top，多行时贴顶显示（默认 center 会让
//     首行垂直方向居中，看起来不跟 time/level 列对齐）。
component LogRow {
    in property <string> time;
    in property <string> level;
    in property <string> message;
    in property <int> row-index;

    Rectangle {
        background: Math.mod(row-index, 2) == 0 ? #ffffff : Theme.card-gray;
        min-height: 28px;
        HorizontalLayout {
            padding-top: Metrics.spacing-xs;
            padding-bottom: Metrics.spacing-xs;
            padding-left: Metrics.spacing-xs;
            padding-right: Metrics.spacing-xs;
            spacing: Metrics.spacing-sm;
            horizontal-stretch: 1;

            // 时间列：固定窄宽度（时间类列固定宽度，规范第 55 节）。
            Rectangle {
                width: 68px;
                background: Theme.bg-gray;
                border-radius: 3px;
                Text {
                    text: root.time;
                    font-size: Typography.label-size;
                    color: Theme.text-secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // 等级徽标：固定宽度 + 浅底语义色，配文字标签。
            Rectangle {
                width: 52px;
                background: root.level == "ERROR" ? Theme.error-bg
                    : (root.level == "WARN" ? Theme.warning-bg
                    : (root.level == "INFO" ? Theme.info-bg : Theme.bg-gray));
                border-radius: 3px;
                Text {
                    text: root.level == "" ? "LOG" : root.level;
                    font-size: Typography.caption-size;
                    font-weight: 600;
                    color: root.level == "ERROR" ? Theme.error
                        : (root.level == "WARN" ? Theme.warning
                        : (root.level == "INFO" ? Theme.accent-blue : Theme.text-secondary));
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Text {
                text: root.message;
                font-size: Typography.label-size;
                color: Theme.text-primary;
                // 关键：用 elide 而不是 word-wrap。
                // word-wrap 时「行高 ← 可用宽度 ← 视口宽度」构成循环依赖，
                // 布局要多轮迭代才能收敛 —— 拖动窗口逐帧重算就表现为卡顿，
                // 且中间态可能被采纳，把窗口宽度拉回 min-width。
                // elide 是单行定高，行高与宽度无关，循环被彻底打断。
                // 日志本来就适合单行显示，超长内容省略号截断即可。
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }
    }
}

component LogsPage {
    in property <[LogEntry]> log-entries;
    in property <bool> logs-loading: false;
    callback open-logs();
    callback refresh();

    // 结构对齐 AboutPage / ConfigPage（用户建议：参考其他页面）。
    //
    // 历史教训：本页曾用「Rectangle 包一层 + min-width: 0」打断 layoutinfo
    // 循环依赖，并且 AppWindow 上用 preferred-width: self.width 兜底。
    // 但实测仍会抖动：把窗口缩到 760 再放大到 1000、来回切页若干次后，
    // 宽度会掉回 min-width(720) —— 说明布局求解的中间态会被 Slint 采纳。
    //
    // 根因不在「有没有 Rectangle 根」，而在于本页内容宽度会反向依赖视口宽度：
    // ScrollView 内的行以 word-wrap 排版，行高 ← 可用宽度 ← 视口宽度。
    // 于是 preferred-width 在求解过程中出现「先小后大」的中间值，被采纳后
    // 窗口就被套成 min-width。
    //
    // 解法（与 AboutPage 同构）：裸 VerticalLayout 根 + stretch，
    // 去掉一切 min-width 补丁；滚动区域交给 ScrollView 自身，且不把它当作
    // 尺寸来源 —— 见下方 ScrollView 处的说明。
    horizontal-stretch: 1;
    vertical-stretch: 1;
    VerticalLayout {
        padding: 0px;
        spacing: Metrics.spacing-lg;
        horizontal-stretch: 1;
        vertical-stretch: 1;

        // ---- 顶部标题 + 操作（固定在内容区顶部，不参与滚动）----
        //
        // 关键：把「标题行」和「日志列表」拆成两个兄弟节点，
        //   - 标题行 vertical-stretch: 0：高度只取决于自身内容，窗口变高变矮
        //     都保持原尺寸。ToolButton 的 min-width: 72px 也固定，
        //     所以按钮大小不随窗口变化（用户问题 3）。
        //   - 列表用 vertical-stretch: 1 吃满剩余高度，只有它在伸缩。
        HorizontalLayout {
            spacing: Metrics.spacing-md;
            horizontal-stretch: 1;
            vertical-stretch: 0;
            PageHeader {
                title: "日志";
                subtitle: "最近的界面与核心服务运行记录，按时间倒序，最多显示 200 条。";
                horizontal-stretch: 1;
            }
            HorizontalLayout {
                alignment: end;
                spacing: Metrics.spacing-sm;
                horizontal-stretch: 0;
                ToolButton {
                    text: "刷新";
                    icon-data: Icons.refresh;
                    clicked => { root.refresh(); }
                }
                ToolButton {
                    text: "打开日志目录";
                    icon-data: Icons.folder-open;
                    clicked => { root.open-logs(); }
                }
            }
        }

        Card {
            // 高度吃满窗口剩余空间，日志列表随窗口伸缩。
            vertical-stretch: 1;
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 0px;
                spacing: 0px;
                horizontal-stretch: 1;

                // 空状态 / 加载状态：不留白屏（规范第 47/48 节）。
                // Slint 不支持 else if，用互斥条件表达三选一。
                if root.logs-loading: VerticalLayout {
                    alignment: center;
                    vertical-stretch: 1;
                    EmptyState {
                        title: "正在读取日志…";
                        hint: "正在从日志目录加载最近的记录。";
                    }
                }
                if !root.logs-loading && root.log-entries.length == 0: VerticalLayout {
                    alignment: center;
                    vertical-stretch: 1;
                    EmptyState {
                        title: "暂无日志记录";
                        hint: "这里还没有可显示的日志。点击「刷新」重新读取，或确认核心服务正在运行。";
                    }
                }
                // 日志列表。
                //
                // 三个必须同时满足的约束（否则窗口尺寸会被自动改小 / 拖窗口卡顿）：
                //
                //  1. 列表容器的高度不参与「向上」上报。做法是外层 Rectangle 给
                //     确定的 vertical-stretch: 1，ScrollView 在其内部滚动。
                //  2. 列表内容宽度必须由上而下确定，不能反向依赖视口宽度。
                //     LogRow 的 message 是 word-wrap，若行宽绑定视口，则
                //     行高 ← 行宽 ← 视口宽 形成循环，多轮才能收敛 → 拖窗口卡。
                //     这里让内容容器 horizontal-stretch: 1，宽度直接取父级给定值。
                //  3. 行内 message 用 elide 而不是 word-wrap：单行定高，
                //     行的 preferred-height 与宽度无关，彻底消除循环。
                //     与「日志」的阅读习惯也一致（超长行省略，悬浮可看全文）。
                if !root.logs-loading && root.log-entries.length > 0: Rectangle {
                    clip: true;
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    ScrollView {
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding: Metrics.spacing-sm;
                            padding-right: Metrics.spacing-md;
                            spacing: 0px;
                            horizontal-stretch: 1;
                            for entry[idx] in root.log-entries: LogRow {
                                time: entry.time;
                                level: entry.level;
                                message: entry.message;
                                row-index: idx;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                }
            }
        }
    }
}

component AboutPage {
    in property <string> version-text;
    callback check-update();

    // 页面实例处设置 horizontal-stretch: 1，让本页铺满右侧内容区宽度；
    // 顶部行把「检查更新」推至右侧，下方内容块 vertical-stretch: 1 + alignment: center
    // 在剩余空间里垂直居中。
    VerticalLayout {
        padding: 0px;
        spacing: Metrics.spacing-lg;
        horizontal-stretch: 1;
        vertical-stretch: 1;

        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: Metrics.spacing-md;
            PageHeader {
                title: "关于";
                subtitle: "版本信息与项目说明。";
                horizontal-stretch: 1;
            }
            HorizontalLayout {
                alignment: end;
                ToolButton {
                    text: "检查更新";
                    icon-data: Icons.refresh;
                    accent: true;
                    clicked => { root.check-update(); }
                }
            }
        }

        VerticalLayout {
            spacing: Metrics.spacing-lg;
            alignment: center;
            horizontal-stretch: 1;
            vertical-stretch: 1;

            // 直接以高分辨率 source 缩放到 72×72，画质比 24 viewBox 矢量图更稳。
            HorizontalLayout {
                alignment: center;
                Image {
                    source: @image-url("../../../assets/app.png");
                    width: 72px;
                    height: 72px;
                }
            }
            Text {
                text: "RouteTool";
                font-size: Typography.title-size;
                font-weight: 600;
                color: Theme.text-primary;
                horizontal-alignment: center;
            }
            Text {
                text: root.version-text;
                font-size: Typography.caption-size;
                color: Theme.text-secondary;
                horizontal-alignment: center;
            }
            HorizontalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text {
                    text: "Windows 桌面旁路由一键切换工具。支持路由叠加与网卡直改两种模式，具备旁路由异常自动侦测与回退能力。";
                    font-size: Typography.caption-size;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    max-width: 460px;
                }
            }
            Text {
                text: "本项目采用 MIT 许可证开源";
                font-size: Typography.caption-size;
                color: Theme.text-tertiary;
                horizontal-alignment: center;
            }
            Text {
                text: "github.com/5kywa1ker/route-tool";
                font-size: Typography.caption-size;
                color: Theme.accent-blue;
                horizontal-alignment: center;
            }
        }
    }
}

// ------------------------------------------------------------------
// 主窗口
// ------------------------------------------------------------------
export component AppWindow inherits Window {
    title: "RouteTool 旁路由切换工具";
    icon: @image-url("../../../assets/app.png");
    // 规范：英文/数字 Segoe UI Variable，中文经系统 fallback 到 Microsoft YaHei UI；
    // std-widgets 的默认字号统一 14px（正文）。
    default-font-family: "Segoe UI Variable";
    default-font-size: Typography.body-size;
    // 窗口尺寸策略。
    //
    // 现象：打开应用后点击日志页，窗口宽度从 880 被突然压到 720（= min-width）。
    //
    // 完整机制（读 Slint 1.17 源码定位，i-slint-backend-winit +
    // i-slint-core::layout::min_max_size_for_layout_constraints）：
    //   1. 切页会改变窗口布局约束，触发 winit 后端的约束更新；
    //   2. 日志页内容含百分比首选尺寸（ScrollView preferred-*: 100%）与
    //      width: 100% 的 Card，自底向上求解布局信息时形成循环，
    //      求解失败时 max 约束退化为 0；
    //   3. 核心公式：max_width = h.max.max(h.min) —— max 一旦为 0，
    //      就回落到 min！于是窗口 max 约束 = min-width = 720；
    //   4. winit 调 set_max_inner_size(720)，操作系统把 880 的窗口钳到 720。
    //      这也是为什么所有补丁变体都精确缩到 720：回落值永远是 min-width。
    //
    // 修法：给窗口显式声明巨大的 max 约束。h.max 永远非 0，
    // 「回落到 min」的分支永远走不到，窗口不再被钳。
    // （16777215 = 后端自身使用的窗口尺寸上限常量。）
    // min-* 仍是内容不重叠、不裁剪的底线（规范第 69 节）。
    // 注意：不要用 preferred-width: self.width 这类自引用绑定来「锚定」尺寸——
    // 它本身会构成 layoutinfo 循环，反而更容易触发第 2 步的退化求解。
    min-width: 720px;
    min-height: 520px;
    max-width: 16777215px;
    max-height: 16777215px;

    in property <string> status-text: "未连接到核心服务";
    in property <bool> is-enabled: false;
    in property <bool> is-fallback: false;
    in property <int> latency-ms: -1;
    in property <string> version-text: "v0.0.0";
    in property <string> service-status-text: "服务运行中";

    in property <[string]> adapter-names: [];
    in-out property <int> adapter-index: -1;

    in property <string> selected-adapter-name: "--";
    in property <string> selected-adapter-ip: "--";
    in property <string> selected-adapter-mask: "--";
    in property <string> selected-adapter-gateway: "--";
    in property <string> selected-adapter-dns: "--";

    in-out property <string> bypass-ip-text: "";
    in-out property <int> mode-index: 0;
    in-out property <string> static-ip-text: "";
    in-out property <string> mask-text: "";
    in-out property <string> dns-text: "";
    in-out property <int> interval-secs: 5;
    in-out property <int> failure-threshold: 3;
    in-out property <bool> auto-reenable: false;
    in-out property <bool> notifications: true;
    in-out property <bool> launch-at-startup: false;

    // 页面级汇总提示（可关闭的内联提示条，规范第 59/60 节）。
    in property <string> config-error: "";
    // kind: 0=成功 1=注意 2=失败 3=信息
    in property <int> config-error-kind: 2;
    // 保存流程状态："" 空闲 / "saving" 保存中 / "saved" 已保存（规范第 72/73 节）
    in property <string> save-state: "";

    // 字段级错误（规范第 23/34 节）：空字符串表示该字段无错误。
    // 出错的输入框描边转错误色并在字段下方给出具体原因，
    // 而不是把所有校验失败汇总成页面底部一行红字。
    in property <string> err-bypass-ip: "";
    in property <string> err-static-ip: "";
    in property <string> err-mask: "";
    in property <string> err-dns: "";

    // 服务连接告警：核心服务不可用时明确告知，而不是只靠侧栏一个小圆点。
    in property <bool> service-lost: false;

    in property <[LogEntry]> log-entries: [];
    // 日志读取状态（规范第 47/48 节）：空状态 / 加载中要有明确表述。
    in property <bool> logs-loading: false;
    in-out property <int> current-page: 0;

    callback toggle-bypass();
    callback save-config();
    callback open-logs();
    callback adapter-changed(int);
    callback restore-default();
    callback check-update();
    callback refresh-logs();
    callback launch-at-startup-changed(bool);
    callback dismiss-config-error();
    // 主动触发「拉取最新网卡列表 + 刷新首页下方卡片」
    callback refresh-adapters();
    // 复制只读字段的完整值到系统剪贴板（KeyValueRow 悬浮浮层里的「复制」）。
    callback copy-value(string);

    property <color> status-color: root.is-fallback ? Theme.error
        : (root.is-enabled ? Theme.success : Theme.text-secondary);

    // 状态语义：交给 StatusBadge 统一表达（图标 + 文案 + 颜色）。
    property <int> status-kind: root.is-fallback ? 2
        : (root.is-enabled ? 0 : 3);

    HorizontalLayout {
        Rectangle {
            // 侧栏宽度 200px（规范第 13 节 200~220px）。
            width: 200px;
            background: #ffffff;

            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                height: 100%;
                background: Theme.border-gray;
            }

            VerticalLayout {
                padding: Metrics.spacing-md;
                // 菜单项之间 2~4px（规范第 13 节）。
                spacing: Metrics.spacing-xs;

                HorizontalLayout {
                    spacing: Metrics.spacing-sm;
                    alignment: start;
                    Image {
                        source: @image-url("../../../assets/app.png");
                        width: 32px;
                        height: 32px;
                    }
                    VerticalLayout {
                        spacing: 2px;
                        alignment: center;
                        Text {
                            text: "RouteTool";
                            font-size: Typography.body-size;
                            font-weight: 600;
                            color: Theme.text-primary;
                        }
                        Text {
                            text: "旁路由切换";
                            font-size: Typography.caption-size;
                            color: Theme.text-tertiary;
                        }
                    }
                }

                Rectangle { height: Metrics.spacing-md; }

                SidebarItem {
                    icon-data: Icons.home;
                    label: "首页";
                    selected: root.current-page == 0;
                    clicked => { root.current-page = 0; root.refresh-adapters(); }
                }
                SidebarItem {
                    icon-data: Icons.settings;
                    label: "配置";
                    selected: root.current-page == 1;
                    clicked => { root.current-page = 1; }
                }
                SidebarItem {
                    icon-data: Icons.logs;
                    label: "日志";
                    selected: root.current-page == 2;
                    clicked => { root.current-page = 2; root.refresh-logs(); }
                }
                SidebarItem {
                    icon-data: Icons.about;
                    label: "关于";
                    selected: root.current-page == 3;
                    clicked => { root.current-page = 3; }
                }

                // 弹性填充：吸收剩余高度，让菜单项贴顶、底部状态块贴底。
                Rectangle {
                    vertical-stretch: 1;
                    min-height: 0;
                }

                VerticalLayout {
                    alignment: end;
                    spacing: Metrics.spacing-xs;
                    vertical-stretch: 0;

                    // 连接状态：图标 + 文案共同表达，不只是一个小圆点（规范第 46 节）。
                    StatusBadge {
                        compact: true;
                        text: root.service-status-text;
                        kind: root.service-status-text == "服务运行中" ? 0 : 2;
                    }

                    Text {
                        text: root.version-text;
                        font-size: Typography.caption-size;
                        color: Theme.text-tertiary;
                    }
                }
            }
        }

        Rectangle {
            background: Theme.bg-gray;
            // 内容区必须吃掉侧栏之外的剩余宽度，否则整块会按内容固有宽度摆放、右侧被裁切。
            horizontal-stretch: 1;
            // 内容区「首选宽度」下限 = 设计内容宽度（880 - 200 侧栏 = 680）。
            //
            // 为什么用 preferred-width 而不是 min-width：
            //   min-width 会同时抬高布局下限，使窗口无法被用户缩到该值以下；
            //   而这里只需要保证「根元素派生出的 preferred-width 不低于设计宽度」，
            //   避免 Slint 因内容固有宽度偏小（实测约 244px）而把窗口压小。
            //   preferred-width 只影响首选项，不干预用户手动缩放到更小。
            HorizontalLayout {
                // 内容区 padding（规范第 10 节）。
                padding: Metrics.content-padding;
                spacing: 0px;
                horizontal-stretch: 1;
                // HorizontalLayout 内的页面实例（ScrollView 根）需要显式拉伸才铺满。
                if root.current-page == 0: HomePage {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    status-text: root.status-text;
                    status-kind: root.status-kind;
                    is-enabled: root.is-enabled;
                    is-fallback: root.is-fallback;
                    latency-ms: root.latency-ms;
                    interval-secs: root.interval-secs;
                    mode-index: root.mode-index;
                    bypass-ip-text: root.bypass-ip-text;
                    adapter-ip: root.selected-adapter-ip;
                    adapter-mask: root.selected-adapter-mask;
                    adapter-gateway: root.selected-adapter-gateway;
                    adapter-dns: root.selected-adapter-dns;
                    adapter-name: root.selected-adapter-name;
                    service-lost: root.service-lost;
                    toggle => { root.toggle-bypass(); }
                    switch-mode => { root.current-page = 1; }
                    copy-value(text) => { root.copy-value(text); }
                }

                if root.current-page == 1: ConfigPage {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    mode-index <=> root.mode-index;
                    adapter-names: root.adapter-names;
                    adapter-index <=> root.adapter-index;
                    bypass-ip-text <=> root.bypass-ip-text;
                    static-ip-text <=> root.static-ip-text;
                    mask-text <=> root.mask-text;
                    dns-text <=> root.dns-text;
                    interval-secs <=> root.interval-secs;
                    failure-threshold <=> root.failure-threshold;
                    auto-reenable <=> root.auto-reenable;
                    notifications <=> root.notifications;
                    launch-at-startup <=> root.launch-at-startup;
                    config-error: root.config-error;
                    config-error-kind: root.config-error-kind;
                    save-state: root.save-state;
                    err-bypass-ip: root.err-bypass-ip;
                    err-static-ip: root.err-static-ip;
                    err-mask: root.err-mask;
                    err-dns: root.err-dns;
                    adapter-changed(index) => { root.adapter-changed(index); }
                    save-config => { root.save-config(); }
                    restore-default => { root.restore-default(); }
                    launch-at-startup-changed(enabled) => { root.launch-at-startup-changed(enabled); }
                    dismiss-config-error => { root.dismiss-config-error(); }
                }

                if root.current-page == 2: LogsPage {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    log-entries: root.log-entries;
                    logs-loading: root.logs-loading;
                    open-logs => { root.open-logs(); }
                    refresh => { root.refresh-logs(); }
                }

                // horizontal-stretch: 1 让关于页铺满右侧内容区（ScrollView 页天然铺满，
                // AboutPage 根是 VerticalLayout，需要显式拉伸）。
                if root.current-page == 3: AboutPage {
                    version-text: root.version-text;
                    check-update => { root.check-update(); }
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                }
            }

            // 全局单例悬浮浮层：声明在页面布局之后 → 绘制在最上层，
            // 不会被卡片/行的白底盖住。位置由 TooltipState（鼠标窗口坐标）
            // 换算成本 Rectangle 局部坐标，并夹取在本区域内。
            // InlineTooltip 自身尺寸由内容推导（见组件注释）。
            if TooltipState.visible: InlineTooltip {
                x: clamp(TooltipState.mouse-wx + TooltipStyle.offset
                             - parent.absolute-position.x,
                         4px,
                         max(4px, parent.width - self.width - 4px));
                y: clamp(TooltipState.mouse-wy + TooltipStyle.offset
                             - parent.absolute-position.y,
                         4px,
                         max(4px, parent.height - self.height - 4px));
                // 箭头对准光标的横向位置（换算成浮层内偏移并夹取在箭头区内）。
                arrow-x: clamp(TooltipState.mouse-wx - parent.absolute-position.x
                                   - self.x,
                               8px,
                               max(8px, self.width - TooltipStyle.arrow-size * 2 - 8px));
                text: TooltipState.text;
            }
        }
    }
}
